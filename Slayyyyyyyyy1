					leader.state or ""
				)


			if leaderState == "Delivery" then

				if Delivery.hasActiveCrowQuest() then

					task.wait(0.10)
					continue
				end


				if not MultiFarm.LeaderDeliveryLatched then

					local started =
						Delivery.runAutoDeliveryQuest()

					if started then
						MultiFarm.LeaderDeliveryLatched =
							true
					end
				end

			else

				MultiFarm.LeaderDeliveryLatched =
					false
			end


			task.wait(0.05)
			continue
		end


		local now =
			os.clock()

		if now < nextDeliveryAt then
			task.wait(
				math.min(
					0.10,
					nextDeliveryAt
						- now
				)
			)

			continue
		end


		if Delivery.hasActiveCrowQuest() then
			task.wait(0.10)
			continue
		end


		local success =
			Delivery.runAutoDeliveryQuest()


		if success then

			nextDeliveryAt =
				os.clock()
				+ (
					farmEnabled
						and 25
						or 23
				)

		else

			nextDeliveryAt =
				os.clock()
				+ 1
		end


		task.wait(0.05)
	end
end)


task.spawn(function()

	while Runtime.alive do

		if deliveryBusy then
			task.wait(0.05)
			continue
		end


		if MultiFarm.PendingRewardCheck
			and farmEnabled then

			local pendingName =
				MultiFarm.PendingRewardName

			local pendingPosition =
				MultiFarm.PendingRewardPosition

			local livePendingBoss =
				pendingName ~= ""
				and getLiveBoss(
					pendingName
				)
				or nil

			if not livePendingBoss then

				MultiFarm.RewardBusy =
					true

				pcall(
					handleBossRewards,
					pendingPosition
				)

				MultiFarm.RewardBusy =
					false
			end


			MultiFarm.PendingRewardCheck =
				false

			MultiFarm.PendingRewardName =
				""

			MultiFarm.PendingRewardPosition =
				nil


			task.wait(0.03)
			continue
		end


		if not farmEnabled then
			task.wait(0.1)
			continue
		end


		local character =
			waitForCharacterReady()

		if not Runtime.alive then
			break
		end

		if not character then
			task.wait(0.1)
			continue
		end


		local bossRoute =
			getBossRoute()


		if #bossRoute == 0 then
			task.wait(0.1)
			continue
		end


		if currentBossIndex
			> #bossRoute then

			currentBossIndex = 1
		end


		local bossName =
			bossRoute[
				currentBossIndex
			]

		local syncedBoss,
			waitForLeader =
			MultiFarm.resolveBoss(
				bossName
			)

		local leader =
			MultiFarm.getLeader()

		if MultiFarm.CatchUpRequested
			and leader then

			local leaderState =
				tostring(
					leader.state or ""
				)

			local leaderBoss =
				tostring(
					leader.boss or ""
				)

			if leaderBoss ~= ""
				and leaderState ~= "Delivery"
				and leaderState ~= "Open Chest"
				and leaderState ~= "Picking Loot"
				and leaderState ~= "Respawning"
				and leaderState ~= "Idle" then

				syncedBoss =
					leaderBoss

				waitForLeader =
					false
			end
		end

		if leader then

			local leaderState =
				tostring(
					leader.state or ""
				)

			if leaderState == "Open Chest"
				or leaderState == "Picking Loot" then

				if MultiFarm.collectFollowerLoot(
					LOOT_FIRST_SPAWN_TIMEOUT
				) then

					task.wait(0.05)
					continue
				end
			end
		end

		if waitForLeader then

			MultiFarm.setStatus(
				"Waiting Sync",
				MultiFarm.Boss
			)

			task.wait(0.10)
			continue
		end

		bossName =
			syncedBoss
			or bossName

		if MultiFarm.CatchUpRequested then

			MultiFarm.CatchUpRequested =
				false

			MultiFarm.setStatus(
				"Catching Up",
				bossName
			)
		end


		bossProcessBusy =
			true

		local result =
			processBoss(
				bossName
			)

		bossProcessBusy =
			false


		if not Runtime.alive then
			break
		end


		if result == "next" then

			currentBossIndex += 1


			bossRoute =
				getBossRoute()


			if currentBossIndex
				> #bossRoute then

				currentBossIndex = 1
			end


		elseif result
			== "retry" then

			task.wait(0.25)


		elseif result
			== "player_died" then

			MultiFarm.setStatus(
				"Respawning",
				bossName
			)

			if not MultiFarm.isFollower() then

				MultiFarm.RespawnRecoveryPending =
					true

				MultiFarm.RespawnBossName =
					bossName

				MultiFarm.RespawnBossPosition =
					MultiFarm.ActiveBossPosition
			end

			currentBossIndex =
				lastBossIndex


			while Runtime.alive
				and farmEnabled
				and not isPlayerAlive() do

				task.wait(0.1)
			end


			if Runtime.alive
				and farmEnabled then

				task.wait(0.35)

				if MultiFarm.Online.Enabled then

					MultiFarm.Online.startCritical(
						5
					)

					MultiFarm.Online.pull()

					if not MultiFarm.isFollower() then

						MultiFarm.Online.applyRespawnRecovery(
							bossName
						)
					end

					MultiFarm.Online.push(
						MultiFarm.isFollower()
							and "FollowerRespawned"
							or "LeaderRespawned",
						"Resuming",
						bossName,
						MultiFarm.RespawnBossPosition
							or MultiFarm.ActiveBossPosition,
						true
					)
				end

				ensureToolOneReady(
					TOOL_READY_TIMEOUT
				)
			end


		elseif result
			== "paused" then

			task.wait(0.1)

		else

			task.wait(0.05)
		end
	end


	bossProcessBusy =
		false

	if ENV[RUNTIME_KEY]
		== Runtime then

		ENV[RUNTIME_KEY] = nil
	end
end)
