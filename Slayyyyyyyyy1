function MultiFarm.nowMs()
	return DateTime.now().UnixTimestampMillis
end


function MultiFarm.notify(key, content)
	if not MultiFarm.NotifierEnabled then
		return
	end

	local fluent =
		Runtime.fluent

	if not fluent then
		return
	end

	key =
		tostring(
			key or content or ""
		)

	local now =
		os.clock()

	if MultiFarm.NotifyLastKey == key
		and now - MultiFarm.NotifyLastAt
			< 0.8 then

		return
	end

	MultiFarm.NotifyLastKey =
		key

	MultiFarm.NotifyLastAt =
		now

	pcall(function()

		fluent:Notify({
			Title = "Boss Farm",
			Content =
				tostring(
					content or ""
				),
			Duration = 2
		})

	end)
end


