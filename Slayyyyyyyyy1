local function getLiveBoss(bossName)
	local folder =
		getBossFolder(
			bossName
		)

	if not folder then
		return nil
	end

	local sameName =
		folder:FindFirstChild(
			bossName
		)

	if sameName
		and sameName:IsA("Model") then

		local humanoid =
			getBossHumanoid(
				sameName
			)

		if humanoid
			and humanoid.Health > 0 then

			return sameName
		end
	end

	if folder:IsA("Model") then

		local humanoid =
			getBossHumanoid(
				folder
			)

		if humanoid
			and humanoid.Health > 0 then

			return folder
		end
	end

	for _, child in ipairs(
		folder:GetChildren()
	) do

		if child:IsA("Model") then

			local humanoid =
				getBossHumanoid(
					child
				)

			if humanoid
				and humanoid.Health > 0 then

				return child
			end
		end
	end

	return nil
end

