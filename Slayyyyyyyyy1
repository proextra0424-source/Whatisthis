end


local function runWeaponMasteryBurst(
	boss,
	getUsableBossCallback
)
	if not weaponMasteryFarmEnabled then
		return true
	end

	if not Runtime.alive
		or not farmEnabled
		or not isPlayerAlive() then

		return false
	end

	if not setEquippedSlot(3) then
		setEquippedToOne()
		return false
	end

	task.wait(
		WEAPON_MASTERY_EQUIP_DELAY
	)

	local timeoutAt =
		os.clock()
		+ WEAPON_MASTERY_DURATION

	local nextAttack =
		0

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and isPlayerAlive()
		and os.clock() < timeoutAt do

		local humanoid, bossRoot =
			getUsableBossCallback(
				boss
			)

		if not humanoid
			or not bossRoot then

			break
		end

		if followPosition then

			followPosition.Position =
				bossRoot.Position
				+ Vector3.new(
					0,
					FOLLOW_HEIGHT,
					0
				)
		end

		local now =
			os.clock()

		if now >= nextAttack then

			nextAttack =
				now
				+ ATTACK_INTERVAL

			attackOnce()
		end

		task.wait(0.02)
	end

	setEquippedToOne()

	ensureToolOneReady(
		TOOL_READY_TIMEOUT
	)

	return true
end


local function fightBoss(bossName, boss)
	if deliveryBusy then
		return "paused", nil
	end

	if not bossName then
		return "boss_lost", nil
	end


	local bossDiedConfirmed =
		false

	local bossWasEngaged =
		false

	local diedConnection =
		nil

	local healthConnection =
		nil


	local function disconnectDied()
		if diedConnection then

			pcall(function()
				diedConnection:Disconnect()
			end)

			diedConnection = nil
		end

		if healthConnection then

			pcall(function()
				healthConnection:Disconnect()
			end)

			healthConnection = nil
		end
	end


	local function hookBossHumanoid(model)
		disconnectDied()

		local humanoid =
			getBossHumanoid(model)

		if not humanoid then
			return nil
		end


		bossWasEngaged =
			true

		if humanoid.Health <= 0 then
			bossDiedConfirmed =
				true
		end

		healthConnection =
			humanoid.HealthChanged:Connect(function(health)

				if health <= 0 then

					bossDiedConfirmed =
						true
				end

			end)

		diedConnection =
			humanoid.Died:Connect(function()

				bossDiedConfirmed =
					true

			end)


		return humanoid
	end


	local function cleanupFight()
		disconnectDied()
		destroyFollow()
	end


	local function getUsableBoss(model)
		if not model
			or not model.Parent then

			return nil, nil
		end


		local humanoid =
			getBossHumanoid(model)

		local root =
			getBossRoot(model)


		if humanoid
			and humanoid.Health > 0
			and root then

			return humanoid, root
		end


		if humanoid
			and humanoid.Health <= 0 then

			bossDiedConfirmed =
				true
		end


		return nil, nil
	end


	local function reacquireBoss()
		local grace =
			bossWasEngaged
				and 0.25
				or BOSS_REACQUIRE_GRACE

		local deadline =
			os.clock()
			+ grace


		while Runtime.alive
			and farmEnabled
			and not deliveryBusy
			and isPlayerAlive()
			and os.clock() < deadline do


			local candidate =
				getLiveBoss(
					bossName
				)


			if candidate then

				local humanoid, root =
					getUsableBoss(
						candidate
					)


				if humanoid and root then

					return
						candidate,
						humanoid,
						root
				end
			end


			task.wait(0.10)
		end


		return nil
	end


	if not boss then

		boss =
			getLiveBoss(
				bossName
			)
	end


	local bossHumanoid, bossRoot =
		getUsableBoss(
			boss
		)


	if not bossHumanoid
		or not bossRoot then

		boss,
		bossHumanoid,
		bossRoot =
			reacquireBoss()


		if not boss then

			return
				bossDiedConfirmed
					and "boss_dead"
					or "boss_lost",
				nil
		end
	end


	hookBossHumanoid(
		boss
	)


	local character, humanoid, root =
		waitForCharacterReady()


	if not character
		or not humanoid
		or not root then

		cleanupFight()

		return "paused", nil
	end


	ensureToolOneReady(
		TOOL_READY_TIMEOUT
	)


	character, humanoid, root =
		waitForCharacterReady()


	if not character
		or not humanoid
		or not root then

		cleanupFight()

		return "paused", nil
	end


	local isHimejimaClan =
		getPlayerClan()
		== "Himejima"


	if selectedClanSkillKey
		and not isHimejimaClan then

		useClanSkill()

		if not Runtime.alive
			or not farmEnabled then

			cleanupFight()

			return "paused", nil
		end


		if not isPlayerAlive() then

			cleanupFight()

			return
				"player_died",
				bossRoot
					and bossRoot.Position
					or nil
		end


		ensureToolOneReady(
			TOOL_READY_TIMEOUT
		)


		bossHumanoid, bossRoot =
			getUsableBoss(
				boss
			)


		if not bossHumanoid
			or not bossRoot then

			local newBoss,
				newHumanoid,
				newRoot =
				reacquireBoss()


			if newBoss then

				boss =
					newBoss

				bossHumanoid =
					newHumanoid

				bossRoot =
					newRoot


				hookBossHumanoid(
					boss
				)

			else

				cleanupFight()


				return
					bossDiedConfirmed
						and "boss_dead"
						or "boss_lost",
					nil
			end
		end
	end


	local targetPosition =
		bossRoot.Position
		+ Vector3.new(
			0,
			FOLLOW_HEIGHT,
			0
		)


	character:PivotTo(
		CFrame.new(
			targetPosition
		)
		* CFrame.Angles(
			math.rad(-90),
			0,
			0
		)
	)


	root.AssemblyLinearVelocity =
		Vector3.zero

	root.AssemblyAngularVelocity =
		Vector3.zero


	if not createFollowConstraints() then

		cleanupFight()

		return "paused", nil
	end


	if selectedClanSkillKey
		and isHimejimaClan then

		task.wait(0.05)

		useClanSkill()

		if not Runtime.alive
			or not farmEnabled then

			cleanupFight()

			return "paused", nil
		end


		if not isPlayerAlive() then

			cleanupFight()

			return
				"player_died",
				bossRoot
					and bossRoot.Position
					or nil
		end


		ensureToolOneReady(
			TOOL_READY_TIMEOUT
		)
	end


	if weaponMasteryFarmEnabled then

		runWeaponMasteryBurst(
			boss,
			getUsableBoss
		)

		if not Runtime.alive
			or not farmEnabled then

			cleanupFight()

			return "paused", nil
		end


		if not isPlayerAlive() then

			cleanupFight()

			return
				"player_died",
				bossRoot
					and bossRoot.Position
					or nil
		end


		bossHumanoid, bossRoot =
			getUsableBoss(
				boss
			)


		if not bossHumanoid
			or not bossRoot then

			local newBoss,
				newHumanoid,
				newRoot =
				reacquireBoss()


			if newBoss then

				boss =
					newBoss

				bossHumanoid =
					newHumanoid

				bossRoot =
					newRoot


				hookBossHumanoid(
					boss
				)

			else

				cleanupFight()

				return
					bossDiedConfirmed
						and "boss_dead"
						or "boss_lost",
					nil
			end
		end
	end


	humanoid =
		getCharacterHumanoid()

	if humanoid then
		humanoid.AutoRotate =
			false
	end


	lastAttackTime = 0
	lastAutoSkillTime = 0

	lastClanSkillTime =
		os.clock()


	local lastBossPosition =
		bossRoot.Position

	MultiFarm.ActiveBossName =
		bossName

	MultiFarm.ActiveBossPosition =
		lastBossPosition

	local lastToolRefresh =
		0

	local stuckSince =
		nil

	local lastSnapTime =
		0


	while Runtime.alive
		and farmEnabled
		and not deliveryBusy do


		if not isPlayerAlive() then

			cleanupFight()

			return
				"player_died",
				lastBossPosition
		end


		bossHumanoid, bossRoot =
			getUsableBoss(
				boss
			)


		if not bossHumanoid
			or not bossRoot then


			if bossDiedConfirmed then

				cleanupFight()

				return
					"boss_dead",
					lastBossPosition
			end


			local newBoss,
				newHumanoid,
				newRoot =
				reacquireBoss()


			if newBoss then

				boss =
					newBoss

				bossHumanoid =
					newHumanoid

				bossRoot =
					newRoot


				hookBossHumanoid(
					boss
				)


				if not followPosition
					or not followPosition.Parent then

					createFollowConstraints()
				end

			else

				cleanupFight()


				if bossDiedConfirmed then

					return
						"boss_dead",
						lastBossPosition

				else

					return
						"boss_lost",
						lastBossPosition
				end
			end
		end


		lastBossPosition =
			bossRoot.Position

		MultiFarm.ActiveBossName =
			bossName

		MultiFarm.ActiveBossPosition =
			lastBossPosition


		local desiredFollowPosition =
			bossRoot.Position
			+ Vector3.new(
				0,
				FOLLOW_HEIGHT,
				0
			)


		if followPosition then

			followPosition.Position =
				desiredFollowPosition
		end


		local currentRoot =
			getCharacterRoot()


		if currentRoot then

			local followDistance =
				(
					currentRoot.Position
					- desiredFollowPosition
				).Magnitude


			if followDistance
				>= FOLLOW_STUCK_DISTANCE then

				if not stuckSince then

					stuckSince =
						os.clock()

				elseif os.clock()
						- stuckSince
						>= FOLLOW_STUCK_TIME
					and os.clock()
						- lastSnapTime
						>= FOLLOW_SNAP_COOLDOWN then

					lastSnapTime =
						os.clock()

					stuckSince =
						nil


					local currentCharacter =
						getCharacter()


					if currentCharacter then

						currentCharacter:PivotTo(
							CFrame.new(
								desiredFollowPosition
							)
							* CFrame.Angles(
								math.rad(-90),
								0,
								0
							)
						)


						currentRoot.AssemblyLinearVelocity =
							Vector3.zero

						currentRoot.AssemblyAngularVelocity =
							Vector3.zero
					end
				end

			else

				stuckSince =
					nil
			end
		end


		local playerHumanoid =
			getCharacterHumanoid()

		if playerHumanoid then

			playerHumanoid.AutoRotate =
				false
		end


		local now =
			os.clock()


		if not clanSkillBusy
			and now - lastToolRefresh
				>= TOOL_REFRESH_INTERVAL then

			lastToolRefresh =
				now


			local currentCharacter =
				getCharacter()


			if currentCharacter
				and not currentCharacter:
					FindFirstChildOfClass("Tool") then

				setEquippedToOne()
			end
		end


		if not clanSkillBusy then

			if now - lastAttackTime
				>= ATTACK_INTERVAL then

				lastAttackTime =
					now

				attackOnce()
			end


			if #selectedAutoSkillKeys > 0
				and now - lastAutoSkillTime
					>= AUTO_SKILL_INTERVAL then

				lastAutoSkillTime =
					now

				useAutoSkill()
			end
		end


		if selectedClanSkillKey
			and now - lastClanSkillTime
				>= CLAN_SKILL_INTERVAL then

			lastClanSkillTime =
				now

			useClanSkill()
		end


		task.wait(0.03)
	end


	cleanupFight()

	return
		"paused",
		lastBossPosition
end


local function waitAbortable(seconds)
	local endTime = os.clock() + seconds

	while os.clock() < endTime do
		if not farmEnabled
			or deliveryBusy then
			return false
		end

		if not isPlayerAlive() then
			return false
		end

		task.wait(0.05)
	end

	return true
end


local function findNearestWorldEventsChest(origin)
	if not origin then
		return nil
	end

	local chestsFolder =
		workspace:FindFirstChild(
			"Chests"
		)

	if not chestsFolder then
		return nil
	end

	local validNames = {
		["World Events Chest"] = true,
		["Lost Chest"] = true,
		["Ice Chest"] = true
	}

	local nearestChest =
		nil

	local nearestDistance =
		CHEST_SEARCH_RADIUS

	for _, object in ipairs(
		chestsFolder:GetDescendants()
	) do

		if validNames[
			object.Name
		] then

			local position =
				getObjectPosition(
					object
				)

			if position then

				local distance =
					(
						position
						- origin
					).Magnitude

				if distance
					<= nearestDistance then

					nearestDistance =
						distance

					nearestChest =
						object
				end
			end
		end
	end

	for chestName in pairs(
		validNames
	) do

		local direct =
			chestsFolder:FindFirstChild(
				chestName
			)

		if direct then

			local position =
				getObjectPosition(
					direct
				)

			if position then

				local distance =
					(
						position
						- origin
					).Magnitude

				if distance
					<= nearestDistance then

					nearestDistance =
						distance

					nearestChest =
						direct
				end
			end
		end
	end

	return nearestChest
end

local function waitForWorldEventsChest(origin)
	if not origin then
		return nil
	end

	local timeoutAt =
		os.clock()
		+ CHEST_WAIT_TIMEOUT

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do
		if not isPlayerAlive() then
			waitForCharacterReady()
		end

		local chest = findNearestWorldEventsChest(origin)

		if chest then
			return chest
		end

		task.wait(CHEST_POLL_INTERVAL)
	end

	return nil
end


local function getLootDropChildCount()
	local lootFolder =
		workspace:FindFirstChild(
			"LootDrops"
		)

	if not lootFolder then
		return 0
	end

	return #lootFolder:GetChildren()
end


function MultiFarm.getNearestRawLootPromptPosition(origin, radius)
	local lootFolder =
		workspace:FindFirstChild(
			"LootDrops"
		)

	if not lootFolder then
		return nil
	end

	radius =
		tonumber(radius)
		or CHEST_SEARCH_RADIUS

	local bestPosition =
		nil

	local bestDistance =
		math.huge

	for _, drop in ipairs(
		lootFolder:GetChildren()
	) do

		local prompt =
			drop:FindFirstChild(
				"LootDropPrompt",
				true
			)

		if prompt
			and prompt:IsA(
				"ProximityPrompt"
			) then

			local position =
				getObjectPosition(
					prompt.Parent
				)
				or getObjectPosition(
					drop
				)

			if position then

				local distance =
					origin
					and (
						position
						- origin
					).Magnitude
					or 0

				if distance <= radius
					and distance
						< bestDistance then

					bestDistance =
						distance

					bestPosition =
						position
				end
			end
		end
	end

	return bestPosition
end


local function waitForChestPrompt(chest)
	local timeoutAt =
		os.clock()
		+ CHEST_PROMPT_WAIT_TIMEOUT

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and chest
		and chest.Parent
		and os.clock() < timeoutAt do

		local prompt =
			chest:FindFirstChildWhichIsA(
				"ProximityPrompt",
				true
			)

		if prompt then
			return prompt
		end

		task.wait(0.05)
	end

	return nil
end


local function openWorldEventsChest(origin)
	if MultiFarm.isFollower() then
		return false
	end

	local chest =
		waitForWorldEventsChest(
			origin
		)

	if not chest then
		return false
	end

	MultiFarm.setStatus(
		"Open Chest",
		MultiFarm.Boss
	)

	MultiFarm.notify(
		"doing:open_chest",
		'Doing "Open Chest"'
	)

	local beforeLootCount =
		getLootDropChildCount()

	local prompt =
		waitForChestPrompt(
			chest
		)

	if not prompt then

		if not chest.Parent
			or getLootDropChildCount()
				> beforeLootCount then

			local externalOpenWaitUntil =
				os.clock()
				+ LOOT_FIRST_SPAWN_TIMEOUT

			while Runtime.alive
				and farmEnabled
				and not deliveryBusy
				and os.clock()
					< externalOpenWaitUntil do

				if getLootDropChildCount()
					> beforeLootCount then

					break
				end

				task.wait(0.03)
			end

			return true
		end

		return false
	end

	local promptPosition =
		getObjectPosition(
			prompt.Parent
		)
		or getObjectPosition(
			chest
		)

	if not promptPosition then
		return false
	end

	teleportToPosition(
		promptPosition
		+ Vector3.new(
			0,
			1,
			0
		)
	)

	task.wait(
		CHEST_ARRIVAL_DELAY
	)

	local timeoutAt =
		os.clock()
		+ CHEST_OPEN_TIMEOUT

	local opened =
		false

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do

		if not isPlayerAlive() then
			return false
		end

		if not chest.Parent
			or not prompt.Parent then

			opened =
				true

			break
		end

		if prompt.Enabled then

			local root =
				getCharacterRoot()

			local currentPromptPosition =
				getObjectPosition(
					prompt.Parent
				)
				or promptPosition

			if root
				and currentPromptPosition then

				local maxDistance =
					math.max(
						prompt.MaxActivationDistance,
						5
					)

				if (
					root.Position
					- currentPromptPosition
				).Magnitude
					> maxDistance - 0.5 then

					teleportToPosition(
						currentPromptPosition
						+ Vector3.new(
							0,
							1,
							0
						)
					)

					task.wait(
						CHEST_ARRIVAL_DELAY
					)
				end
			end

			firePrompt(
				prompt
			)
		end

		if getLootDropChildCount()
			> beforeLootCount then

			opened =
				true

			break
		end

		task.wait(
			CHEST_OPEN_RETRY_INTERVAL
		)
	end

	if not opened
		and getLootDropChildCount()
			> beforeLootCount then

		opened =
			true
	end

	if not opened then
		return false
	end

	local lootWaitUntil =
		os.clock()
		+ LOOT_FIRST_SPAWN_TIMEOUT

	while Runtime.alive
		and farmEnabled
		and os.clock() < lootWaitUntil do

		if getLootDropChildCount()
			> beforeLootCount then

			break
		end

		task.wait(0.03)
	end

	return true
end


local function lootDropHasPayload(drop)
	if not drop then
		return false
	end

	for _, child in ipairs(drop:GetChildren()) do

		if child.Name ~= "LootDropPrompt" then

			if child:IsA("BasePart")
				or child:IsA("Model") then

				return true
			end

			if child:FindFirstChildWhichIsA("BasePart", true)
				or child:FindFirstChildWhichIsA("Model", true) then

				return true
			end
		end
	end

	return false
end


local function getLootEntries()
	local lootFolder = workspace:FindFirstChild("LootDrops")
	if not lootFolder then
		return {}
	end

	local entries = {}

	for _, drop in ipairs(lootFolder:GetChildren()) do
		local prompt = drop:FindFirstChild("LootDropPrompt", true)

		if prompt
			and prompt:IsA("ProximityPrompt")
			and lootDropHasPayload(drop) then

			table.insert(entries, {
				drop = drop,
				prompt = prompt
			})
		end
	end

	return entries
end

function MultiFarm.beginLootNoclip()
	MultiFarm.LootNoclip =
		true

	MultiFarm.LootNoclipParts =
		{}

	local character =
		LocalPlayer.Character

	if not character then
		return
	end

	for _, object in ipairs(
		character:GetDescendants()
	) do
		if object:IsA("BasePart") then
			MultiFarm.LootNoclipParts[object] =
				object.CanCollide

			pcall(function()
				object.CanCollide =
					false
			end)
		end
	end
end


function MultiFarm.refreshLootNoclip()
	if not MultiFarm.LootNoclip then
		return
	end

	local character =
		LocalPlayer.Character

	if not character then
		return
	end

	for _, object in ipairs(
		character:GetDescendants()
	) do
		if object:IsA("BasePart") then
			if MultiFarm.LootNoclipParts[object]
				== nil then

				MultiFarm.LootNoclipParts[object] =
					object.CanCollide
			end

			pcall(function()
				object.CanCollide =
					false
			end)
		end
	end
end


function MultiFarm.endLootNoclip()
	MultiFarm.LootNoclip =
		false

	local states =
		MultiFarm.LootNoclipParts
		or {}

	MultiFarm.LootNoclipParts =
		{}

	for object, canCollide
		in pairs(states) do

		if object
			and object.Parent then

			pcall(function()
				object.CanCollide =
					canCollide
			end)
		end
	end
end


local function collectSingleLoot(entry)
	if not entry then
		return
	end

	local drop = entry.drop
	local prompt = entry.prompt

	if not drop
		or not drop.Parent
		or not prompt
		or not prompt.Parent then

		return
	end

	local position =
		getObjectPosition(prompt.Parent)
		or getObjectPosition(drop)

	if not position then
		return
	end

	local targetPosition =
		position
		+ Vector3.new(
			0,
			1.25,
			0
		)

	local oldDistance =
		prompt.MaxActivationDistance

	local oldLOS =
		prompt.RequiresLineOfSight

	pcall(function()
		prompt.MaxActivationDistance =
			math.max(
				oldDistance,
				50
			)

		prompt.RequiresLineOfSight =
			false
	end)

	MultiFarm.beginLootNoclip()

	teleportToPosition(
		targetPosition
	)

	task.wait(
		LOOT_ARRIVAL_DELAY
	)

	local timeoutAt =
		os.clock()
		+ LOOT_COLLECT_TIMEOUT

	local nextRetry = 0

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and drop.Parent
		and prompt.Parent
		and os.clock() < timeoutAt do

		if not isPlayerAlive() then
			MultiFarm.endLootNoclip()

			waitForCharacterReady()

			if drop.Parent
				and prompt.Parent then

				local newPosition =
					getObjectPosition(
						prompt.Parent
					)
					or getObjectPosition(
						drop
					)

				if newPosition then
					targetPosition =
						newPosition
						+ Vector3.new(
							0,
							1.25,
							0
						)

					MultiFarm.beginLootNoclip()

					teleportToPosition(
						targetPosition
					)

					task.wait(
						LOOT_ARRIVAL_DELAY
					)
				end
			end
		end

		MultiFarm.refreshLootNoclip()

		local character =
			LocalPlayer.Character

		local root =
			character
			and character:FindFirstChild(
				"HumanoidRootPart"
			)

		if root
			and (
				root.Position
				- targetPosition
			).Magnitude > 1.5 then

			pcall(function()
				character:PivotTo(
					CFrame.new(
						targetPosition
					)
				)

				root.AssemblyLinearVelocity =
					Vector3.zero

				root.AssemblyAngularVelocity =
					Vector3.zero
			end)
		end

		local now =
			os.clock()

		if now >= nextRetry then
			firePrompt(prompt)

			nextRetry =
				now
				+ LOOT_RETRY_INTERVAL
		end

		if not drop.Parent
			or not prompt.Parent then

			break
		end

		task.wait(0.02)
	end

	MultiFarm.endLootNoclip()

	if prompt
		and prompt.Parent then

		pcall(function()
			prompt.MaxActivationDistance =
				oldDistance

			prompt.RequiresLineOfSight =
				oldLOS
		end)
	end

	task.wait(0.01)
end

local function collectAllLoot()
	MultiFarm.setStatus(
		"Picking Loot",
		MultiFarm.Boss
	)

	MultiFarm.notify(
		"doing:picking_loot",
		'Doing "Picking Loot"'
	)

	local emptySince = nil
	local firstLootDeadline = os.clock() + LOOT_FIRST_SPAWN_TIMEOUT
	local hasSeenLoot = false

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy do

		if not isPlayerAlive() then
			waitForCharacterReady()
		end


		local entries =
			getLootEntries()


		if #entries == 0 then

			if not hasSeenLoot
				and os.clock()
					< firstLootDeadline then

				task.wait(0.03)
				continue
			end

			if not emptySince then
				emptySince =
					os.clock()
			end

			if os.clock() - emptySince
				>= LOOT_EMPTY_CONFIRM_TIME then

				return
			end

			task.wait(0.03)

		else

			hasSeenLoot = true
			emptySince = nil

			collectSingleLoot(
				entries[1]
			)
		end
	end
end


function MultiFarm.collectFollowerLoot(waitTime)
	if MultiFarm.LootBusy then
		return false
	end

	if not MultiFarm.Enabled
		or MultiFarm.Target == "None"
		or MultiFarm.Target == "" then

		return false
	end

	local leader =
		MultiFarm.getLeader()

	if not leader then
		return false
	end

	local leaderState =
		tostring(
			leader.state or ""
		)

	if leaderState ~= "Open Chest"
		and leaderState ~= "Picking Loot" then

		return false
	end

	MultiFarm.LootBusy =
		true

	MultiFarm.RewardBusy =
		true

	local timeoutAt =
		os.clock()
		+ (
			waitTime
			or LOOT_FIRST_SPAWN_TIMEOUT
		)

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do

		if #getLootEntries() > 0 then
			break
		end

		leader =
			MultiFarm.getLeader()

		if not leader then
			break
		end

		leaderState =
			tostring(
				leader.state or ""
			)

		if leaderState ~= "Open Chest"
			and leaderState ~= "Picking Loot" then

			if #getLootEntries() == 0 then
				break
			end
		end

		task.wait(0.03)
	end

	local hasLoot =
		#getLootEntries() > 0

	if hasLoot
		and Runtime.alive
		and farmEnabled
		and not deliveryBusy then

		MultiFarm.setStatus(
			"Picking Loot",
			tostring(
				leader
				and leader.boss
				or MultiFarm.Boss
				or ""
			)
		)

		collectAllLoot()
	end

	MultiFarm.LootBusy =
		false

	MultiFarm.RewardBusy =
		false

	return hasLoot
end


local function handleBossRewards(deathPosition)
	if not farmEnabled then
		return
	end

	local timeoutAt =
		os.clock()
		+ BOSS_REWARD_WAIT_TIMEOUT

	local initialRawLootCount =
		getLootDropChildCount()

	local lootGraceExtended =
		false

	local followerPublishedChest =
		false

	local lastOnlinePull =
		0

	local lastRecoveryTeleport =
		0

	if MultiFarm.Online.Enabled then

		MultiFarm.Online.startCritical(
			BOSS_REWARD_WAIT_TIMEOUT
				+ 2
		)
	end

	if MultiFarm.isFollower() then

		while Runtime.alive
			and farmEnabled
			and not deliveryBusy
			and os.clock() < timeoutAt do

			local entries =
				getLootEntries()

			if #entries > 0 then

				if MultiFarm.Online.Enabled
					and not followerPublishedChest then

					followerPublishedChest =
						true

					local rewardPosition =
						MultiFarm.getNearestRawLootPromptPosition(
							deathPosition,
							CHEST_SEARCH_RADIUS
						)
						or deathPosition
						or MultiFarm.ActiveBossPosition

					MultiFarm.Online.push(
						"ChestOpened",
						"Picking Loot",
						MultiFarm.Boss,
						rewardPosition,
						true
					)

					MultiFarm.Online.startCritical(
						5
					)
				end

				collectAllLoot()

				return
			end

			local rawLootCount =
				getLootDropChildCount()

			if rawLootCount
				> initialRawLootCount then

				if not lootGraceExtended then

					lootGraceExtended =
						true

					timeoutAt =
						math.max(
							timeoutAt,
							os.clock()
								+ BOSS_REWARD_WAIT_TIMEOUT
						)
				end

				MultiFarm.setStatus(
					"Waiting Loot",
					MultiFarm.Boss
				)

				if MultiFarm.Online.Enabled
					and not followerPublishedChest then

					followerPublishedChest =
						true

					local rewardPosition =
						MultiFarm.getNearestRawLootPromptPosition(
							deathPosition,
							CHEST_SEARCH_RADIUS
						)
						or deathPosition
						or MultiFarm.ActiveBossPosition

					MultiFarm.Online.push(
						"ChestOpened",
						"Waiting Loot",
						MultiFarm.Boss,
						rewardPosition,
						true
					)

					MultiFarm.Online.startCritical(
						5
					)
				end
			end

			task.wait(
				CHEST_POLL_INTERVAL
			)
		end

		return
	end

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do

		local entries =
			getLootEntries()

		if #entries > 0 then

			collectAllLoot()

			return
		end

		local now =
			os.clock()

		if MultiFarm.Online.Enabled
			and not MultiFarm.Online.RateLimited
			and now - lastOnlinePull
				>= 1 then

			lastOnlinePull =
				now

			MultiFarm.Online.pull()
		end

		local rawLootCount =
			getLootDropChildCount()

		if rawLootCount
			> initialRawLootCount then

			if not lootGraceExtended then

				lootGraceExtended =
					true

				timeoutAt =
					math.max(
						timeoutAt,
						os.clock()
							+ BOSS_REWARD_WAIT_TIMEOUT
					)
			end

			MultiFarm.setStatus(
				"Waiting Loot",
				MultiFarm.Boss
			)
		end

		local chest =
			deathPosition
			and findNearestWorldEventsChest(
				deathPosition
			)
			or nil

		if chest then

			local opened =
				openWorldEventsChest(
					deathPosition
				)

			if opened then

				lootGraceExtended =
					true

				timeoutAt =
					math.max(
						timeoutAt,
						os.clock()
							+ BOSS_REWARD_WAIT_TIMEOUT
					)

				MultiFarm.setStatus(
					"Waiting Loot",
					MultiFarm.Boss
				)
			end

		else

			local remoteRewardPosition =
				MultiFarm.Online.Enabled
				and MultiFarm.Online.getRemoteRewardPosition(
					MultiFarm.Boss
				)
				or nil

			local rawLootPosition =
				MultiFarm.getNearestRawLootPromptPosition(
					deathPosition
						or remoteRewardPosition,
					CHEST_SEARCH_RADIUS
				)

			local recoveryPosition =
				rawLootPosition
				or remoteRewardPosition

			if recoveryPosition
				and now
					- lastRecoveryTeleport
					>= 0.35 then

				lastRecoveryTeleport =
					now

				MultiFarm.setStatus(
					"Waiting Loot",
					MultiFarm.Boss
				)

				teleportToPosition(
					recoveryPosition
					+ Vector3.new(
						0,
						1,
						0
					)
				)

				task.wait(0.08)

				if #getLootEntries()
					> 0 then

					collectAllLoot()

					return
				end
			end
		end

		task.wait(
			CHEST_POLL_INTERVAL
		)
	end

	if #getLootEntries() > 0 then
		collectAllLoot()
	end
end

local function collectNearbyWorldEventChest(origin)
	if MultiFarm.isFollower() then
		return false
	end

	if not origin then
		return false
	end

	local chest =
		findNearestWorldEventsChest(
			origin
		)

	if not chest then
		return false
	end

	MultiFarm.setStatus(
		"Open Chest",
		MultiFarm.Boss
	)

	MultiFarm.notify(
		"doing:open_chest",
		'Doing "Open Chest"'
	)

	local prompt =
		waitForChestPrompt(
			chest
		)

	if not prompt then
		return false
	end

	local beforeLootCount =
		getLootDropChildCount()

	local promptPosition =
		getObjectPosition(
			prompt.Parent
		)
		or getObjectPosition(
			chest
		)

	if not promptPosition then
		return false
	end

	teleportToPosition(
		promptPosition
		+ Vector3.new(
			0,
			1,
			0
		)
	)

	task.wait(
		CHEST_ARRIVAL_DELAY
	)

	local timeoutAt =
		os.clock()
		+ CHEST_OPEN_TIMEOUT

	local opened = false

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do

		if not isPlayerAlive() then
			return false
		end

		if not chest.Parent
			or not prompt.Parent then

			opened = true
			break
		end

		if prompt.Enabled then
			firePrompt(prompt)
		end

		if getLootDropChildCount()
			> beforeLootCount then

			opened = true
			break
		end

		task.wait(
			CHEST_OPEN_RETRY_INTERVAL
		)
	end

	if not opened
		and getLootDropChildCount()
			> beforeLootCount then

		opened = true
	end

	if not opened then
		return false
	end

	if MultiFarm.Online.Enabled then

		task.spawn(function()

			MultiFarm.Online.push(
				"ChestOpened",
				"Open Chest",
				MultiFarm.Boss,
				origin,
				true
			)

		end)
	end

	collectAllLoot()

	return true
end


local function getCrowQuestHolder()
	local playerGui =
		LocalPlayer:FindFirstChild(
			"PlayerGui"
		)

	if not playerGui then
		return nil
	end

	local componentsHolder =
		playerGui:FindFirstChild(
			"ComponentsHolder"
		)

	if not componentsHolder then
		return nil
	end

	local dialogueContent =
		componentsHolder:FindFirstChild(
			"DialogueContent"
		)

	if not dialogueContent then
		return nil
	end

	if dialogueContent:IsA("GuiObject")
		and not dialogueContent.Visible then

		return nil
	end

	local frame =
		dialogueContent:FindFirstChild(
			"Frame"
		)

	if not frame then
		return nil
	end

	if frame:IsA("GuiObject")
		and not frame.Visible then

		return nil
	end

	local listMask =
		frame:FindFirstChild(
			"ListMask"
		)

	if not listMask then
		return nil
	end

	local actualHolder =
		listMask:FindFirstChild(
			"ActualHolder"
		)

	if not actualHolder then
		return nil
	end

	return actualHolder:FindFirstChild(
		"InnerHolder"
	)
end


local function trimText(value)
	return tostring(value)
		:gsub("^%s+", "")
		:gsub("%s+$", "")
end


local function getCrowQuestData(holder)
	local result = {}

	if not holder then
		return result
	end

	for _, object in ipairs(
		holder:GetChildren()
	) do

		local id =
			string.match(
				object.Name,
				"^Hunt(%d+)$"
			)

		if id then

			local content =
				object:FindFirstChild(
					"Content"
				)

			local quest =
				content
				and content:FindFirstChild(
					"Quest"
				)

			if quest
				and (
					quest:IsA("TextLabel")
					or quest:IsA("TextButton")
					or quest:IsA("TextBox")
				) then

				local questText =
					trimText(
						quest.Text
					)

				if questText ~= "" then

					table.insert(
						result,
						{
							id = id,
							text = questText
						}
					)
				end
			end
		end
	end

	return result
end


local function waitForCrowQuestHolder()
	local timeoutAt =
		os.clock()
		+ CROW_UI_TIMEOUT

	local emptySince =
		nil

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do

		local holder =
			getCrowQuestHolder()

		if holder then

			local quests =
				getCrowQuestData(
					holder
				)

			if #quests > 0 then
				return holder
			end

			if not emptySince then
				emptySince =
					os.clock()

			elseif os.clock()
					- emptySince
					>= CROW_EMPTY_UI_GRACE then

				return holder
			end

		else

			emptySince =
				nil
		end

		task.wait(
			CROW_POLL_INTERVAL
		)
	end

	return nil
end


local function findCrowQuestForBoss(holder, bossName)
	local wanted =
		string.lower(
			trimText(
				bossName
			)
		)

	for _, questData in ipairs(
		getCrowQuestData(
			holder
		)
	) do

		local target =
			string.match(
				questData.text,
				"^[Dd][Ee][Ff][Ee][Aa][Tt]%s+(.+)$"
			)

		if target then

			target =
				string.lower(
					trimText(
						target
					)
				)

			if target == wanted then
				return questData
			end
		end
	end

	return nil
end


local function claimCrowQuest(id)
	if not id then
		return false
	end

	local event =
		Runtime.getBossHuntsEvent()

	if not event then

		
		return false
	end

	return pcall(function()

		event:FireServer(
			"BossHuntsRequest",
			{
				action = "Claim",
				id = tostring(id)
			}
		)

	end)
end


local function closeCrowQuestAndRestoreTool()
	setEquippedSlot(1)

	task.wait(0.08)

	ensureToolOneReady(
		TOOL_READY_TIMEOUT
	)
end


local function tryAutoCrowQuest(bossName, boss)
	if not autoCrowQuestEnabled then
		return false
	end

	if CROW_SKIP_BOSSES[bossName] then
		return false
	end

	if not selectedBossSet[bossName] then
		return false
	end

	if not boss
		or not boss.Parent then

		return false
	end

	if crowHandledBosses[boss] then
		return false
	end

	crowHandledBosses[boss] =
		true

	task.wait(
		CROW_PRE_OPEN_DELAY
	)

	if not Runtime.alive
		or not farmEnabled
		or not isPlayerAlive() then

		return false
	end

	if not boss.Parent then
		return false
	end

	if not setEquippedSlot(4) then
		closeCrowQuestAndRestoreTool()
		return false
	end

	local holder =
		waitForCrowQuestHolder()

	if not holder then

		closeCrowQuestAndRestoreTool()

		return false
	end


	local matchedQuest =
		findCrowQuestForBoss(
			holder,
			bossName
		)

	local claimed =
		false

	if matchedQuest then

		claimed =
			claimCrowQuest(
				matchedQuest.id
			)

		task.wait(0.10)
	end

	closeCrowQuestAndRestoreTool()

	return claimed
end


local function processBoss(bossName)
	if deliveryBusy then
		return "paused"
	end

	MultiFarm.setStatus(
		"Traveling",
		bossName
	)

	lastBossIndex = currentBossIndex

	local boss = getLiveBoss(bossName)

	if boss
		and MultiFarm.RespawnRecoveryPending
		and MultiFarm.RespawnBossName == bossName then

		MultiFarm.RespawnRecoveryPending =
			false

		MultiFarm.RespawnBossName =
			""

		MultiFarm.RespawnBossPosition =
			nil
	end

	if boss then

		local bossRoot =
			getBossRoot(
				boss
			)

		local bossPosition =
			bossRoot
			and bossRoot.Position
			or getBossCenter(
				bossName
			)

		if bossPosition then

			MultiFarm.RewardBusy =
				true

			pcall(function()
				collectNearbyWorldEventChest(
					bossPosition
				)
			end)

			MultiFarm.RewardBusy =
				false

			boss =
				getLiveBoss(
					bossName
				)
		end
	end

	if not boss then
		local center =
			getBossCenter(
				bossName
			)

		if not center
			and MultiFarm.RespawnRecoveryPending
			and MultiFarm.RespawnBossName == bossName then

			center =
				MultiFarm.RespawnBossPosition
		end

		if center then

			if not teleportToPosition(
				center
			) then

				return "player_died"
			end


			if MultiFarm.RespawnRecoveryPending
				and MultiFarm.RespawnBossName == bossName then

				task.wait(0.35)
			end


			MultiFarm.RewardBusy =
				true

			local chestOk,
				collectedChest =
				pcall(
					collectNearbyWorldEventChest,
					center
				)

			MultiFarm.RewardBusy =
				false

			if not chestOk then
				collectedChest =
					false
			end


			if collectedChest
				and Runtime.alive
				and farmEnabled
				and isPlayerAlive() then

				teleportToPosition(
					center
				)

				task.wait(0.03)
			end


			local timeoutAt =
				os.clock()
				+ SPAWN_CHECK_WAIT


			while Runtime.alive
				and farmEnabled
				and not deliveryBusy
				and os.clock() < timeoutAt do


				if not isPlayerAlive() then
					return "player_died"
				end


				boss =
					getLiveBoss(
						bossName
					)


				if boss then
					break
				end


				task.wait(
					BOSS_SPAWN_POLL_INTERVAL
				)
			end

		else

			if MultiFarm.RespawnRecoveryPending
				and MultiFarm.RespawnBossName == bossName then

				MultiFarm.RespawnRecoveryPending =
					false

				MultiFarm.RespawnBossName =
					""

				MultiFarm.RespawnBossPosition =
					nil
			end

			return "next"
		end


		if deliveryBusy then
			return "paused"
		end

		if not boss then

			if MultiFarm.RespawnRecoveryPending
				and MultiFarm.RespawnBossName == bossName then

				MultiFarm.RespawnRecoveryPending =
					false

				MultiFarm.RespawnBossName =
					""

				MultiFarm.RespawnBossPosition =
					nil
			end

			return "next"
		end

		if MultiFarm.RespawnRecoveryPending
			and MultiFarm.RespawnBossName == bossName then

			MultiFarm.RespawnRecoveryPending =
				false

			MultiFarm.RespawnBossName =
				""

			MultiFarm.RespawnBossPosition =
				nil
		end
	end

	if deliveryBusy then
		return "paused"
	end

	if boss
		and boss.Parent then

		if autoCrowQuestEnabled
			and not CROW_SKIP_BOSSES[
				bossName
			]
			and selectedBossSet[
				bossName
			] then

			MultiFarm.setStatus(
				"Crow Quest",
				bossName
			)
		end

		tryAutoCrowQuest(
			bossName,
			boss
		)

		if not Runtime.alive
			or not farmEnabled
			or deliveryBusy then

			return "paused"
		end


		if not isPlayerAlive() then
			return "player_died"
		end


		local refreshedBoss =
			getLiveBoss(
				bossName
			)

		if refreshedBoss then
			boss =
				refreshedBoss
		end
	end


	MultiFarm.setStatus(
		"Attacking",
		bossName
	)

	MultiFarm.notify(
		"found:" .. tostring(bossName),
		'Found "' .. tostring(bossName) .. '"'
	)

	MultiFarm.ActiveBossName =
		bossName

	local activeBossRoot =
		getBossRoot(
			boss
		)

	if activeBossRoot then
		MultiFarm.ActiveBossPosition =
			activeBossRoot.Position
	end

	local result, deathPosition =
		fightBoss(
			bossName,
			boss
		)

	if result == "player_died" then
		return "player_died"
	end

	if result == "paused" then
		return "paused"
	end

	if result == "boss_lost" then
		return "retry"
	end

if result == "boss_dead" then

		if MultiFarm.Online.Enabled then

			MultiFarm.Online.push(
				"BossDead",
				"BossDead",
				bossName,
				deathPosition,
				true
			)

			MultiFarm.Online.startCritical(
				3
			)
		end

		MultiFarm.RewardBusy =
			true

		local rewardOk,
			rewardError =
			pcall(
				handleBossRewards,
				deathPosition
			)

		MultiFarm.RewardBusy =
			false

		if not rewardOk then
			warn(
				"[Boss Reward] "
				.. tostring(
					rewardError
				)
			)
		end

		if MultiFarm.Online.Enabled
			and not MultiFarm.isFollower() then

			MultiFarm.Online.push(
				"RewardClaimed",
				"Resuming",
				bossName,
				deathPosition,
				true
			)
		end

		MultiFarm.ActiveBossName =
			""

		return "next"
	end

	MultiFarm.ActiveBossName =
		""

	return "next"
end


local SKILL_KEY_ORDER = {
	"Z",
	"X",
	"C",
	"V",
	"B"
}


local function keyNameToCode(name)
	if name == "Z" then
		return Enum.KeyCode.Z
	elseif name == "X" then
		return Enum.KeyCode.X
	elseif name == "C" then
		return Enum.KeyCode.C
	elseif name == "V" then
		return Enum.KeyCode.V
	elseif name == "B" then
		return Enum.KeyCode.B
	end

	return nil
end


local function applyAutoSkillSelection(valueTable)
	selectedAutoSkillKeys = {}

	if type(valueTable) ~= "table" then
		return
	end

	for _, keyName in ipairs(SKILL_KEY_ORDER) do
		if valueTable[keyName] then
			local keyCode = keyNameToCode(keyName)

			if keyCode then
				table.insert(
					selectedAutoSkillKeys,
					keyCode
				)
			end
		end
	end
end


local function applyHoldSkillSelection(valueTable)
	Runtime.AutoSkill.HoldKeys =
		{}

	if type(valueTable) ~= "table" then
		return
	end

	for _, keyName in ipairs(
		SKILL_KEY_ORDER
	) do

		if valueTable[keyName] then

			local keyCode =
				keyNameToCode(
					keyName
				)

			if keyCode then

				Runtime.AutoSkill.HoldKeys[
					keyCode
				] = true
			end
		end
	end
end


local function applyClanSkillSelection(valueTable)
	if updatingClanDropdown then
		return
	end

	if type(valueTable) ~= "table" then
		selectedClanSkillName = nil
		selectedClanSkillKey = nil
		return
	end


	local selectedNames = {}

	for _, keyName in ipairs({
		"Z",
		"X",
		"C"
	}) do

		if valueTable[keyName] then
			table.insert(
				selectedNames,
				keyName
			)
		end
	end


	if #selectedNames == 0 then

		selectedClanSkillName = nil
		selectedClanSkillKey = nil

		return
	end


	local chosenName = nil


	if #selectedNames == 1 then

		chosenName =
			selectedNames[1]

	else

		for _, keyName in ipairs(
			selectedNames
		) do

			if keyName
				~= selectedClanSkillName then

				chosenName =
					keyName

				break
			end
		end


		chosenName =
			chosenName
			or selectedNames[
				#selectedNames
			]
	end


	selectedClanSkillName =
		chosenName

	selectedClanSkillKey =
		keyNameToCode(
			chosenName
		)


	if #selectedNames > 1
		and clanSkillDropdown
		and clanSkillDropdown.SetValue then

		updatingClanDropdown =
			true

		clanSkillDropdown:SetValue({
			[chosenName] = true
		})

		updatingClanDropdown =
			false
	end
end


local function applyBossSelection(valueTable)
	local newSet = {}

	if type(valueTable) == "table" then
		for bossName, state in pairs(valueTable) do
			if state then
				newSet[tostring(bossName)] = true
			end
		end
	end

	local newOrder = {}

	for _, bossName in ipairs(selectedBossOrder) do
		if newSet[bossName] then
			table.insert(newOrder, bossName)
			newSet[bossName] = "kept"
		end
	end

	for _, bossName in ipairs(getActiveNpcNames()) do
		if newSet[bossName] == true then
			table.insert(newOrder, bossName)
