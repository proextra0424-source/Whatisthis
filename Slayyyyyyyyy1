            local function AutoBRPunch(state)
                AutoBRPunch_RunId = AutoBRPunch_RunId + 1
                AutoBRPunch_Active = state
                local runId = AutoBRPunch_RunId

                if not state then
                    hasTeleportedBRPunch = false
