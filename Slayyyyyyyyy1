task.spawn(function()

	while Runtime.alive do

		if deliveryBusy then
			task.wait(0.05)
			continue
		end

		if not farmEnabled then
			task.wait(0.1)
			continue
		end


		local character =
			waitForCharacterReady()

		if not Runtime.alive then
			break
		end

		if not character then
			task.wait(0.1)
			continue
		end


		local bossRoute =
			getBossRoute()


		if #bossRoute == 0 then
			task.wait(0.1)
			continue
		end


		if currentBossIndex
			> #bossRoute then

			currentBossIndex = 1
		end


		local bossName =
			bossRoute[
				currentBossIndex
			]

		local syncedBoss,
			waitForLeader =
			MultiFarm.resolveBoss(
				bossName
			)

		local leader =
			MultiFarm.getLeader()

		if leader then

			local leaderState =
				tostring(
					leader.state or ""
				)

			if leaderState == "Open Chest"
				or leaderState == "Picking Loot" then

				if MultiFarm.collectFollowerLoot(
					LOOT_FIRST_SPAWN_TIMEOUT
				) then

					task.wait(0.05)
					continue
				end
			end
		end

		if waitForLeader then

			MultiFarm.setStatus(
				"Waiting Sync",
				""
			)

			task.wait(0.10)
			continue
		end

		bossName =
			syncedBoss
			or bossName


		bossProcessBusy =
			true

		local result =
			processBoss(
				bossName
			)

		bossProcessBusy =
			false


		if not Runtime.alive then
			break
		end


		if result == "next" then

			currentBossIndex += 1


			bossRoute =
				getBossRoute()


			if currentBossIndex
				> #bossRoute then

				currentBossIndex = 1
			end


		elseif result
			== "retry" then

			task.wait(0.25)


		elseif result
			== "player_died" then

			MultiFarm.setStatus(
				"Respawning",
				bossName
			)

			currentBossIndex =
				lastBossIndex


			while Runtime.alive
				and farmEnabled
				and not isPlayerAlive() do

				task.wait(0.1)
			end


			if Runtime.alive
				and farmEnabled then

				task.wait(0.35)

				ensureToolOneReady(
					TOOL_READY_TIMEOUT
				)
			end


		elseif result
			== "paused" then

			task.wait(0.1)

		else

			task.wait(0.05)
		end
	end


	bossProcessBusy =
		false

	if ENV[RUNTIME_KEY]
		== Runtime then

		ENV[RUNTIME_KEY] = nil
	end
end)
