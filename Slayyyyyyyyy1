local function SimpleAutoPlayer()
    while AutoPlayer_Active and selectedPlayer do
        local target = workspace.Game.Players:FindFirstChild(selectedPlayer)
        local character = LocalPlayer.Character
        
        if target and character and character:FindFirstChild("HumanoidRootPart") then
            local humanoid = target:FindFirstChild("Humanoid")
            local rootPart = target:FindFirstChild("HumanoidRootPart")
            
            if humanoid and rootPart and humanoid.Health > 0 then
                character.HumanoidRootPart.CFrame = rootPart.CFrame * CFrame.new(0, 0, 5)
                
                local args = {
                    "Light Punchy",
                    AutoPlayer_countpunch,
                    humanoid,
                    [6] = false,
                    [7] = false
                }
                
                game:GetService("ReplicatedStorage").Remotes.ClientToServer.BasicCombat:FireServer(unpack(args))
                
                AutoPlayer_countpunch = AutoPlayer_countpunch + 1
                if AutoPlayer_countpunch > 5 then
                    AutoPlayer_countpunch = 1
                    wait(1.2)
                else
                    wait(AutoPlayer_Speed)
                end
            else
                AutoPlayer_countpunch = 1
                wait(1)
            end
        else
            AutoPlayer_countpunch = 1
            wait(1)
        end
    end
    
    AutoPlayer_countpunch = 1
end
 
spawn(function()
    while true do
        if AutoPlayer_Active and selectedPlayer then
            SimpleAutoPlayer()
        end
        wait(0.5)
