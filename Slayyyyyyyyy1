                                                    fireclickdetector(obj)
                                                    wait(1.5)
                                                    fireclickdetector(obj)
                                                    wait(1.5)
                                                    fireclickdetector(obj)
                                                end
                                            end)
                                        end
                                    end
                                end
                            end

                            if not interruptibleWait(5) then return end
                            if abortIfStopped() then return end


                            do
                                local maxWait = 165
                                local elapsed = 0
                                local step = 0.5
                                while elapsed < maxWait do
                                    if abortIfStopped() then return end
                                    local ok, hasWind = pcall(function()
                                        return workspace and workspace:FindFirstChild("Game")
                                            and workspace.Game:FindFirstChild("Effects")
                                            and workspace.Game.Effects:FindFirstChild("Wind")
                                    end)
                                    if ok and hasWind then
                                        wait(5)
                                        break
                                    end
                                    wait(step)
                                    elapsed = elapsed + step
                                end
                                if elapsed >= maxWait and not (ok and hasWind) then
                                    -- do nothing
                                end
                            end
        
                            do
                                local boat, destPart = getIslandBoatAndDest()
                                if boat and destPart then
                                    character, hrp = waitForHRP()
                                    if abortIfStopped() then return end
                                    if hrp then hrp.CFrame = destPart.CFrame + Vector3.new(0, 3, 0) end
                                    if not interruptibleWait(1) then return end
                                    if abortIfStopped() then return end
                                    for _, obj in pairs(boat:GetDescendants()) do
                                        if abortIfStopped() then return end
                                        if obj:IsA("ClickDetector") then
                                            pcall(function()
                                                if fireclickdetector then
                                                    fireclickdetector(obj)
                                                    wait(1.5)
                                                    fireclickdetector(obj)
                                                    wait(1.5)
                                                    fireclickdetector(obj)
                                                    wait(2)
                                                    fireclickdetector(obj)
                                                end
                                            end)
                                        end
                                    end
                                end
                            end
                        end
                        wait(5)
                    end
                end

                if AutoIsland_Active and AutoIsland_RunId == runId then
                    hasTeleportedIsland = false
                    spawn(CheckAndRestartIsland)
                end
            end

            -- The normal route owns one cancellable worker, including its delayed start request.
            local AutoBR_Active = false
            local AutoBR_RunId = 0
            local AutoBR_Task
            
            local function AutoBR(state)
                AutoBR_RunId = AutoBR_RunId + 1
                AutoBR_Active = state == true
                local runId = AutoBR_RunId
                local previous = AutoBR_Task
                AutoBR_Task = nil
                if previous and previous ~= coroutine.running() then pcall(task.cancel, previous) end
                if not AutoBR_Active then return end
            
                AutoBR_Task = task.spawn(function()
                    local teleportedCharacter
                    local function running() return AutoBR_Active and AutoBR_RunId == runId end
                    while running() do
                        if not workspace:FindFirstChild("Spire") then
                            local character = LocalPlayer.Character
                            local root = character and character:FindFirstChild("HumanoidRootPart")
                            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                            local spireBox = workspace:FindFirstChild("SpireBox")
                            if root and humanoid and humanoid.Health > 0 and spireBox then
                                if teleportedCharacter ~= character then
                                    root.CFrame = CFrame.new(1, 3012, 605)
                                    teleportedCharacter = character
                                end
                                task.wait(1)
                                if running() and LocalPlayer.Character == character and root.Parent
                                    and character:FindFirstChild("HumanoidRootPart") == root
                                    and humanoid.Health > 0 and workspace:FindFirstChild("SpireBox") == spireBox
                                    and not workspace:FindFirstChild("Spire") then
                                    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                                    local clientToServer = remotes and remotes:FindFirstChild("ClientToServer")
                                    local remote = clientToServer and clientToServer:FindFirstChild("BossStart")
                                    if remote then
                                        local ok, err = pcall(function() remote:FireServer("Spire", "Spire", spireBox) end)
                                        if not ok then warn("Auto Boss Rush: " .. tostring(err)) end
                                    end
                                end
                            end
                        end
                        if not running() then break end
                        task.wait(5)
                    end
                    if AutoBR_RunId == runId then AutoBR_Task = nil end
                end)
            end
            
            
            local AutoBRPunch_Active = false
            local AutoBRPunch_RunId = 0
            local hasTeleportedBRPunch = false

            local function AutoBRPunch(state)
                AutoBRPunch_RunId = AutoBRPunch_RunId + 1
                AutoBRPunch_Active = state
                local runId = AutoBRPunch_RunId

                if not state then
                    hasTeleportedBRPunch = false
                    return
                end

                hasTeleportedBRPunch = false
                local punchCounter = 1

                local function isValidEnemyModel(model)
                    if not model or not model:IsA("Model") or model == LocalPlayer.Character then
                        return false
                    end
                    if Players:GetPlayerFromCharacter(model) then
                        return false
                    end
                    local humanoid = model:FindFirstChildOfClass("Humanoid")
                        or model:FindFirstChild("Humanoid", true)
                    local rootPart = model:FindFirstChild("HumanoidRootPart", true)
                    return humanoid and rootPart and humanoid.Health > 0
                end

                local function findNearestEnemy()
                    local character = LocalPlayer.Character
                    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                    local npcFolder = workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Players")
                    if not rootPart or not npcFolder then
                        return nil, nil
                    end

                    local nearestModel, nearestHumanoid
                    local nearestDistance = 100
                    local candidateModels = {}
                    for _, object in ipairs(npcFolder:GetDescendants()) do
                        if object:IsA("Model") then
                            candidateModels[object] = true
                        end
                    end

                    for model in pairs(candidateModels) do
                        if isValidEnemyModel(model) then
                            local humanoid = model:FindFirstChildOfClass("Humanoid")
                                or model:FindFirstChild("Humanoid", true)
                            local targetRoot = model:FindFirstChild("HumanoidRootPart", true)
                            local distance = (targetRoot.Position - rootPart.Position).Magnitude
                            if distance <= nearestDistance then
                                nearestDistance = distance
                                nearestModel = model
                                nearestHumanoid = humanoid
                            end
                        end
                    end

                    return nearestModel, nearestHumanoid
                end

                local function firePunchBurst(targetHumanoid)
                    local combatRemote = ReplicatedStorage.Remotes.ClientToServer.BasicCombat
                    local args = {
                        [1] = "Light Punchy",
                        [2] = punchCounter,
                        [3] = targetHumanoid,
                        [6] = false,
                        [7] = false
                    }

                    for _ = 1, 5 do
                        if not AutoBRPunch_Active or AutoBRPunch_RunId ~= runId then
                            return false
                        end
                        combatRemote:FireServer(unpack(args))
                    end

                    punchCounter = punchCounter + 1
                    if punchCounter > 5 then
                        punchCounter = 1
                        wait(1.2)
                    else
                        wait(0.01)
                    end
                    return true
                end

                local function punchTarget(targetModel, targetHumanoid)
                    local hoverAttachment
                    local alignPosition
                    local updateConnection

                    local function cleanupHover()
                        if updateConnection then
                            updateConnection:Disconnect()
                            updateConnection = nil
                        end
                        if alignPosition then
                            alignPosition:Destroy()
                            alignPosition = nil
                        end
                        if hoverAttachment then
                            hoverAttachment:Destroy()
                            hoverAttachment = nil
                        end
                    end

                    local character = LocalPlayer.Character
                    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                    local targetRoot = targetModel and targetModel:FindFirstChild("HumanoidRootPart", true)
                    if not rootPart or not targetRoot then
                        return
                    end

                    -- Keep the player floating 10 studs above the target without Anchored.
                    hoverAttachment = Instance.new("Attachment")
                    hoverAttachment.Parent = rootPart
                    alignPosition = Instance.new("AlignPosition")
                    alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
                    alignPosition.Attachment0 = hoverAttachment
                    alignPosition.MaxForce = math.huge
                    alignPosition.MaxVelocity = math.huge
                    alignPosition.Responsiveness = 200
                    alignPosition.RigidityEnabled = true
                    local hoverPosition = targetRoot.Position + Vector3.new(0, 10, 0)
                    rootPart.CFrame = CFrame.new(hoverPosition, targetRoot.Position)
                    alignPosition.Position = hoverPosition
                    alignPosition.Parent = rootPart

                    updateConnection = RunService.Heartbeat:Connect(function()
                        if targetRoot and targetRoot.Parent and rootPart and rootPart.Parent then
                            alignPosition.Position = targetRoot.Position + Vector3.new(0, 10, 0)
                        end
                    end)

                    -- Do not start punching until the player has actually reached the hover point.
                    local reachDeadline = tick() + 3
                    while AutoBRPunch_Active and AutoBRPunch_RunId == runId
                        and targetRoot.Parent and rootPart.Parent do
                        hoverPosition = targetRoot.Position + Vector3.new(0, 10, 0)
                        alignPosition.Position = hoverPosition
                        if (rootPart.Position - hoverPosition).Magnitude <= 2 then
                            break
                        end
                        if tick() >= reachDeadline then
                            rootPart.CFrame = CFrame.new(hoverPosition, targetRoot.Position)
                            break
                        end
                        RunService.Heartbeat:Wait()
                    end

                    while AutoBRPunch_Active and AutoBRPunch_RunId == runId
                        and targetModel.Parent and targetHumanoid.Parent
                        and targetHumanoid.Health > 0
                        and targetRoot.Parent and rootPart.Parent do
                        local distance = (targetRoot.Position - rootPart.Position).Magnitude
                        if distance > 100 then
                            break
                        end
                        if not firePunchBurst(targetHumanoid) then
                            break
                        end
                    end

                    cleanupHover()
                end

                local function startPunchBossRush()
                    if not AutoBRPunch_Active or AutoBRPunch_RunId ~= runId then
                        return false
                    end

                    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                    local spireBox = workspace:FindFirstChild("SpireBox")
                    if not spireBox or not character:FindFirstChild("HumanoidRootPart") then
                        return false
                    end

                    if not hasTeleportedBRPunch then
                        character.HumanoidRootPart.CFrame = CFrame.new(1, 3012, 605)
                        hasTeleportedBRPunch = true
                    end

                    local args = {
                        [1] = "Spire",
                        [2] = "Spire",
                        [3] = spireBox
                    }
                    wait(1)
                    if not AutoBRPunch_Active or AutoBRPunch_RunId ~= runId then
                        return false
                    end
                    ReplicatedStorage.Remotes.ClientToServer.BossStart:FireServer(unpack(args))

                    -- The Boss Rush arena needs time to load before target scanning begins.
                    for _ = 1, 350 do
                        if not AutoBRPunch_Active or AutoBRPunch_RunId ~= runId then
                            return false
                        end
                        wait(0.1)
                    end
                    return true
                end

                spawn(function()
                    local roundReady = false
                    local noTargetSince = nil
                    while AutoBRPunch_Active and AutoBRPunch_RunId == runId do
                        if not roundReady then
                            if not workspace:FindFirstChild("Spire") then
                                roundReady = startPunchBossRush()
                                noTargetSince = nil
                            else
                                wait(1)
                            end
                        end

                        if roundReady then
                            local targetModel, targetHumanoid = findNearestEnemy()
                            if targetModel and targetHumanoid then
                                noTargetSince = nil
                                punchTarget(targetModel, targetHumanoid)
                            else
                                -- Keep scanning during the short gap between Boss Rush mobs.
                                -- Only restart after the arena marker is gone and no target has
                                -- appeared for 10 seconds, preventing another 40-second wait
                                -- between consecutive mobs in the same run.
                                noTargetSince = noTargetSince or tick()
                                if not workspace:FindFirstChild("Spire")
                                    and tick() - noTargetSince >= 10 then
                                    roundReady = false
                                    noTargetSince = nil
                                else
                                    wait(0.5)
                                end
                            end
                        end
                    end
                end)
            end

            local AutoBRExtreme_RunId = 0
            local hasTeleportedExtreme = false
            local mortarMarkerColor = Color3.fromRGB(0, 200, 255)

            local function getExtremeMortarMarker()
                local gameFolder = workspace:FindFirstChild("Game")
                local effects = gameFolder and gameFolder:FindFirstChild("Effects")
                local marker = effects and effects:FindFirstChild("mortar_marker")
                if not marker then
                    return nil, nil
                end

                if marker:IsA("BasePart") and marker.Color == mortarMarkerColor then
                    return marker, marker
                end

                for _, object in ipairs(marker:GetDescendants()) do
                    if object:IsA("BasePart") and object.Color == mortarMarkerColor then
                        return marker, object
                    end
                end

                return nil, nil
            end

            local function hasShadowmansGift()
                local character = LocalPlayer.Character
                local backpack = LocalPlayer:FindFirstChild("Backpack")

                return (character and character:FindFirstChild("Shadowman's Gift") ~= nil)
                    or (backpack and backpack:FindFirstChild("Shadowman's Gift") ~= nil)
