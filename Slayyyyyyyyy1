		pcall(function()
			return textObject.Text
		end)

	if ok then
		return tostring(value)
	end

	return nil
end


function Delivery.isDeliveryHalfComplete()
	local value =
		Delivery.getDeliveryProgressText()

	if not value then
		return false
	end

	if value
		== DELIVERY_PROGRESS_TEXT then

		return true
	end

	local normalized =
		string.gsub(
			value,
			"%s+",
			" "
		)

	normalized =
		string.match(
			normalized,
			"^%s*(.-)%s*$"
		)
		or normalized

	return normalized
		== "Deliver Niko's Supply Box 1/2"
end


function Delivery.deliveryCanContinue()
	return Runtime.alive
		and autoDeliveryEnabled
		and deliveryBusy
end


function Delivery.waitForDeliveryQuestAccepted()
	local timeoutAt =
		os.clock()
		+ DELIVERY_STEP_TIMEOUT

	while Delivery.deliveryCanContinue()
		and os.clock() < timeoutAt do

		local frame =
			Delivery.getDeliveryQuestFrame()

		if frame
			and frame.Parent then

			return frame
		end


		Delivery.fireDeliveryRemote(
			"AddQuest",
			DELIVERY_QUEST_NAME
		)


		local retryAt =
			os.clock()
			+ DELIVERY_REMOTE_RETRY_INTERVAL

		while Delivery.deliveryCanContinue()
			and os.clock() < retryAt do

			frame =
				Delivery.getDeliveryQuestFrame()

			if frame
				and frame.Parent then

				return frame
			end

			task.wait(0.03)
		end
	end

	return nil
end


function Delivery.waitForShioriProgress()
	local timeoutAt =
		os.clock()
		+ DELIVERY_STEP_TIMEOUT

	while Delivery.deliveryCanContinue()
		and os.clock() < timeoutAt do

		local frame =
			Delivery.getDeliveryQuestFrame()

		if not frame
			or not frame.Parent then

			return false
		end


		if Delivery.isDeliveryHalfComplete() then
			return true
		end


		Delivery.fireDeliveryRemote(
			"QuestProgress",
			DELIVERY_QUEST_NAME,
			"Deliver to Shiori"
		)


		local retryAt =
			os.clock()
			+ DELIVERY_REMOTE_RETRY_INTERVAL

		while Delivery.deliveryCanContinue()
			and os.clock() < retryAt do

			if Delivery.isDeliveryHalfComplete() then
				return true
			end

			if not Delivery.getDeliveryQuestFrame() then
				return false
			end

			task.wait(0.03)
		end
	end

	return false
end


function Delivery.waitForDeliveryQuestFinished()
	local timeoutAt =
		os.clock()
		+ DELIVERY_STEP_TIMEOUT

	while Delivery.deliveryCanContinue()
		and os.clock() < timeoutAt do

		local frame =
			Delivery.getDeliveryQuestFrame()

		if not frame
			or not frame.Parent then

			return true
		end


		Delivery.fireDeliveryRemote(
			"QuestProgress",
			DELIVERY_QUEST_NAME,
			"Report back to Niko"
		)


		local retryAt =
			os.clock()
			+ DELIVERY_REMOTE_RETRY_INTERVAL

		while Delivery.deliveryCanContinue()
			and os.clock() < retryAt do

			frame =
				Delivery.getDeliveryQuestFrame()

			if not frame
				or not frame.Parent then

				return true
			end

			task.wait(0.03)
		end
	end

	return false
end


function Delivery.runAutoDeliveryQuest()
	if not Runtime.alive
		or not autoDeliveryEnabled
		or deliveryBusy
		or MultiFarm.RewardBusy
		or MultiFarm.LootBusy
		or os.clock()
			< MultiFarm.ResumeFarmUntil then

		return false
	end

	if Delivery.hasActiveCrowQuest() then
		return false
	end

	if farmEnabled
		and bossProcessBusy
		and MultiFarm.ActiveBossName ~= "" then

		MultiFarm.PendingRewardCheck =
			true

		MultiFarm.PendingRewardName =
			MultiFarm.ActiveBossName

		MultiFarm.PendingRewardPosition =
			MultiFarm.ActiveBossPosition
	end

	deliveryBusy =
		true

	MultiFarm.setStatus(
		"Delivery",
		""
	)

	Delivery.cleanupMovement()

	local recoveryDeadline =
		os.clock()
		+ DELIVERY_RECOVERY_TIMEOUT

	local success =
		false

	local hadQuest =
		Delivery.getDeliveryQuestFrame()
			~= nil

	local ok =
		pcall(function()

			while Delivery.deliveryCanContinue()
				and os.clock()
					< recoveryDeadline do

				if Delivery.hasActiveCrowQuest() then
					break
				end

				local questFrame =
					Delivery.getDeliveryQuestFrame()

				if not questFrame then

					if hadQuest then

						success =
							true

						break
					end


					local niko =
						Delivery.getOrRenderNiko()

					if not niko then
						Delivery.cleanupMovement()
						task.wait(0.10)
						continue
					end


					if not Delivery.followNikoClose(
						niko
					) then

						Delivery.cleanupMovement()
						task.wait(0.10)
						continue
					end


					local accepted =
						Delivery.waitForDeliveryQuestAccepted()

					Delivery.cleanupMovement()


					if accepted then
						hadQuest =
							true
					end


					task.wait(0.05)
					continue
				end


				hadQuest =
					true


				if Delivery.isDeliveryHalfComplete() then

					if not Delivery.teleportDelivery(
						DELIVERY_RENDER_NIKO
					) then

						Delivery.cleanupMovement()
						task.wait(0.10)
						continue
					end


					local niko =
						Delivery.waitForNiko()

					if not niko then
						Delivery.cleanupMovement()
						task.wait(0.10)
						continue
					end


					if not Delivery.followNikoClose(
						niko
					) then

						Delivery.cleanupMovement()
						task.wait(0.10)
						continue
					end


					local finished =
						Delivery.waitForDeliveryQuestFinished()

					Delivery.cleanupMovement()


					if finished
						or not Delivery.getDeliveryQuestFrame() then

						success =
							true

						break
					end


					task.wait(0.05)
					continue
				end


				Delivery.cleanupMovement()


				if not Delivery.teleportDelivery(
					DELIVERY_SHIORI_POSITION
				) then

					task.wait(0.10)
					continue
				end


				local shioriWaitUntil =
					os.clock()
					+ DELIVERY_SHIORI_WAIT

				while Delivery.deliveryCanContinue()
					and os.clock()
						< shioriWaitUntil do

					task.wait(0.02)
				end


				if not Delivery.deliveryCanContinue() then
					break
				end


				Delivery.waitForShioriProgress()

				Delivery.cleanupMovement()

				task.wait(0.05)
			end
		end)


	Delivery.cleanupMovement()

	deliveryBusy =
		false

	MultiFarm.ResumeFarmUntil =
		os.clock()
		+ 1.5


	if MultiFarm.isFollower() then

		local leader =
			MultiFarm.getLeader()

		if leader then

			local leaderBoss =
				tostring(
					leader.boss or ""
				)

			if leaderBoss ~= "" then

				MultiFarm.CatchUpRequested =
					true

				MultiFarm.setStatus(
					"Catching Up",
					leaderBoss
				)
			else

				MultiFarm.setStatus(
					"Waiting Sync",
					MultiFarm.Boss
				)
			end

		else

			MultiFarm.setStatus(
				"Waiting Sync",
				MultiFarm.Boss
			)
		end

	elseif farmEnabled then

		MultiFarm.setStatus(
			"Resuming",
			MultiFarm.ActiveBossName
		)

	else

		MultiFarm.setStatus(
			"Idle",
			""
		)
	end


	if farmEnabled then
		setEquippedToOne()
	end

	if MultiFarm.Online.Enabled then

		task.spawn(function()

			MultiFarm.Online.push(
				"DeliveryFinished",
				MultiFarm.State,
				MultiFarm.Boss,
				MultiFarm.ActiveBossPosition,
				true
			)

		end)
	end


	if not ok then
		return false
	end

	return success
end


function Delivery.setAutoDeliveryEnabled(state)
	autoDeliveryEnabled =
		state == true

	if autoDeliveryEnabled then

		nextDeliveryAt =
			0

	else

		if deliveryBusy then
			Delivery.cleanupMovement()
		end

		MultiFarm.CatchUpRequested =
			false
	end
end

local function findFluentGuiRoot()
	if fluentGuiRoot
		and fluentGuiRoot.Parent then

		return fluentGuiRoot
	end

	local now = os.clock()

	if now - lastUiRootSearch < 0.75 then
		return nil
	end

	lastUiRootSearch = now

	local containers = {}

	if typeof(gethui) == "function" then
		local ok, hui = pcall(gethui)

		if ok and hui then
			table.insert(containers, hui)
		end
	end

	pcall(function()
		table.insert(
			containers,
			game:GetService("CoreGui")
		)
	end)

	local playerGui =
		LocalPlayer:FindFirstChild(
			"PlayerGui"
		)

	if playerGui then
		table.insert(
			containers,
			playerGui
		)
	end

	for _, container in ipairs(containers) do
		for _, object in ipairs(
			container:GetDescendants()
		) do
			if object:IsA("TextLabel")
				or object:IsA("TextButton") then

				local value =
					tostring(object.Text)

				if string.find(
					value,
					"Slayer 2 Script By Sigma",
					1,
					true
				) then

					local screenGui =
						object:FindFirstAncestorOfClass(
							"ScreenGui"
						)

					if screenGui then
						fluentGuiRoot =
							screenGui

						return screenGui
					end
				end
			end
		end
	end

	return nil
end


local function guiObjectVisible(object, root)
	if not object.Visible then
		return false
	end

	local parent = object.Parent

	while parent
		and parent ~= root do

		if parent:IsA("GuiObject")
			and not parent.Visible then

			return false
		end

		parent = parent.Parent
	end

	if root:IsA("ScreenGui")
		and not root.Enabled then

		return false
	end

	return true
end


local function pointInsideGuiObject(object, point)
	local position =
		object.AbsolutePosition

	local size =
		object.AbsoluteSize

	return
		point.X >= position.X
		and point.X <= position.X + size.X
		and point.Y >= position.Y
		and point.Y <= position.Y + size.Y
end


local function mouseOverFluentControl()
	local root =
		findFluentGuiRoot()

	local mousePosition =
		UserInputService:GetMouseLocation()

	if mobileToggleButton
		and mobileToggleButton.Parent
		and mobileToggleButton.Visible then

		if pointInsideGuiObject(
			mobileToggleButton,
			mousePosition
		) then

			return true
		end
	end

	if not root then
		local moved =
			(mousePosition - fallbackMousePosition).Magnitude

		fallbackMousePosition =
			mousePosition

		if moved > 1 then
			fallbackPauseUntil =
				os.clock() + 0.35
		end

		return
			os.clock()
			< fallbackPauseUntil
	end

	local topLeftInset =
		select(
			1,
			GuiService:GetGuiInset()
		)

	local adjustedPosition =
		mousePosition
		- topLeftInset

	for _, object in ipairs(
		root:GetDescendants()
	) do
		if (
			object:IsA("GuiButton")
			or object:IsA("TextBox")
			or object:IsA("ScrollingFrame")
		)
			and guiObjectVisible(
				object,
				root
			) then

			if pointInsideGuiObject(
				object,
				mousePosition
			)
				or pointInsideGuiObject(
					object,
					adjustedPosition
				) then

				return true
			end
		end
	end

	return false
end


local function pressKey(keyCode, holdTime)
	if inputBusy then
		return false
	end

	inputBusy =
		true

	holdTime =
		tonumber(holdTime)
		or KEY_HOLD_TIME

	if holdTime < KEY_HOLD_TIME then

		holdTime =
			KEY_HOLD_TIME
	end

	local ok =
		pcall(function()

			VirtualInputManager:SendKeyEvent(
				true,
				keyCode,
				false,
				game
			)

			local releaseAt =
				os.clock()
				+ holdTime

			while os.clock()
				< releaseAt do

				if not Runtime.alive
					or not farmEnabled
					or deliveryBusy then

					break
				end

				task.wait(
					math.min(
						0.03,
						math.max(
							0,
							releaseAt
								- os.clock()
						)
					)
				)
			end
		end)

	pcall(function()

		VirtualInputManager:SendKeyEvent(
			false,
			keyCode,
			false,
			game
		)

	end)

	inputBusy =
		false

	return ok
end

local function useAutoSkill()
	if #selectedAutoSkillKeys == 0 then
		return false
	end

	if clanSkillBusy
		or Runtime.AutoSkill.Busy then

		return false
	end

	Runtime.AutoSkill.Busy =
		true

	task.spawn(function()

		for _, keyCode in ipairs(
			selectedAutoSkillKeys
		) do

			if not Runtime.alive
				or not farmEnabled
				or deliveryBusy
				or clanSkillBusy then

				break
			end

			local holdTime =
				KEY_HOLD_TIME

			if Runtime.AutoSkill.HoldKeys[
				keyCode
			] then

				holdTime =
					Runtime.AutoSkill.HoldTime
			end

			pressKey(
				keyCode,
				holdTime
			)

			task.wait(0.03)
		end

		Runtime.AutoSkill.Busy =
			false
	end)

	return true
end

local function useClanSkill()
	if not selectedClanSkillKey then
		return false
	end

	if clanSkillBusy then
		return false
	end


	clanSkillBusy = true

	if not setEquippedSlot(2) then
		clanSkillBusy = false
		return false
	end


	local endTime =
		os.clock()
		+ CLAN_TOOL_DURATION


	while Runtime.alive
		and farmEnabled
		and os.clock() < endTime do

		pressKey(
			selectedClanSkillKey
		)

		task.wait(
			CLAN_SKILL_SPAM_INTERVAL
		)
	end


	setEquippedSlot(1)

	clanSkillBusy = false

	return true
end


local function hasInteractiveAncestor(object)
	local current = object

	while current
		and current ~= game do

		if current:IsA("GuiButton")
			or current:IsA("TextBox")
			or current:IsA("ScrollingFrame") then

			return true
		end

		if current:IsA("GuiObject")
			and current.Active then

			return true
		end

		current = current.Parent
	end

	return false
end


local function getGuiObjectsAtMouse(container, x, y)
	if not container then
		return {}
	end

	local ok, objects =
		pcall(function()
			return container:GetGuiObjectsAtPosition(
				x,
				y
			)
		end)

	if ok and type(objects) == "table" then
		return objects
	end

	return {}
end


local function positionOverInteractiveGui(position)
	if not position then
		return false
	end

	local x =
		position.X

	local y =
		position.Y

	local playerGui =
		LocalPlayer:FindFirstChild(
			"PlayerGui"
		)

	for _, object in ipairs(
		getGuiObjectsAtMouse(
			playerGui,
			x,
			y
		)
	) do

		if hasInteractiveAncestor(
			object
		) then

			return true
		end
	end

	local ok, coreGui =
		pcall(function()
			return game:GetService(
				"CoreGui"
			)
		end)

	if ok and coreGui then

		for _, object in ipairs(
			getGuiObjectsAtMouse(
				coreGui,
				x,
				y
			)
		) do

			if hasInteractiveAncestor(
				object
			) then

				return true
			end
		end
	end

	return false
end




runtimeConnect(
	UserInputService.InputBegan,
	function(input, gameProcessed)

		if sendingSyntheticMouse then
			return
		end


		if input.UserInputType
			== Enum.UserInputType.MouseButton1 then

			local position =
				UserInputService:
					GetMouseLocation()

			if positionOverInteractiveGui(
				position
			) then

				realUiInputActive =
					true
			end


		elseif input.UserInputType
			== Enum.UserInputType.Touch then

			if positionOverInteractiveGui(
				input.Position
			) then

				activeUiTouchCount += 1
				realUiInputActive =
					true
			end
		end
	end
)


runtimeConnect(
	UserInputService.InputEnded,
	function(input)

		if sendingSyntheticMouse then
			return
		end


		if input.UserInputType
			== Enum.UserInputType.MouseButton1 then

			realUiInputActive =
				false


		elseif input.UserInputType
			== Enum.UserInputType.Touch then

			if activeUiTouchCount > 0 then
				activeUiTouchCount -= 1
			end

			if activeUiTouchCount <= 0 then

				activeUiTouchCount = 0
				realUiInputActive =
					false
			end
		end
	end
)


