        local function checkOtherPlayers()
            local players = game:GetService("Players"):GetPlayers()
            local otherPlayers = {}
            
            for _, plr in ipairs(players) do
                if plr ~= LocalPlayer then
                    table.insert(otherPlayers, {
                        Name = plr.Name,
                        UserId = plr.UserId,
                        DisplayName = plr.DisplayName
                    })
                end
            end
            
            return otherPlayers
        end
        
