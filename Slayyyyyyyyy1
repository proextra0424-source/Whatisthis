local function getBossFolder(bossName)
	bossName =
		tostring(
			bossName or ""
		)

	local folder =
		Runtime.BossRegistry.Folders[
			bossName
		]

	if folder
		and folder.Parent then

		return folder
	end

	Runtime.BossRegistry.scan()

	folder =
		Runtime.BossRegistry.Folders[
			bossName
		]

	if folder
		and folder.Parent then

		return folder
	end

	return nil
end

local function getBossHumanoid(model)
	if not model then
