local function getResponsiveWindowSize()
	local camera =
		workspace.CurrentCamera

	local viewport =
		camera
		and camera.ViewportSize
		or Vector2.new(800, 600)

	local isMobile =
		UserInputService.TouchEnabled

	if not isMobile then
		return
			UDim2.fromOffset(580, 460),
			160,
			false
	end

	local width =
		math.max(
			280,
			math.min(
				520,
				viewport.X - 20
			)
		)

	local height =
		math.max(
			260,
			math.min(
				420,
				viewport.Y - 80
			)
		)

	return
		UDim2.fromOffset(
			math.floor(width),
			math.floor(height)
		),
		90,
		true
end


