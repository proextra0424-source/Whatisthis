local function GetWhitelistFromJSONBIN()
    local httpFunction = CheckHTTP()
    if not httpFunction then return nil end
    
    local success, response = pcall(function()
        return httpFunction({
            Url = whitelistUrl,
            Method = "GET",
            Headers = {
                ["X-Access-Key"] = BLAHHH
            }
        })
    end)
    
    if success and response.Success then
        local success2, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if success2 and data and data.record then
            local hwidList = {}
            

            if data.record.userCooldowns then
                for userId, userData in pairs(data.record.userCooldowns) do
                    if userData.newHWID then
                        table.insert(hwidList, userData.newHWID)
                    end
                end
                return hwidList
            end
            

            if data.record.whitelist and #data.record.whitelist > 0 then
                return data.record.whitelist
            end
        end
    end
    return nil
end

local function CheckWhitelist()
    local isValid, currentHWID = ValidateHWID()
    
    if not isValid then
        return false
    end
    
    local whitelistData = GetWhitelistFromJSONBIN()
    
    if whitelistData then
        local currentHWIDLower = currentHWID:gsub("%s+", ""):lower()
        
        for _, whitelistedHWID in ipairs(whitelistData) do
            local cleanHWID = tostring(whitelistedHWID):gsub("%s+", ""):lower()
            if cleanHWID == currentHWIDLower then
                return true
            end
        end
    end
    
    return false
end

