local function createFollowConstraints()
	local root = getCharacterRoot()
	if not root then
		return false
	end

	destroyFollow()

	followAttachment = Instance.new("Attachment")
	followAttachment.Name = "_BossFarmAttachment"
	followAttachment.Parent = root

	followPosition = Instance.new("AlignPosition")
	followPosition.Name = "_BossFarmPosition"
	followPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	followPosition.Attachment0 = followAttachment
	followPosition.MaxForce = math.huge
	followPosition.MaxVelocity = math.huge
	followPosition.Responsiveness = 200
	followPosition.RigidityEnabled = true
	followPosition.ApplyAtCenterOfMass = true
	followPosition.Parent = root

	followOrientation = Instance.new("AlignOrientation")
	followOrientation.Name = "_BossFarmOrientation"
	followOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	followOrientation.Attachment0 = followAttachment
	followOrientation.CFrame = CFrame.Angles(math.rad(-90), 0, 0)
	followOrientation.MaxTorque = math.huge
	followOrientation.Responsiveness = 200
	followOrientation.RigidityEnabled = true
	followOrientation.Parent = root

	return true
end


