local function FindNearestTarget()
    local localPlayer = game:GetService("Players").LocalPlayer
    local localCharacter = localPlayer.Character
    if not localCharacter then return nil end
    local localRoot = localCharacter:FindFirstChild("HumanoidRootPart")
    if not localRoot then return nil end
    
    local playersFolder = workspace:WaitForChild("Game"):WaitForChild("Players")
    local nearestTarget = nil
    local shortestDistance = math.huge
    
    for _, playerModel in ipairs(playersFolder:GetChildren()) do
        if playerModel:IsA("Model") and playerModel ~= localPlayer.Character then
            local humanoid = playerModel:FindFirstChild("Humanoid")
            local rootPart = playerModel:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and rootPart then
                local distance = (localRoot.Position - rootPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    nearestTarget = playerModel
                end
            end
        end
    end
    
    return nearestTarget
end

