local function setAntiAfk(state)
	antiAfkEnabled = state == true

	if not antiAfkEnabled then

		if antiAfkConnection then
			pcall(function()
				antiAfkConnection:Disconnect()
			end)

			antiAfkConnection = nil
		end

		for _, connection in ipairs(
			antiAfkDisabledConnections
		) do
			pcall(function()
				if connection.Enable then
					connection:Enable()
				elseif connection["Enable"] then
					connection["Enable"](connection)
				end
			end)
		end

		antiAfkDisabledConnections = {}

		return
	end

	local GC =
		getconnections
		or get_signal_cons

	if GC then

		local ok, connections =
			pcall(
				GC,
				LocalPlayer.Idled
			)

		if ok
			and type(connections) == "table" then

			for _, connection in pairs(
				connections
			) do

				if connection.Disable then

					local disabled =
						pcall(function()
							connection:Disable()
						end)

					if disabled then
						table.insert(
							antiAfkDisabledConnections,
							connection
						)
					end

				elseif connection["Disable"] then

					local disabled =
						pcall(
							connection["Disable"],
							connection
						)

					if disabled then
						table.insert(
							antiAfkDisabledConnections,
							connection
						)
					end

				elseif connection.Disconnect then

					pcall(function()
						connection:Disconnect()
					end)
				end
			end

			return
		end
	end

	local VirtualUser =
		game:GetService(
			"VirtualUser"
		)

	antiAfkConnection =
		LocalPlayer.Idled:Connect(
			function()

				if not antiAfkEnabled then
					return
				end

				pcall(function()
					VirtualUser:
						CaptureController()

					VirtualUser:
						ClickButton2(
							Vector2.new()
						)
				end)
			end
		)
end


