function MultiFarm.Online.playerAlive()
	local character =
		LocalPlayer.Character

	local humanoid =
		character
		and character:FindFirstChildOfClass(
			"Humanoid"
		)

	return humanoid ~= nil
		and humanoid.Health > 0
end


function MultiFarm.Online.positionToTable(position)
	if typeof(position) ~= "Vector3" then
		return nil
	end

	return {
		x = position.X,
		y = position.Y,
		z = position.Z
	}
end


function MultiFarm.Online.tableToPosition(value)
	if type(value) ~= "table" then
		return nil
	end

	local x = tonumber(value.x)
	local y = tonumber(value.y)
	local z = tonumber(value.z)

	if not x or not y or not z then
		return nil
	end

	return Vector3.new(x, y, z)
end


function MultiFarm.Online.call(method, path, body)
	if not MultiFarm.Online.Enabled then
		return nil
	end

	local now =
		os.clock()

	if MultiFarm.Online.RateLimited then

		if now < (MultiFarm.Online.RetryAfter or 0) then
			return nil
		end

		MultiFarm.Online.RateLimited =
			false

		MultiFarm.Online.RetryAfter =
			0
	end

	if MultiFarm.Online.Secret == ""
		or MultiFarm.Online.Secret
			== "PUT_YOUR_SYNC_SECRET_HERE" then

		MultiFarm.Online.writeStatus(
			"ONLINE SYNC ERROR: Set MultiFarm.Online.Secret first"
		)

		return nil
	end

	local req =
		MultiFarm.Online.getRequest()

	if typeof(req) ~= "function" then

		MultiFarm.Online.writeStatus(
			"ONLINE SYNC ERROR: request/http_request/syn.request not found"
		)

		return nil
	end

	local options = {
		Url =
			MultiFarm.Online.Base
			.. path
			.. "?room="
			.. game:GetService(
				"HttpService"
			):UrlEncode(
				MultiFarm.Online.Room
			),
		Method = method,
		Headers = {
			["X-Sync-Key"] =
				MultiFarm.Online.Secret
		}
	}

	if body then

		options.Headers[
			"Content-Type"
		] =
			"application/json"

		local encodedOk, encoded =
			pcall(function()

				return game:GetService(
					"HttpService"
				):JSONEncode(
					body
				)
			end)

		if not encodedOk then
			return nil
		end

		options.Body = encoded
	end

	local ok, response =
		pcall(
			req,
			options
		)

	if not ok
		or type(response)
			~= "table" then

		MultiFarm.Online.writeStatus(
			"ONLINE SYNC REQUEST ERROR: "
			.. tostring(response)
		)

		return nil
	end

	local status =
		tonumber(
			response.StatusCode
			or response.Status
		)

	if status ~= 200 then

		local responseBody =
			tostring(
				response.Body
					or response.body
					or ""
			)

		if status == 429
			or string.find(
				responseBody,
				"1027",
				1,
				true
			) then

			MultiFarm.Online.RateLimited =
				true

			MultiFarm.Online.RetryAfter =
				os.clock()
				+ MultiFarm.Online.BackoffSeconds

			MultiFarm.Online.CriticalUntil =
				0

			MultiFarm.Online.writeStatus(
				"ONLINE SYNC RATE LIMITED - retry in "
				.. tostring(
					MultiFarm.Online.BackoffSeconds
				)
				.. "s"
			)

			return nil
		end

		MultiFarm.Online.writeStatus(
			"ONLINE SYNC HTTP "
			.. tostring(status)
			.. ": "
			.. responseBody
		)

		return nil
	end

	return response
end


function MultiFarm.Online.push(
	eventName,
	state,
	bossName,
	position,
	force
)
	if not MultiFarm.Online.Enabled then
		return false
	end

	eventName =
		tostring(eventName or "")

	state =
		tostring(
			state
			or MultiFarm.State
			or ""
		)

	bossName =
		tostring(
			bossName
			or MultiFarm.Boss
			or ""
		)

	local signature =
		eventName
		.. "\0"
		.. state
		.. "\0"
		.. bossName

	if not force
		and signature
			== MultiFarm.Online.LastPushSignature then

		return true
	end

	local payload = {
		userId = LocalPlayer.UserId,
		placeId = game.PlaceId,
		jobId = game.JobId,
		role =
			MultiFarm.isFollower()
				and "Follower"
				or "Leader",
		event = eventName,
		state = state,
		boss = bossName,
		position =
			MultiFarm.Online.positionToTable(
				position
			),
		alive = MultiFarm.Online.playerAlive()
	}

	local response =
		MultiFarm.Online.call(
			"POST",
			"/push",
			payload
		)

	if not response then
		return false
	end

	MultiFarm.Online.LastPushSignature =
		signature

	MultiFarm.Online.writeStatus(
		"ONLINE SYNC PUSH OK\n"
		.. "event = "
		.. eventName
		.. "\nstate = "
		.. state
		.. "\nboss = "
		.. bossName
	)

	return true
end


function MultiFarm.Online.pull()
	if not MultiFarm.Online.Enabled
		or MultiFarm.Online.Busy then

		return false
	end

	MultiFarm.Online.Busy = true

	MultiFarm.Online.LastAttempt =
		os.clock()

	local response =
		MultiFarm.Online.call(
			"GET",
			"/state"
		)

	if not response then
		MultiFarm.Online.Busy = false
		return false
	end

	local body =
		response.Body
		or response.body

	local ok, data =
		pcall(function()

			return game:GetService(
				"HttpService"
			):JSONDecode(
				body
			)
		end)

	if not ok
		or type(data)
			~= "table" then

		MultiFarm.Online.Busy = false
		return false
	end

	if tostring(
		data.jobId or ""
	) ~= tostring(game.JobId)
		or tonumber(
			data.placeId
		) ~= game.PlaceId then

		MultiFarm.Online.Busy = false
		return false
	end

	local peers = {}

	for userId, member
		in pairs(
			data.members
			or {}
		) do

		local numericUserId =
			tonumber(userId)

		if numericUserId
			and numericUserId
				~= LocalPlayer.UserId
			and type(member)
				== "table" then

			local player =
				Players:GetPlayerByUserId(
					numericUserId
				)

			if player then

				peers[player.Name] = {
					player = player.Name,
					userid = numericUserId,
					jobId = game.JobId,
					placeId = game.PlaceId,
					updated = MultiFarm.nowMs(),
					state =
						tostring(
							member.state
							or "Idle"
						),
					boss =
						tostring(
							member.boss
							or ""
						),
					display =
						player.Name
						.. " On "
						.. tostring(
							member.state
							or "Idle"
						),
					multipleFarm = true,
					farmWith = "",
					online = true,
					event =
						tostring(
							member.event
							or ""
						),
					position =
						member.position
				}
			end
		end
	end

	MultiFarm.Online.Peers = peers
	MultiFarm.Online.LastBossDeath =
		data.lastBossDeath

	MultiFarm.Online.LastRevision =
		tonumber(
			data.revision
		)
		or 0

	MultiFarm.Online.LastPull =
		os.clock()

	MultiFarm.Online.Busy = false

	MultiFarm.Online.writeStatus(
		"ONLINE SYNC PULL OK\nrevision = "
		.. tostring(
			MultiFarm.Online.LastRevision
		)
		.. "\nroom = "
		.. MultiFarm.Online.Room
	)

	return true
end


function MultiFarm.Online.getRemoteRewardPosition(bossName)
	bossName =
		tostring(
			bossName
			or MultiFarm.Boss
			or ""
		)

	for _, peer in pairs(
		MultiFarm.Online.Peers
	) do

		if tostring(
			peer.boss
			or ""
		) == bossName then

			local eventName =
				tostring(
					peer.event
					or ""
				)

			local state =
				tostring(
					peer.state
					or ""
				)

			if eventName == "ChestOpened"
				or eventName == "LootPending"
				or eventName == "BossDead"
				or state == "Open Chest"
				or state == "Picking Loot"
				or state == "Waiting Loot" then

				local position =
					MultiFarm.Online.tableToPosition(
						peer.position
					)

				if position then
					return position
				end
			end
		end
	end

	return nil
end


function MultiFarm.Online.applyRespawnRecovery(bossName)
	if MultiFarm.isFollower() then
		return false
	end

	local lastBossDeath =
		MultiFarm.Online.LastBossDeath

	if type(lastBossDeath)
		~= "table" then

		return false
	end

	if tostring(
		lastBossDeath.boss
		or ""
	) ~= tostring(
		bossName
		or ""
	) then

		return false
	end

	local position =
		MultiFarm.Online.tableToPosition(
			lastBossDeath.position
		)

	if not position then
		return false
	end

	MultiFarm.RespawnRecoveryPending = true
	MultiFarm.RespawnBossName =
		tostring(bossName or "")
	MultiFarm.RespawnBossPosition =
		position

	return true
end


function MultiFarm.Online.startCritical(seconds)
	if not MultiFarm.Online.Enabled then
		return
	end

	if MultiFarm.Online.RateLimited
		and os.clock()
			< (MultiFarm.Online.RetryAfter or 0) then

		return
	end

	seconds =
		tonumber(seconds)
		or 5

	MultiFarm.Online.CriticalUntil =
		math.max(
			MultiFarm.Online.CriticalUntil
				or 0,
			os.clock() + seconds
		)

	task.spawn(function()
		MultiFarm.Online.pull()
	end)
end


function MultiFarm.Online.onStatus(state, bossName)
	if not MultiFarm.Online.Enabled then
		return
	end

	state =
		tostring(
			state or "Idle"
		)

	bossName =
		tostring(
			bossName
			or MultiFarm.Boss
			or ""
		)

	local eventName =
		"StatusChanged"

	if state == "Attacking" then
		eventName = "BossEngaged"

	elseif state == "Respawning" then

		eventName =
			MultiFarm.isFollower()
				and "FollowerDied"
				or "LeaderDied"

		MultiFarm.Online.startCritical(
			5
		)

	elseif state == "Open Chest" then
		eventName = "ChestOpening"

	elseif state == "Picking Loot" then
		eventName = "LootPending"

	elseif state == "Waiting Loot" then
		eventName = "WaitingLoot"

	elseif state == "Delivery" then
		eventName = "DeliveryStarted"

	elseif state == "Waiting Sync" then

		eventName = "WaitingSync"

		MultiFarm.Online.startCritical(
			5
		)

	elseif state == "Catching Up" then
		eventName = "CatchingUp"

	elseif state == "Resuming" then
		eventName = "Resuming"

	elseif state == "Traveling" then
		eventName = "Traveling"

	elseif state == "Crow Quest" then
		eventName = "CrowQuest"

	elseif state == "Ready" then
		eventName = "Ready"

	elseif state == "Idle" then
		eventName = "Idle"
	end

	task.spawn(function()

		MultiFarm.Online.push(
			eventName,
			state,
			bossName,
			MultiFarm.ActiveBossPosition,
			false
		)

	end)
end

function MultiFarm.Online.setEnabled(value)
	MultiFarm.Online.Enabled =
		value == true

	MultiFarm.Online.Peers = {}
	MultiFarm.Online.LastBossDeath = nil
	MultiFarm.Online.LastPushSignature = ""

	if os.clock()
		>= (MultiFarm.Online.RetryAfter or 0) then

		MultiFarm.Online.RateLimited =
			false

		MultiFarm.Online.RetryAfter =
			0
	end

	if not MultiFarm.Online.Enabled then

		MultiFarm.Online.writeStatus(
			"ONLINE SYNC DISABLED"
		)

		return
	end

	MultiFarm.Online.CriticalUntil =
		os.clock() + 3

	MultiFarm.scan()
	MultiFarm.refreshDropdown()

	task.spawn(function()

		MultiFarm.Online.onStatus(
			MultiFarm.State,
			MultiFarm.Boss
		)

		MultiFarm.Online.pull()
		MultiFarm.scan()
		MultiFarm.refreshDropdown()

	end)
end


function MultiFarm.filePath()
	return MultiFarm.Folder
		.. "/"
		.. tostring(
			LocalPlayer.UserId
		)
		.. ".json"
end


function MultiFarm.available()
	return typeof(writefile) == "function"
		and typeof(readfile) == "function"
		and typeof(listfiles) == "function"
		and typeof(makefolder) == "function"
end


function MultiFarm.ensureFolder()
	if not MultiFarm.available() then
		return false
	end

	if typeof(isfolder) == "function" then
		local ok, exists =
			pcall(
				isfolder,
				MultiFarm.Folder
			)

		if ok and exists then
			return true
		end
	end

	pcall(
		makefolder,
		MultiFarm.Folder
	)

	return true
end


function MultiFarm.setStatus(state, bossName)
	state =
		tostring(
			state or "Idle"
		)

	local nextBoss =
		bossName ~= nil
			and tostring(
				bossName
			)
			or tostring(
				MultiFarm.Boss
				or ""
			)

	if MultiFarm.State == state
		and tostring(
			MultiFarm.Boss
			or ""
		) == nextBoss then

		return
	end

	MultiFarm.State =
		state

	MultiFarm.Boss =
		nextBoss

	MultiFarm.write()

	MultiFarm.Online.onStatus(
		state,
		nextBoss
	)
end

function MultiFarm.write()
	if not MultiFarm.ensureFolder() then
		return false
	end

	local bossName =
		tostring(
			MultiFarm.Boss or ""
		)

	local display =
		LocalPlayer.Name
		.. " On "
		.. tostring(
			MultiFarm.State
		)

	if bossName ~= "" then
		display =
			display
			.. " "
			.. bossName
	end

	local payload = {
		player = LocalPlayer.Name,
		userid = LocalPlayer.UserId,
		jobId = game.JobId,
		placeId = game.PlaceId,
		updated = MultiFarm.nowMs(),
		state = MultiFarm.State,
		boss = bossName,
		display = display,
		multipleFarm = MultiFarm.Enabled,
		farmWith = MultiFarm.Target
	}

	local ok, encoded =
		pcall(function()
			return game:GetService(
				"HttpService"
			):JSONEncode(
				payload
			)
		end)

	if not ok
		or not encoded then

		return false
	end

	return pcall(
		writefile,
		MultiFarm.filePath(),
		encoded
	)
end


function MultiFarm.read(path)
	local ok, encoded =
		pcall(
			readfile,
			path
		)

	if not ok
		or type(encoded) ~= "string" then

		return nil
	end

	local decodeOk, data =
		pcall(function()
			return game:GetService(
				"HttpService"
			):JSONDecode(
				encoded
			)
		end)

	if not decodeOk
		or type(data) ~= "table" then

		return nil
	end

	return data
end


function MultiFarm.scan()
	local peers = {}

	if MultiFarm.ensureFolder() then

		local ok, files =
			pcall(
				listfiles,
				MultiFarm.Folder
			)

		if ok
			and type(files) == "table" then

			local now =
				MultiFarm.nowMs()

			for _, path in ipairs(files) do

				if string.match(
					tostring(path),
					"%.json$"
				) then

					local data =
						MultiFarm.read(
							path
						)

					if data
						and tonumber(data.userid)
							~= LocalPlayer.UserId
						and tostring(data.jobId or "")
							== tostring(game.JobId)
						and tonumber(data.placeId)
							== game.PlaceId
						and type(data.player)
							== "string"
						and tonumber(data.updated)
						and now
							- tonumber(data.updated)
							<= MultiFarm.StaleMs then

						peers[data.player] =
							data
					end
				end
			end
		end
	end

	if MultiFarm.Online.Enabled then

		for playerName, data
			in pairs(
				MultiFarm.Online.Peers
			) do

			peers[playerName] =
				data
		end
	end

	MultiFarm.Peers =
		peers
end

function MultiFarm.getPlayerNames()
	local names = {
		"None"
	}

	local seen = {
		None = true
	}

	for playerName in pairs(
		MultiFarm.Peers
	) do

		if not seen[playerName] then

			seen[playerName] =
				true

			table.insert(
				names,
				playerName
			)
		end
	end

	if MultiFarm.Online.Enabled then

		for _, player in ipairs(
			Players:GetPlayers()
		) do

			if player ~= LocalPlayer
				and not seen[player.Name] then

				seen[player.Name] =
					true

				table.insert(
					names,
					player.Name
				)
			end
		end
	end

	if MultiFarm.Target ~= "None"
		and MultiFarm.Target ~= ""
		and not seen[
			MultiFarm.Target
		] then

		table.insert(
			names,
			MultiFarm.Target
		)
	end

	table.sort(
		names,
		function(a, b)
			if a == "None" then
				return true
			end

			if b == "None" then
				return false
			end

			return string.lower(a)
				< string.lower(b)
		end
	)

	return names
end

function MultiFarm.refreshDropdown()
	if not MultiFarm.Dropdown then
		return
	end

	local values =
		MultiFarm.getPlayerNames()

	local key =
		table.concat(
			values,
			"\0"
		)

	if key == MultiFarm.LastValuesKey then
		return
	end

	MultiFarm.LastValuesKey =
		key

	if MultiFarm.Dropdown.SetValues then
		pcall(function()
			MultiFarm.Dropdown:SetValues(
				values
			)
		end)
	end
end


function MultiFarm.setEnabled(value)
	MultiFarm.Enabled =
		value == true

	if not MultiFarm.Enabled then
		MultiFarm.LeaderDeliveryLatched =
			false
	end

	MultiFarm.write()
end


function MultiFarm.setTarget(value)
	if type(value) == "table" then

		local chosen =
			nil

		for name, selected in pairs(value) do
			if selected then
				chosen =
					tostring(name)
				break
			end
		end

		value =
			chosen or "None"
	end

	MultiFarm.Target =
		tostring(
			value or "None"
		)

	MultiFarm.LeaderDeliveryLatched =
		false

	MultiFarm.write()

	if MultiFarm.Online.Enabled then

		MultiFarm.Online.startCritical(
			3
		)

		task.spawn(function()

			MultiFarm.Online.push(
				"RoleChanged",
				MultiFarm.State,
				MultiFarm.Boss,
				MultiFarm.ActiveBossPosition,
				true
			)

		end)
	end
end


function MultiFarm.isFollower()
	return MultiFarm.Enabled
		and MultiFarm.Target ~= "None"
		and MultiFarm.Target ~= ""
end


function MultiFarm.getLeader()
	if not MultiFarm.isFollower() then
		return nil
	end

	local peer =
		MultiFarm.Peers[
			MultiFarm.Target
		]

	if not peer then
		return nil
	end

	MultiFarm.LastLeaderSeenAt =
		os.clock()

	local updated =
		tonumber(
			peer.updated
		)

	local staleLimit =
		peer.online
			and 15000
			or MultiFarm.StaleMs

	if not updated
		or MultiFarm.nowMs()
			- updated
			> staleLimit then

		return nil
	end

	return peer
end


function MultiFarm.resolveBoss(defaultBoss)
	if not MultiFarm.Enabled
		or MultiFarm.Target == "None"
		or MultiFarm.Target == "" then

		return defaultBoss, false
	end

	local leader =
		MultiFarm.getLeader()

	if not leader then

		if MultiFarm.LastLeaderSeenAt > 0
			and os.clock()
				- MultiFarm.LastLeaderSeenAt
				<= 8 then

			return nil, true
		end

		return nil, true
	end

	local state =
		tostring(
			leader.state or "Idle"
		)

	if state == "Delivery"
		or state == "Respawning"
		or state == "Idle"
		or state == "Waiting Sync"
		or state == "Open Chest"
		or state == "Picking Loot"
		or state == "Waiting Loot" then

		return nil, true
	end

	local bossName =
		tostring(
			leader.boss or ""
		)

	if bossName == "" then
		return nil, true
	end

	return bossName, false
end


function MultiFarm.loadAutoloadConfig(saveManager, fluent)
	if not saveManager then
		return false
	end

	local folder =
		tostring(
			saveManager.Folder
			or "Slayer2Sigma/config"
		)

	local autoloadPath =
		folder
		.. "/settings/autoload.txt"

	if typeof(isfile) ~= "function"
		or typeof(readfile) ~= "function" then

		pcall(function()
			saveManager:LoadAutoloadConfig()
		end)

		return false
	end


	local existsOk,
		autoloadExists =
		pcall(
			isfile,
			autoloadPath
		)

	if not existsOk
		or not autoloadExists then

		return false
	end


	local nameOk,
		configName =
		pcall(
			readfile,
			autoloadPath
		)

	if not nameOk
		or type(configName) ~= "string" then

		return false
	end


	configName =
		configName
			:gsub("^%s+", "")
			:gsub("%s+$", "")

	if configName == "" then
		return false
	end


	local configPath =
		folder
		.. "/settings/"
		.. configName
		.. ".json"


	local configExistsOk,
		configExists =
		pcall(
			isfile,
			configPath
		)

	if not configExistsOk
		or not configExists then

		return false
	end


	local contentOk,
		content =
		pcall(
			readfile,
			configPath
		)

	if not contentOk
		or type(content) ~= "string" then

		return false
	end


	local decodeOk,
		decoded =
		pcall(function()

			return game:GetService(
				"HttpService"
			):JSONDecode(
				content
			)
		end)

	if not decodeOk
		or type(decoded) ~= "table"
		or type(decoded.objects) ~= "table" then

		return false
	end


	local savedFarmWith =
		nil

	local savedBossSelect =
		nil


	for _, object in ipairs(
		decoded.objects
	) do

		if type(object) == "table" then

			if object.idx == "FarmWith" then

				savedFarmWith =
					object.value

			elseif object.idx == "BossSelect" then

				savedBossSelect =
					object.value
			end
		end
	end


	if MultiFarm.Dropdown
		and savedFarmWith ~= nil then

		local target =
			tostring(
				savedFarmWith
			)

		local values =
			MultiFarm.getPlayerNames()

		local found =
			false

		for _, value in ipairs(values) do
			if tostring(value) == target then
				found =
					true

				break
			end
		end

		if not found
			and target ~= ""
			and target ~= "None" then

			table.insert(
				values,
				target
			)
		end

		pcall(function()
			MultiFarm.Dropdown:SetValues(
				values
			)
		end)
	end


	if bossDropdown
		and type(savedBossSelect) == "table" then

		local values =
			getActiveNpcNames()

		local foundValues = {}

		for _, value in ipairs(values) do
			foundValues[
				tostring(value)
			] = true
		end


		for bossName, selected in pairs(
			savedBossSelect
		) do

			if selected
				and type(bossName) == "string"
				and not foundValues[
					bossName
				] then

				foundValues[
					bossName
				] = true

				table.insert(
					values,
					bossName
				)
			end
		end


		table.sort(
			values,
			function(a, b)
				return string.lower(
					tostring(a)
				)
					< string.lower(
						tostring(b)
					)
			end
		)


		pcall(function()
			bossDropdown:SetValues(
				values
			)
		end)
	end


	local loaded,
		loadResult,
		loadError =
		pcall(function()

			local success,
				err =
				saveManager:Load(
					configName
				)

			return success,
				err
		end)


	if not loaded
		or not loadResult then

		if fluent then

			pcall(function()

				fluent:Notify({
					Title = "Interface",
					Content = "Config loader",
					SubContent =
						"Failed to auto load "
						.. tostring(
							configName
						)
						.. ": "
						.. tostring(
							loadError
							or "unknown error"
						),
					Duration = 7
				})

			end)
		end

		return false
	end


	task.delay(
		0.35,
		function()

			if not Runtime.alive then
				return
			end


			if MultiFarm.Dropdown
				and savedFarmWith ~= nil then

				local target =
					tostring(
						savedFarmWith
					)

				local values =
					MultiFarm.getPlayerNames()

				local found =
					false

				for _, value in ipairs(values) do
					if tostring(value)
						== target then

						found =
							true

						break
					end
				end


				if not found
					and target ~= ""
					and target ~= "None" then

					table.insert(
						values,
						target
					)
				end


				pcall(function()
					MultiFarm.Dropdown:SetValues(
						values
					)

					MultiFarm.Dropdown:SetValue(
						savedFarmWith
					)
				end)
			end


			if bossDropdown
				and type(savedBossSelect)
					== "table" then

				pcall(function()
					bossDropdown:SetValue(
						savedBossSelect
					)
				end)
			end

		end
	)


	if fluent then

		pcall(function()

			fluent:Notify({
				Title = "Interface",
				Content = "Config loader",
				SubContent =
					string.format(
						"Auto loaded config %q",
						configName
					),
				Duration = 5
			})

		end)
	end


	return true
end


function MultiFarm.cleanup()
	if typeof(delfile) ~= "function"
		or typeof(isfile) ~= "function" then

		return
	end

	local path =
		MultiFarm.filePath()

	local ok, exists =
		pcall(
			isfile,
			path
		)

	if ok and exists then
		pcall(
			delfile,
			path
		)
	end
end


local function getSelectedBossNames()
	local result = {}

	for _, bossName in ipairs(selectedBossOrder) do
		if selectedBossSet[bossName] then
			table.insert(result, bossName)
		end
	end

	return result
end


local function getBossRoute()
	local selected = getSelectedBossNames()

	if #selected > 0 then
		return selected
	end

	if #Runtime.BossRegistry.Names == 0 then
		Runtime.BossRegistry.scan()
	end

	return Runtime.BossRegistry.Names
end


local function setBossSelected(bossName, state)
	bossName = tostring(bossName)

	if state then

		if not selectedBossSet[bossName] then

			selectedBossSet[bossName] =
				true

			table.insert(
				selectedBossOrder,
				bossName
			)
		end

	else

		selectedBossSet[bossName] =
			nil

		for index, name
			in ipairs(selectedBossOrder) do

			if name == bossName then

				table.remove(
					selectedBossOrder,
					index
				)

				break
			end
		end
	end

	currentBossIndex = 1
	lastBossIndex = 1
end


function Runtime.BossRegistry.findInfo(container)
	if not container then
		return nil
	end

	local bossInfo =
		container:FindFirstChild(
			"BossInfo"
		)
		or container:FindFirstChild(
			"Bossinfo"
		)

	if bossInfo then
		return bossInfo
	end

	bossInfo =
		container:FindFirstChild(
			"BossInfo",
			true
		)
		or container:FindFirstChild(
			"Bossinfo",
			true
		)

	return bossInfo
end

function Runtime.BossRegistry.scan()
	local folders = {}
	local infos = {}
	local names = {}
	local seen = {}

	local humanoids =
		workspace:FindFirstChild(
			"Humanoids"
		)

	local regions =
		humanoids
		and humanoids:FindFirstChild(
			"Regions"
		)

	if not regions then

		return Runtime.BossRegistry.Names
			or {}
	end

	for _, region in ipairs(
		regions:GetChildren()
	) do

		local activeNpcs =
			region:FindFirstChild(
				"ActiveNpcs"
			)

		if activeNpcs then

			for _, container in ipairs(
				activeNpcs:GetChildren()
			) do

				if container:IsA("Folder")
					or container:IsA("Model") then

					local bossInfo =
						Runtime.BossRegistry.findInfo(
							container
						)

					if bossInfo then

						local bossName =
							tostring(
								container.Name
							)

						if not seen[bossName] then

							seen[bossName] =
								true

							folders[bossName] =
								container

							infos[bossName] =
								bossInfo

							table.insert(
								names,
								bossName
							)
						end
					end
				end
			end
		end
	end

	table.sort(
		names,
		function(a, b)
			return string.lower(a)
				< string.lower(b)
		end
	)

	Runtime.BossRegistry.Folders =
		folders

	Runtime.BossRegistry.Infos =
		infos

	Runtime.BossRegistry.Names =
		names

	return names
end

local function getActiveNpcNames()
	return Runtime.BossRegistry.scan()
end

local function getCharacter()
	return LocalPlayer.Character
end


local function getPlayerClan()
	local humanoids =
		workspace:FindFirstChild(
			"Humanoids"
		)

	if not humanoids then
		return nil
	end

	local playerModel =
		humanoids:FindFirstChild(
			LocalPlayer.Name
		)

	if not playerModel then
		return nil
	end

	local clan =
		playerModel:GetAttribute(
			"Clan"
		)

	if clan ~= nil then
		return tostring(clan)
	end

	local attributesFolder =
		playerModel:FindFirstChild(
			"Attributes"
		)

	if attributesFolder then
		local clanValue =
			attributesFolder:FindFirstChild(
				"Clan"
			)

		if clanValue
			and clanValue:IsA(
				"ValueBase"
			) then

			return tostring(
				clanValue.Value
			)
		end
	end

	return nil
end

local function getCharacterHumanoid()
	local character = getCharacter()
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

local function getCharacterRoot()
	local character = getCharacter()
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function isPlayerAlive()
	local humanoid = getCharacterHumanoid()
	local root = getCharacterRoot()

	return humanoid ~= nil
		and root ~= nil
		and humanoid.Health > 0
end


local Universal = {
	InfiniteJump = false,
	Fly = false,
	FlySpeed = 60,
	WalkSpeedEnabled = false,
	WalkSpeed = 32,
	JumpPowerEnabled = false,
	JumpPower = 50,
	OriginalWalkSpeed = nil,
	OriginalJumpPower = nil,
	OriginalUseJumpPower = nil
}


function Universal.captureOriginals()
	local humanoid =
		getCharacterHumanoid()

	if not humanoid then
		return
	end

	if Universal.OriginalWalkSpeed == nil then
		Universal.OriginalWalkSpeed =
			humanoid.WalkSpeed
	end

	if Universal.OriginalJumpPower == nil then
		Universal.OriginalJumpPower =
			humanoid.JumpPower
	end

	if Universal.OriginalUseJumpPower == nil then
		Universal.OriginalUseJumpPower =
			humanoid.UseJumpPower
	end
end


function Universal.applyWalkSpeed()
	if not Universal.WalkSpeedEnabled then
		return
	end

	local humanoid =
		getCharacterHumanoid()

	if humanoid then
		pcall(function()
			humanoid.WalkSpeed =
				Universal.WalkSpeed
		end)
	end
end


function Universal.applyJumpPower()
	if not Universal.JumpPowerEnabled then
		return
	end

	local humanoid =
		getCharacterHumanoid()

	if humanoid then
		pcall(function()
			humanoid.UseJumpPower =
				true

			humanoid.JumpPower =
				Universal.JumpPower
		end)
	end
end


function Universal.setWalkSpeedEnabled(state)
	Universal.captureOriginals()

	Universal.WalkSpeedEnabled =
		state == true

	if Universal.WalkSpeedEnabled then

		Universal.applyWalkSpeed()

	else

		local humanoid =
			getCharacterHumanoid()

		if humanoid
			and Universal.OriginalWalkSpeed
				~= nil then

			pcall(function()
				humanoid.WalkSpeed =
					Universal.OriginalWalkSpeed
			end)
		end
	end
end


function Universal.setJumpPowerEnabled(state)
	Universal.captureOriginals()

	Universal.JumpPowerEnabled =
		state == true

	if Universal.JumpPowerEnabled then

		Universal.applyJumpPower()

	else

		local humanoid =
			getCharacterHumanoid()

		if humanoid then

			if Universal.OriginalUseJumpPower
				~= nil then

				pcall(function()
					humanoid.UseJumpPower =
						Universal.OriginalUseJumpPower
				end)
			end

			if Universal.OriginalJumpPower
				~= nil then

				pcall(function()
					humanoid.JumpPower =
						Universal.OriginalJumpPower
				end)
			end
		end
	end
end


function Universal.setFly(state)
	Universal.Fly =
		state == true

	if not Universal.Fly then

		local root =
			getCharacterRoot()

		if root then
			pcall(function()
				root.AssemblyLinearVelocity =
					Vector3.zero

				root.AssemblyAngularVelocity =
					Vector3.zero
			end)
		end
	end
end


function Universal.updateFly()
	if not Universal.Fly
		or not Runtime.alive then

		return
	end

	local root =
		getCharacterRoot()

	local humanoid =
		getCharacterHumanoid()

	local camera =
		workspace.CurrentCamera

	if not root
		or not humanoid
		or humanoid.Health <= 0
		or not camera then

		return
	end

	local direction =
		Vector3.zero

	if UserInputService:IsKeyDown(
		Enum.KeyCode.W
	) then

		direction +=
			camera.CFrame.LookVector
	end

	if UserInputService:IsKeyDown(
		Enum.KeyCode.S
	) then

		direction -=
			camera.CFrame.LookVector
	end

	if UserInputService:IsKeyDown(
		Enum.KeyCode.D
	) then

		direction +=
			camera.CFrame.RightVector
	end

	if UserInputService:IsKeyDown(
		Enum.KeyCode.A
	) then

		direction -=
			camera.CFrame.RightVector
	end

	if UserInputService:IsKeyDown(
		Enum.KeyCode.Space
	) then

		direction +=
			Vector3.new(
				0,
				1,
				0
			)
	end

	if UserInputService:IsKeyDown(
		Enum.KeyCode.LeftControl
	)
		or UserInputService:IsKeyDown(
			Enum.KeyCode.LeftShift
		) then

		direction -=
			Vector3.new(
				0,
				1,
				0
			)
	end

	if direction.Magnitude > 0 then
		direction =
			direction.Unit
	end

	pcall(function()

		root.AssemblyLinearVelocity =
			direction
			* Universal.FlySpeed

		root.AssemblyAngularVelocity =
			Vector3.zero

	end)
end


