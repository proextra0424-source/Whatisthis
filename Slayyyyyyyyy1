                    wait(1)
                    if not AutoBRPunch_Active or AutoBRPunch_RunId ~= runId then
                        return false
                    end
                    ReplicatedStorage.Remotes.ClientToServer.BossStart:FireServer(unpack(args))

                    -- The Boss Rush arena needs time to load before target scanning begins.
                    for _ = 1, 350 do
