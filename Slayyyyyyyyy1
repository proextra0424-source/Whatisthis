local function ensureToolOneReady(timeout)
	timeout = timeout or TOOL_READY_TIMEOUT

	local deadline =
		os.clock() + timeout

	setEquippedToOne()


	while Runtime.alive
		and farmEnabled
		and os.clock() < deadline do

		local character =
			getCharacter()

		if character
			and character:FindFirstChildOfClass("Tool") then

			return true
		end


		setEquippedToOne()

		task.wait(0.15)
	end


	return false
end


