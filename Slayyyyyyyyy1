function Delivery.runAutoDeliveryQuest()
	if not Runtime.alive
		or not autoDeliveryEnabled
		or deliveryBusy
		or MultiFarm.RewardBusy
		or MultiFarm.LootBusy then

		return false
	end

	if Delivery.hasActiveCrowQuest() then
		return false
	end

	deliveryBusy =
		true

	MultiFarm.setStatus(
		"Delivery",
		""
	)

	destroyFollow()

	local waitBossUntil =
		os.clock()
		+ 3

	while Runtime.alive
		and autoDeliveryEnabled
		and bossProcessBusy
		and os.clock() < waitBossUntil do

		task.wait(0.03)
	end


	local success =
		false

	local ok =
		pcall(function()

			if not Delivery.deliveryCanContinue() then
				return
			end


			local niko =
				Delivery.getOrRenderNiko()

			if not niko then
				return
			end


			if not Delivery.followNikoClose(
				niko
			) then

				return
			end


			local questFrame =
				Delivery.getDeliveryQuestFrame()

			if not questFrame then

				questFrame =
					Delivery.waitForDeliveryQuestAccepted()
			end


			if not questFrame
				or not Delivery.deliveryCanContinue() then

				return
			end


			destroyFollow()


			if not Delivery.isDeliveryHalfComplete() then

				if not Delivery.teleportDelivery(
					DELIVERY_SHIORI_POSITION
				) then

					return
				end


				local shioriWaitUntil =
					os.clock()
					+ DELIVERY_SHIORI_WAIT

				while Delivery.deliveryCanContinue()
					and os.clock()
						< shioriWaitUntil do

					task.wait(0.02)
				end


				if not Delivery.deliveryCanContinue() then
					return
				end


				if not Delivery.waitForShioriProgress() then
					return
				end
			end


			if not Delivery.deliveryCanContinue() then
				return
			end


			if not Delivery.teleportDelivery(
				DELIVERY_RENDER_NIKO
			) then

				return
			end


			niko =
				Delivery.waitForNiko()

			if not niko then
				return
			end


			if not Delivery.followNikoClose(
				niko
			) then

				return
			end


			if not Delivery.waitForDeliveryQuestFinished() then
				return
			end


			success =
				Delivery.getDeliveryQuestFrame()
				== nil
		end)


	destroyFollow()

	deliveryBusy =
		false

	if farmEnabled then

		MultiFarm.setStatus(
			"Resuming",
			""
		)

		setEquippedToOne()

	else

		MultiFarm.setStatus(
			"Idle",
			""
		)
	end


	if not ok then
		return false
	end

	return success
end


function Delivery.setAutoDeliveryEnabled(state)
	autoDeliveryEnabled =
