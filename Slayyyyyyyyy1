		end
	end
end

local function findFluentGuiRoot()
	if fluentGuiRoot
		and fluentGuiRoot.Parent then

		return fluentGuiRoot
	end

	local now = os.clock()

	if now - lastUiRootSearch < 0.75 then
		return nil
	end

	lastUiRootSearch = now

	local containers = {}

	if typeof(gethui) == "function" then
		local ok, hui = pcall(gethui)

		if ok and hui then
			table.insert(containers, hui)
		end
	end

	pcall(function()
		table.insert(
			containers,
			game:GetService("CoreGui")
		)
	end)

	local playerGui =
		LocalPlayer:FindFirstChild(
			"PlayerGui"
		)

	if playerGui then
		table.insert(
			containers,
			playerGui
		)
	end

	for _, container in ipairs(containers) do
		for _, object in ipairs(
			container:GetDescendants()
		) do
			if object:IsA("TextLabel")
				or object:IsA("TextButton") then

				local value =
					tostring(object.Text)

				if string.find(
					value,
					"Slayer 2 Script By Sigma",
					1,
					true
				) then

					local screenGui =
						object:FindFirstAncestorOfClass(
							"ScreenGui"
						)

					if screenGui then
						fluentGuiRoot =
							screenGui

						return screenGui
					end
				end
			end
		end
	end

	return nil
end


local function guiObjectVisible(object, root)
	if not object.Visible then
		return false
	end

	local parent = object.Parent

	while parent
		and parent ~= root do

		if parent:IsA("GuiObject")
			and not parent.Visible then

			return false
		end

		parent = parent.Parent
	end

	if root:IsA("ScreenGui")
		and not root.Enabled then

		return false
	end

	return true
end


local function pointInsideGuiObject(object, point)
	local position =
		object.AbsolutePosition

	local size =
		object.AbsoluteSize

	return
		point.X >= position.X
		and point.X <= position.X + size.X
		and point.Y >= position.Y
		and point.Y <= position.Y + size.Y
end


local function mouseOverFluentControl()
	local root =
		findFluentGuiRoot()

	local mousePosition =
		UserInputService:GetMouseLocation()

	if mobileToggleButton
		and mobileToggleButton.Parent
		and mobileToggleButton.Visible then

		if pointInsideGuiObject(
			mobileToggleButton,
			mousePosition
		) then

			return true
		end
	end

	if not root then
		local moved =
			(mousePosition - fallbackMousePosition).Magnitude

		fallbackMousePosition =
			mousePosition

		if moved > 1 then
			fallbackPauseUntil =
				os.clock() + 0.35
		end

		return
			os.clock()
			< fallbackPauseUntil
	end

	local topLeftInset =
		select(
			1,
			GuiService:GetGuiInset()
		)

	local adjustedPosition =
		mousePosition
		- topLeftInset

	for _, object in ipairs(
		root:GetDescendants()
	) do
		if (
			object:IsA("GuiButton")
			or object:IsA("TextBox")
			or object:IsA("ScrollingFrame")
		)
			and guiObjectVisible(
				object,
				root
			) then

			if pointInsideGuiObject(
				object,
				mousePosition
			)
				or pointInsideGuiObject(
					object,
					adjustedPosition
				) then

				return true
			end
		end
	end

	return false
end


local function pressKey(keyCode)
	if inputBusy then
		return false
	end

	inputBusy = true

	local ok = pcall(function()
		VirtualInputManager:SendKeyEvent(
			true,
			keyCode,
			false,
			game
		)

		task.wait(KEY_HOLD_TIME)

		VirtualInputManager:SendKeyEvent(
			false,
			keyCode,
			false,
			game
		)
	end)

	inputBusy = false

	return ok
end


local function useAutoSkill()
	if #selectedAutoSkillKeys == 0 then
		return false
	end

	if clanSkillBusy then
		return false
	end

	local used = false

	for _, keyCode in ipairs(selectedAutoSkillKeys) do
		if not Runtime.alive
			or not farmEnabled
			or clanSkillBusy then

			break
		end

		if pressKey(keyCode) then
			used = true
		end
	end

	return used
end


local function useClanSkill()
	if not selectedClanSkillKey then
		return false
	end

	if clanSkillBusy then
		return false
	end


	clanSkillBusy = true

	if not setEquippedSlot(2) then
		clanSkillBusy = false
		return false
	end


	local endTime =
		os.clock()
		+ CLAN_TOOL_DURATION


	while Runtime.alive
		and farmEnabled
		and os.clock() < endTime do

		pressKey(
			selectedClanSkillKey
		)

		task.wait(
			CLAN_SKILL_SPAM_INTERVAL
		)
	end


	setEquippedSlot(1)

	clanSkillBusy = false

	return true
end


local function hasInteractiveAncestor(object)
	local current = object

	while current
		and current ~= game do

		if current:IsA("GuiButton")
			or current:IsA("TextBox")
			or current:IsA("ScrollingFrame") then

			return true
		end

		if current:IsA("GuiObject")
			and current.Active then

			return true
		end

		current = current.Parent
	end

	return false
end


local function getGuiObjectsAtMouse(container, x, y)
	if not container then
		return {}
	end

	local ok, objects =
		pcall(function()
			return container:GetGuiObjectsAtPosition(
				x,
				y
			)
		end)

	if ok and type(objects) == "table" then
		return objects
	end

	return {}
end


local function positionOverInteractiveGui(position)
	if not position then
		return false
	end

	local x =
		position.X

	local y =
		position.Y

	local playerGui =
		LocalPlayer:FindFirstChild(
			"PlayerGui"
		)

	for _, object in ipairs(
		getGuiObjectsAtMouse(
			playerGui,
			x,
			y
		)
	) do

		if hasInteractiveAncestor(
			object
		) then

			return true
		end
	end

	local ok, coreGui =
		pcall(function()
			return game:GetService(
				"CoreGui"
			)
		end)

	if ok and coreGui then

		for _, object in ipairs(
			getGuiObjectsAtMouse(
				coreGui,
				x,
				y
			)
		) do

			if hasInteractiveAncestor(
				object
			) then

				return true
			end
		end
	end

	return false
end


runtimeConnect(
	UserInputService.InputBegan,
	function(input, gameProcessed)

		if sendingSyntheticMouse then
			return
		end


		if input.UserInputType
			== Enum.UserInputType.MouseButton1 then

			local position =
				UserInputService:
					GetMouseLocation()

			if positionOverInteractiveGui(
				position
			) then

				realUiInputActive =
					true
			end


		elseif input.UserInputType
			== Enum.UserInputType.Touch then

			if positionOverInteractiveGui(
				input.Position
			) then

				activeUiTouchCount += 1
				realUiInputActive =
					true
			end
		end
	end
)


runtimeConnect(
	UserInputService.InputEnded,
	function(input)

		if sendingSyntheticMouse then
			return
		end


		if input.UserInputType
			== Enum.UserInputType.MouseButton1 then

			realUiInputActive =
				false


		elseif input.UserInputType
			== Enum.UserInputType.Touch then

			if activeUiTouchCount > 0 then
				activeUiTouchCount -= 1
			end

			if activeUiTouchCount <= 0 then

				activeUiTouchCount = 0
				realUiInputActive =
					false
			end
		end
	end
)


local function attackOnce()
	if mouseBusy
		or clanSkillBusy
		or realUiInputActive then

		return false
	end

	if not Runtime.alive
		or not farmEnabled
		or not isPlayerAlive() then

		return false
	end

	mouseBusy =
		true

	sendingSyntheticMouse =
		true

	local ok =
		pcall(function()

			VirtualInputManager:
				SendMouseButtonEvent(
					0,
					0,
					0,
					true,
					game,
					0
				)

			task.wait(0.01)

			VirtualInputManager:
				SendMouseButtonEvent(
					0,
					0,
					0,
					false,
					game,
					0
				)

		end)

	sendingSyntheticMouse =
		false

	mouseBusy =
		false

	return ok
end


local function runWeaponMasteryBurst(
	boss,
	getUsableBossCallback
)
	if not weaponMasteryFarmEnabled then
		return true
	end

	if not Runtime.alive
		or not farmEnabled
		or not isPlayerAlive() then

		return false
	end

	if not setEquippedSlot(3) then
		setEquippedToOne()
		return false
	end

	task.wait(
		WEAPON_MASTERY_EQUIP_DELAY
	)

	local timeoutAt =
		os.clock()
		+ WEAPON_MASTERY_DURATION

	local nextAttack =
		0

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and isPlayerAlive()
		and os.clock() < timeoutAt do

		local humanoid, bossRoot =
			getUsableBossCallback(
				boss
			)

		if not humanoid
			or not bossRoot then

			break
		end

		if followPosition then

			followPosition.Position =
				bossRoot.Position
				+ Vector3.new(
					0,
					FOLLOW_HEIGHT,
					0
				)
		end

		local now =
			os.clock()

		if now >= nextAttack then

			nextAttack =
				now
				+ ATTACK_INTERVAL

			attackOnce()
		end

		task.wait(0.02)
	end

	setEquippedToOne()

	ensureToolOneReady(
		TOOL_READY_TIMEOUT
	)

	return true
end


local function fightBoss(bossName, boss)
	if deliveryBusy then
		return "paused", nil
	end

	if not bossName then
		return "boss_lost", nil
	end


	local bossDiedConfirmed =
		false

	local diedConnection =
		nil


	local function disconnectDied()
		if diedConnection then

			pcall(function()
				diedConnection:Disconnect()
			end)

			diedConnection = nil
		end
	end


	local function hookBossHumanoid(model)
		disconnectDied()

		local humanoid =
			getBossHumanoid(model)

		if not humanoid then
			return nil
		end


		if humanoid.Health <= 0 then
			bossDiedConfirmed =
				true
		end


		diedConnection =
			humanoid.Died:Connect(function()

				bossDiedConfirmed =
					true

			end)


		return humanoid
	end


	local function cleanupFight()
		disconnectDied()
		destroyFollow()
	end


	local function getUsableBoss(model)
		if not model
			or not model.Parent then

			return nil, nil
		end


		local humanoid =
			getBossHumanoid(model)

		local root =
			getBossRoot(model)


		if humanoid
			and humanoid.Health > 0
			and root then

			return humanoid, root
		end


		if humanoid
			and humanoid.Health <= 0 then

			bossDiedConfirmed =
				true
		end


		return nil, nil
	end


	local function reacquireBoss()
		local deadline =
			os.clock()
			+ BOSS_REACQUIRE_GRACE


		while Runtime.alive
			and farmEnabled
			and not deliveryBusy
			and isPlayerAlive()
			and os.clock() < deadline do


			local candidate =
				getLiveBoss(
					bossName
				)


			if candidate then

				local humanoid, root =
					getUsableBoss(
						candidate
					)


				if humanoid and root then

					return
						candidate,
						humanoid,
						root
				end
			end


			task.wait(0.10)
		end


		return nil
	end


	if not boss then

		boss =
			getLiveBoss(
				bossName
			)
	end


	local bossHumanoid, bossRoot =
		getUsableBoss(
			boss
		)


	if not bossHumanoid
		or not bossRoot then

		boss,
		bossHumanoid,
		bossRoot =
			reacquireBoss()


		if not boss then

			return
				bossDiedConfirmed
					and "boss_dead"
					or "boss_lost",
				nil
		end
	end


	hookBossHumanoid(
		boss
	)


	local character, humanoid, root =
		waitForCharacterReady()


	if not character
		or not humanoid
		or not root then

		cleanupFight()

		return "paused", nil
	end


	ensureToolOneReady(
		TOOL_READY_TIMEOUT
	)


	character, humanoid, root =
		waitForCharacterReady()


	if not character
		or not humanoid
		or not root then

		cleanupFight()

		return "paused", nil
	end


	local isHimejimaClan =
		getPlayerClan()
		== "Himejima"


	if selectedClanSkillKey
		and not isHimejimaClan then

		useClanSkill()

		if not Runtime.alive
			or not farmEnabled then

			cleanupFight()

			return "paused", nil
		end


		if not isPlayerAlive() then

			cleanupFight()

			return
				"player_died",
				bossRoot
					and bossRoot.Position
					or nil
		end


		ensureToolOneReady(
			TOOL_READY_TIMEOUT
		)


		bossHumanoid, bossRoot =
			getUsableBoss(
				boss
			)


		if not bossHumanoid
			or not bossRoot then

			local newBoss,
				newHumanoid,
				newRoot =
				reacquireBoss()


			if newBoss then

				boss =
					newBoss

				bossHumanoid =
					newHumanoid

				bossRoot =
					newRoot


				hookBossHumanoid(
					boss
				)

			else

				cleanupFight()


				return
					bossDiedConfirmed
						and "boss_dead"
						or "boss_lost",
					nil
			end
		end
	end


	local targetPosition =
		bossRoot.Position
		+ Vector3.new(
			0,
			FOLLOW_HEIGHT,
			0
		)


	character:PivotTo(
		CFrame.new(
			targetPosition
		)
		* CFrame.Angles(
			math.rad(-90),
			0,
			0
		)
	)


	root.AssemblyLinearVelocity =
		Vector3.zero

	root.AssemblyAngularVelocity =
		Vector3.zero


	if not createFollowConstraints() then

		cleanupFight()

		return "paused", nil
	end


	if selectedClanSkillKey
		and isHimejimaClan then

		task.wait(0.05)

		useClanSkill()

		if not Runtime.alive
			or not farmEnabled then

			cleanupFight()

			return "paused", nil
		end


		if not isPlayerAlive() then

			cleanupFight()

			return
				"player_died",
				bossRoot
					and bossRoot.Position
					or nil
		end


		ensureToolOneReady(
			TOOL_READY_TIMEOUT
		)
	end


	if weaponMasteryFarmEnabled then

		runWeaponMasteryBurst(
			boss,
			getUsableBoss
		)

		if not Runtime.alive
			or not farmEnabled then

			cleanupFight()

			return "paused", nil
		end


		if not isPlayerAlive() then

			cleanupFight()

			return
				"player_died",
				bossRoot
					and bossRoot.Position
					or nil
		end


		bossHumanoid, bossRoot =
			getUsableBoss(
				boss
			)


		if not bossHumanoid
			or not bossRoot then

			local newBoss,
				newHumanoid,
				newRoot =
				reacquireBoss()


			if newBoss then

				boss =
					newBoss

				bossHumanoid =
					newHumanoid

				bossRoot =
					newRoot


				hookBossHumanoid(
					boss
				)

			else

				cleanupFight()

				return
					bossDiedConfirmed
						and "boss_dead"
						or "boss_lost",
					nil
			end
		end
	end


	humanoid =
		getCharacterHumanoid()

	if humanoid then
		humanoid.AutoRotate =
			false
	end


	lastAttackTime = 0
	lastAutoSkillTime = 0

	lastClanSkillTime =
		os.clock()


	local lastBossPosition =
		bossRoot.Position

	local lastToolRefresh =
		0

	local stuckSince =
		nil

	local lastSnapTime =
		0


	while Runtime.alive
		and farmEnabled
		and not deliveryBusy do


		if not isPlayerAlive() then

			cleanupFight()

			return
				"player_died",
				lastBossPosition
		end


		bossHumanoid, bossRoot =
			getUsableBoss(
				boss
			)


		if not bossHumanoid
			or not bossRoot then


			if bossDiedConfirmed then

				cleanupFight()

				return
					"boss_dead",
					lastBossPosition
			end


			local newBoss,
				newHumanoid,
				newRoot =
				reacquireBoss()


			if newBoss then

				boss =
					newBoss

				bossHumanoid =
					newHumanoid

				bossRoot =
					newRoot


				hookBossHumanoid(
					boss
				)


				if not followPosition
					or not followPosition.Parent then

					createFollowConstraints()
				end

			else

				cleanupFight()


				if bossDiedConfirmed then

					return
						"boss_dead",
						lastBossPosition

				else

					return
						"boss_lost",
						lastBossPosition
				end
			end
		end


		lastBossPosition =
			bossRoot.Position


		local desiredFollowPosition =
			bossRoot.Position
			+ Vector3.new(
				0,
				FOLLOW_HEIGHT,
				0
			)


		if followPosition then

			followPosition.Position =
				desiredFollowPosition
		end


		local currentRoot =
			getCharacterRoot()


		if currentRoot then

			local followDistance =
				(
					currentRoot.Position
					- desiredFollowPosition
				).Magnitude


			if followDistance
				>= FOLLOW_STUCK_DISTANCE then

				if not stuckSince then

					stuckSince =
						os.clock()

				elseif os.clock()
						- stuckSince
						>= FOLLOW_STUCK_TIME
					and os.clock()
						- lastSnapTime
						>= FOLLOW_SNAP_COOLDOWN then

					lastSnapTime =
						os.clock()

					stuckSince =
						nil


					local currentCharacter =
						getCharacter()


					if currentCharacter then

						currentCharacter:PivotTo(
							CFrame.new(
								desiredFollowPosition
							)
							* CFrame.Angles(
								math.rad(-90),
								0,
								0
							)
						)


						currentRoot.AssemblyLinearVelocity =
							Vector3.zero

						currentRoot.AssemblyAngularVelocity =
							Vector3.zero
					end
				end

			else

				stuckSince =
					nil
			end
		end


		local playerHumanoid =
			getCharacterHumanoid()

		if playerHumanoid then

			playerHumanoid.AutoRotate =
				false
		end


		local now =
			os.clock()


		if not clanSkillBusy
			and now - lastToolRefresh
				>= TOOL_REFRESH_INTERVAL then

			lastToolRefresh =
				now


			local currentCharacter =
				getCharacter()


			if currentCharacter
				and not currentCharacter:
					FindFirstChildOfClass("Tool") then

				setEquippedToOne()
			end
		end


		if not clanSkillBusy then

			if now - lastAttackTime
				>= ATTACK_INTERVAL then

				lastAttackTime =
					now

				attackOnce()
			end


			if #selectedAutoSkillKeys > 0
				and now - lastAutoSkillTime
					>= AUTO_SKILL_INTERVAL then

				lastAutoSkillTime =
					now

				useAutoSkill()
			end
		end


		if selectedClanSkillKey
			and now - lastClanSkillTime
				>= CLAN_SKILL_INTERVAL then

			lastClanSkillTime =
				now

			useClanSkill()
		end


		task.wait(0.03)
	end


	cleanupFight()

	return
		"paused",
		lastBossPosition
end


local function waitAbortable(seconds)
	local endTime = os.clock() + seconds

	while os.clock() < endTime do
		if not farmEnabled
			or deliveryBusy then
			return false
		end

		if not isPlayerAlive() then
			return false
		end

		task.wait(0.05)
	end

	return true
end


local function findNearestWorldEventsChest(origin)
	if not origin then
		return nil
	end

	local chestsFolder = workspace:FindFirstChild("Chests")
	if not chestsFolder then
		return nil
	end

	local nearestChest = nil
	local nearestDistance = CHEST_SEARCH_RADIUS

	for _, object in ipairs(chestsFolder:GetDescendants()) do
		if object.Name == "World Events Chest" then
			local position = getObjectPosition(object)

			if position then
				local distance = (position - origin).Magnitude

				if distance <= nearestDistance then
					nearestDistance = distance
					nearestChest = object
				end
			end
		end
	end

	local direct = chestsFolder:FindFirstChild("World Events Chest")
	if direct then
		local position = getObjectPosition(direct)

		if position then
			local distance = (position - origin).Magnitude

			if distance <= nearestDistance then
				nearestChest = direct
			end
		end
	end

	return nearestChest
end

local function waitForWorldEventsChest(origin)
	if not origin then
		return nil
	end

	local timeoutAt =
		os.clock()
		+ CHEST_WAIT_TIMEOUT

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do
		if not isPlayerAlive() then
			waitForCharacterReady()
		end

		local chest = findNearestWorldEventsChest(origin)

		if chest then
			return chest
		end

		task.wait(CHEST_POLL_INTERVAL)
	end

	return nil
end


local function getLootDropChildCount()
	local lootFolder =
		workspace:FindFirstChild(
			"LootDrops"
		)

	if not lootFolder then
		return 0
	end

	return #lootFolder:GetChildren()
end


local function waitForChestPrompt(chest)
	local timeoutAt =
		os.clock()
		+ CHEST_PROMPT_WAIT_TIMEOUT

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and chest
		and chest.Parent
		and os.clock() < timeoutAt do

		local prompt =
			chest:FindFirstChildWhichIsA(
				"ProximityPrompt",
				true
			)

		if prompt then
			return prompt
		end

		task.wait(0.05)
	end

	return nil
end


local function openWorldEventsChest(origin)
	if MultiFarm.isFollower() then
		return false
	end

	local chest =
		waitForWorldEventsChest(
			origin
		)

	if not chest then
		return false
	end

	MultiFarm.setStatus(
		"Open Chest",
		MultiFarm.Boss
	)

	local prompt =
		waitForChestPrompt(
			chest
		)

	if not prompt then
		return false
	end

	local beforeLootCount =
		getLootDropChildCount()

	local promptPosition =
		getObjectPosition(
			prompt.Parent
		)
		or getObjectPosition(
			chest
		)

	if not promptPosition then
		return false
	end

	teleportToPosition(
		promptPosition
		+ Vector3.new(
			0,
			1,
			0
		)
	)

	task.wait(
		CHEST_ARRIVAL_DELAY
	)

	local timeoutAt =
		os.clock()
		+ CHEST_OPEN_TIMEOUT

	local opened =
		false

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do

		if not isPlayerAlive() then
			return false
		end

		if not chest.Parent
			or not prompt.Parent then

			opened =
				true

			break
		end

		if prompt.Enabled then

			local root =
				getCharacterRoot()

			local currentPromptPosition =
				getObjectPosition(
					prompt.Parent
				)
				or promptPosition

			if root
				and currentPromptPosition then

				local maxDistance =
					math.max(
						prompt.MaxActivationDistance,
						5
					)

				if (
					root.Position
					- currentPromptPosition
				).Magnitude
					> maxDistance - 0.5 then

					teleportToPosition(
						currentPromptPosition
						+ Vector3.new(
							0,
							1,
							0
						)
					)

					task.wait(
						CHEST_ARRIVAL_DELAY
					)
				end
			end

			firePrompt(
				prompt
			)
		end

		if getLootDropChildCount()
			> beforeLootCount then

			opened =
				true

			break
		end

		task.wait(
			CHEST_OPEN_RETRY_INTERVAL
		)
	end

	if not opened
		and getLootDropChildCount()
			> beforeLootCount then

		opened =
			true
	end

	if not opened then
		return false
	end

	local lootWaitUntil =
		os.clock()
		+ LOOT_FIRST_SPAWN_TIMEOUT

	while Runtime.alive
		and farmEnabled
		and os.clock() < lootWaitUntil do

		if getLootDropChildCount()
			> beforeLootCount then

			break
		end

		task.wait(0.03)
	end

	return true
end


local function lootDropHasPayload(drop)
	if not drop then
		return false
	end

	for _, child in ipairs(drop:GetChildren()) do

		if child.Name ~= "LootDropPrompt" then

			if child:IsA("BasePart")
				or child:IsA("Model") then

				return true
			end

			if child:FindFirstChildWhichIsA("BasePart", true)
				or child:FindFirstChildWhichIsA("Model", true) then

				return true
			end
		end
	end

	return false
end


local function getLootEntries()
	local lootFolder = workspace:FindFirstChild("LootDrops")
	if not lootFolder then
		return {}
	end

	local entries = {}

	for _, drop in ipairs(lootFolder:GetChildren()) do
		local prompt = drop:FindFirstChild("LootDropPrompt", true)

		if prompt
			and prompt:IsA("ProximityPrompt")
			and lootDropHasPayload(drop) then

			table.insert(entries, {
				drop = drop,
				prompt = prompt
			})
		end
	end

	return entries
end

local function collectSingleLoot(entry)
	if not entry then
		return
	end

	local drop = entry.drop
	local prompt = entry.prompt

	if not drop
		or not drop.Parent
		or not prompt
		or not prompt.Parent then

		return
	end


	local position =
		getObjectPosition(prompt.Parent)
		or getObjectPosition(drop)

	if not position then
		return
	end


	teleportToPosition(
		position
		+ Vector3.new(
			0,
			2,
			0
		)
	)


	task.wait(LOOT_ARRIVAL_DELAY)


	local timeoutAt =
		os.clock()
		+ LOOT_COLLECT_TIMEOUT

	local nextRetry = 0


	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and drop.Parent
		and prompt.Parent
		and os.clock() < timeoutAt do


		if not isPlayerAlive() then
			waitForCharacterReady()

			if drop.Parent then
				local newPosition =
					getObjectPosition(prompt.Parent)
					or getObjectPosition(drop)

				if newPosition then
					teleportToPosition(
						newPosition
						+ Vector3.new(0, 2, 0)
					)

					task.wait(
						LOOT_ARRIVAL_DELAY
					)
				end
			end
		end


		local now =
			os.clock()


		if now >= nextRetry then

			firePrompt(prompt)

			nextRetry =
				now
				+ LOOT_RETRY_INTERVAL
		end


		if not drop.Parent
			or not prompt.Parent then

			break
		end


		task.wait(0.02)
	end


	task.wait(0.01)
end


local function collectFastLootBatch()
	local fired =
		0

	local jobs =
		{}

	for _, entry in ipairs(
		getLootEntries()
	) do

		local drop =
			entry.drop

		local prompt =
			entry.prompt

		if drop
			and drop.Parent
			and prompt
			and prompt.Parent then

			fired += 1

			table.insert(
				jobs,
				function()

					if not prompt.Parent then
						return
					end

					local oldDistance =
						prompt.MaxActivationDistance

					local oldLOS =
						prompt.RequiresLineOfSight

					local oldHold =
						prompt.HoldDuration


					if FAST_LOOT_IGNORE_DISTANCE then

						pcall(function()
							prompt.MaxActivationDistance =
								math.huge

							prompt.RequiresLineOfSight =
								false

							prompt.HoldDuration =
								0
						end)
					end


					firePrompt(
						prompt
					)


					if prompt.Parent then

						pcall(function()
							prompt.MaxActivationDistance =
								oldDistance

							prompt.RequiresLineOfSight =
								oldLOS

							prompt.HoldDuration =
								oldHold
						end)
					end
				end
			)
		end
	end


	for _, job in ipairs(jobs) do
		task.spawn(job)
	end


	return fired
end


local function collectFastLootTeleportSweep()
	local timeoutAt =
		os.clock()
		+ FAST_LOOT_SWEEP_TIMEOUT

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do

		local entries =
			getLootEntries()

		if #entries == 0 then
			return
		end

		for _, entry in ipairs(entries) do

			if not Runtime.alive
				or not farmEnabled
				or deliveryBusy then

				return
			end

			local drop =
				entry.drop

			local prompt =
				entry.prompt

			if drop
				and drop.Parent
				and prompt
				and prompt.Parent then

				local position =
					getObjectPosition(
						prompt.Parent
					)
					or getObjectPosition(
						drop
					)

				if position then

					teleportToPosition(
						position
						+ Vector3.new(
							0,
							2,
							0
						)
					)

					task.wait(0.02)

					if prompt.Parent then
						firePrompt(prompt)
					end

					task.wait(
						FAST_LOOT_TELEPORT_DELAY
					)
				end
			end
		end

		task.wait(
			FAST_LOOT_BATCH_INTERVAL
		)
	end
end


local function collectFastLoot()
	local delayUntil =
		os.clock()
		+ FAST_LOOT_INITIAL_DELAY

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < delayUntil do

		task.wait(0.02)
	end

	if not Runtime.alive
		or not farmEnabled
		or deliveryBusy then

		return
	end


	local firstLootDeadline =
		os.clock()
		+ LOOT_FIRST_SPAWN_TIMEOUT

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock()
			< firstLootDeadline do

		if #getLootEntries() > 0 then
			break
		end

		task.wait(0.02)
	end


	if not Runtime.alive
		or not farmEnabled
		or deliveryBusy then

		return
	end


	collectFastLootBatch()

	task.wait(0.08)

	collectFastLootTeleportSweep()
end


local function collectAllLoot()
	MultiFarm.setStatus(
		"Picking Loot",
		MultiFarm.Boss
	)

	if fastLootEnabled then
		collectFastLoot()
		return
	end

	local emptySince = nil
	local firstLootDeadline = os.clock() + LOOT_FIRST_SPAWN_TIMEOUT
	local hasSeenLoot = false

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy do

		if not isPlayerAlive() then
			waitForCharacterReady()
		end


		local entries =
			getLootEntries()


		if #entries == 0 then

			if not hasSeenLoot
				and os.clock()
					< firstLootDeadline then

				task.wait(0.03)
				continue
			end

			if not emptySince then
				emptySince =
					os.clock()
			end

			if os.clock() - emptySince
				>= LOOT_EMPTY_CONFIRM_TIME then

				return
			end

			task.wait(0.03)

		else

			hasSeenLoot = true
			emptySince = nil

			collectSingleLoot(
				entries[1]
			)
		end
	end
end


function MultiFarm.collectFollowerLoot(waitTime)
	if MultiFarm.LootBusy then
		return false
	end

	if not MultiFarm.Enabled
		or MultiFarm.Target == "None"
		or MultiFarm.Target == "" then

		return false
	end

	local leader =
		MultiFarm.getLeader()

	if not leader then
		return false
	end

	local leaderState =
		tostring(
			leader.state or ""
		)

	if leaderState ~= "Open Chest"
		and leaderState ~= "Picking Loot" then

		return false
	end

	MultiFarm.LootBusy =
		true

	MultiFarm.RewardBusy =
		true

	local timeoutAt =
		os.clock()
		+ (
			waitTime
			or LOOT_FIRST_SPAWN_TIMEOUT
		)

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do

		if #getLootEntries() > 0 then
			break
		end

		leader =
			MultiFarm.getLeader()

		if not leader then
			break
		end

		leaderState =
			tostring(
				leader.state or ""
			)

		if leaderState ~= "Open Chest"
			and leaderState ~= "Picking Loot" then

			if #getLootEntries() == 0 then
				break
			end
		end

		task.wait(0.03)
	end

	local hasLoot =
		#getLootEntries() > 0

	if hasLoot
		and Runtime.alive
		and farmEnabled
		and not deliveryBusy then

		MultiFarm.setStatus(
			"Picking Loot",
			tostring(
				leader
				and leader.boss
				or MultiFarm.Boss
				or ""
			)
		)

		collectAllLoot()
	end

	MultiFarm.LootBusy =
		false

	MultiFarm.RewardBusy =
		false

	return hasLoot
end


local function handleBossRewards(deathPosition)
	if not farmEnabled then
		return
	end

	local timeoutAt =
		os.clock()
		+ BOSS_REWARD_WAIT_TIMEOUT

	if MultiFarm.isFollower() then

		while Runtime.alive
			and farmEnabled
			and not deliveryBusy
			and os.clock() < timeoutAt do

			if #getLootEntries() > 0 then

				collectAllLoot()

				return
			end


			local leader =
				MultiFarm.getLeader()

			if leader then

				local leaderState =
					tostring(
						leader.state or ""
					)

				if leaderState == "Open Chest"
					or leaderState == "Picking Loot" then

					MultiFarm.setStatus(
						"Waiting Loot",
						tostring(
							leader.boss
							or MultiFarm.Boss
							or ""
						)
					)
				end
			end


			task.wait(
				CHEST_POLL_INTERVAL
			)
		end

		return
	end


	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do

		if #getLootEntries() > 0 then

			collectAllLoot()

			return
		end


		local chest =
			deathPosition
			and findNearestWorldEventsChest(
				deathPosition
			)
			or nil

		if chest then

			local opened =
				openWorldEventsChest(
					deathPosition
				)

			if opened then

				collectAllLoot()

				return
			end
		end


		task.wait(
			CHEST_POLL_INTERVAL
		)
	end
end


local function collectNearbyWorldEventChest(origin)
	if MultiFarm.isFollower() then
		return false
	end

	if not origin then
		return false
	end

	local chest =
		findNearestWorldEventsChest(
			origin
		)

	if not chest then
		return false
	end

	MultiFarm.setStatus(
		"Open Chest",
		MultiFarm.Boss
	)

	local prompt =
		waitForChestPrompt(
			chest
		)

	if not prompt then
		return false
	end

	local beforeLootCount =
		getLootDropChildCount()

	local promptPosition =
		getObjectPosition(
			prompt.Parent
		)
		or getObjectPosition(
			chest
		)

	if not promptPosition then
		return false
	end

	teleportToPosition(
		promptPosition
		+ Vector3.new(
			0,
			1,
			0
		)
	)

	task.wait(
		CHEST_ARRIVAL_DELAY
	)

	local timeoutAt =
		os.clock()
		+ CHEST_OPEN_TIMEOUT

	local opened = false

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do

		if not isPlayerAlive() then
			return false
		end

		if not chest.Parent
			or not prompt.Parent then

			opened = true
			break
		end

		if prompt.Enabled then
			firePrompt(prompt)
		end

		if getLootDropChildCount()
			> beforeLootCount then

			opened = true
			break
		end

		task.wait(
			CHEST_OPEN_RETRY_INTERVAL
		)
	end

	if not opened
		and getLootDropChildCount()
			> beforeLootCount then

		opened = true
	end

	if not opened then
		return false
	end

	collectAllLoot()

	return true
end


local function getCrowQuestHolder()
	local playerGui =
		LocalPlayer:FindFirstChild(
			"PlayerGui"
		)

	if not playerGui then
		return nil
	end

	local componentsHolder =
		playerGui:FindFirstChild(
			"ComponentsHolder"
		)

	if not componentsHolder then
		return nil
	end

	local dialogueContent =
		componentsHolder:FindFirstChild(
			"DialogueContent"
		)

	if not dialogueContent then
		return nil
	end

	if dialogueContent:IsA("GuiObject")
		and not dialogueContent.Visible then

		return nil
	end

	local frame =
		dialogueContent:FindFirstChild(
			"Frame"
		)

	if not frame then
		return nil
	end

	if frame:IsA("GuiObject")
		and not frame.Visible then

		return nil
	end

	local listMask =
		frame:FindFirstChild(
			"ListMask"
		)

	if not listMask then
		return nil
	end

	local actualHolder =
		listMask:FindFirstChild(
			"ActualHolder"
		)

	if not actualHolder then
		return nil
	end

	return actualHolder:FindFirstChild(
		"InnerHolder"
	)
end


local function trimText(value)
	return tostring(value)
		:gsub("^%s+", "")
		:gsub("%s+$", "")
end


local function getCrowQuestData(holder)
	local result = {}

	if not holder then
		return result
	end

	for _, object in ipairs(
		holder:GetChildren()
	) do

		local id =
			string.match(
				object.Name,
				"^Hunt(%d+)$"
			)

		if id then

			local content =
				object:FindFirstChild(
					"Content"
				)

			local quest =
				content
				and content:FindFirstChild(
					"Quest"
				)

			if quest
				and (
					quest:IsA("TextLabel")
					or quest:IsA("TextButton")
					or quest:IsA("TextBox")
				) then

				local questText =
					trimText(
						quest.Text
					)

				if questText ~= "" then

					table.insert(
						result,
						{
							id = id,
							text = questText
						}
					)
				end
			end
		end
	end

	return result
end


local function waitForCrowQuestHolder()
	local timeoutAt =
		os.clock()
		+ CROW_UI_TIMEOUT

	local emptySince =
		nil

	while Runtime.alive
		and farmEnabled
		and not deliveryBusy
		and os.clock() < timeoutAt do

		local holder =
			getCrowQuestHolder()

		if holder then

			local quests =
				getCrowQuestData(
					holder
				)

			if #quests > 0 then
				return holder
			end

			if not emptySince then
				emptySince =
					os.clock()

			elseif os.clock()
					- emptySince
					>= CROW_EMPTY_UI_GRACE then

				return holder
			end

		else

			emptySince =
				nil
		end

		task.wait(
			CROW_POLL_INTERVAL
		)
	end

	return nil
end


local function findCrowQuestForBoss(holder, bossName)
	local wanted =
		string.lower(
			trimText(
				bossName
			)
		)

	for _, questData in ipairs(
		getCrowQuestData(
			holder
		)
	) do

		local target =
			string.match(
				questData.text,
				"^[Dd][Ee][Ff][Ee][Aa][Tt]%s+(.+)$"
			)

		if target then

			target =
				string.lower(
					trimText(
						target
					)
				)

			if target == wanted then
				return questData
			end
		end
	end

	return nil
end


local function claimCrowQuest(id)
	if not id then
		return false
	end

	return pcall(function()

		BossHuntsEvent:FireServer(
			"BossHuntsRequest",
			{
				action = "Claim",
				id = tostring(id)
			}
		)

	end)
end


local function closeCrowQuestAndRestoreTool()
	setEquippedSlot(1)

	task.wait(0.08)

	ensureToolOneReady(
		TOOL_READY_TIMEOUT
	)
end


local function tryAutoCrowQuest(bossName, boss)
	if not autoCrowQuestEnabled then
		return false
	end

	if CROW_SKIP_BOSSES[bossName] then
		return false
	end

	if not selectedBossSet[bossName] then
		return false
	end

	if not boss
		or not boss.Parent then

		return false
	end

	if crowHandledBosses[boss] then
		return false
	end

	crowHandledBosses[boss] =
		true

	task.wait(
		CROW_PRE_OPEN_DELAY
	)

	if not Runtime.alive
		or not farmEnabled
		or not isPlayerAlive() then

		return false
	end

	if not boss.Parent then
		return false
	end

	if not setEquippedSlot(4) then
		closeCrowQuestAndRestoreTool()
		return false
	end

	local holder =
		waitForCrowQuestHolder()

	if not holder then

		closeCrowQuestAndRestoreTool()

		return false
	end


	local matchedQuest =
		findCrowQuestForBoss(
			holder,
			bossName
		)

	local claimed =
		false

	if matchedQuest then

		claimed =
			claimCrowQuest(
				matchedQuest.id
			)

		task.wait(0.10)
	end

	closeCrowQuestAndRestoreTool()

	return claimed
end


local function processBoss(bossName)
	if deliveryBusy then
		return "paused"
	end

	MultiFarm.setStatus(
		"Traveling",
		bossName
	)

	lastBossIndex = currentBossIndex

	local boss = getLiveBoss(bossName)

	if boss then

		local bossRoot =
			getBossRoot(
				boss
			)

		local bossPosition =
			bossRoot
			and bossRoot.Position
			or getBossCenter(
				bossName
			)

		if bossPosition then

			MultiFarm.RewardBusy =
				true

			pcall(function()
				collectNearbyWorldEventChest(
					bossPosition
				)
			end)

			MultiFarm.RewardBusy =
				false

			boss =
				getLiveBoss(
					bossName
				)
		end
	end

	if not boss then
		local center =
			getBossCenter(
				bossName
			)

		if center then

			if not teleportToPosition(
				center
			) then

				return "player_died"
			end


			MultiFarm.RewardBusy =
				true

			local chestOk,
				collectedChest =
				pcall(
					collectNearbyWorldEventChest,
					center
				)

			MultiFarm.RewardBusy =
				false

			if not chestOk then
				collectedChest =
					false
			end


			if collectedChest
				and Runtime.alive
				and farmEnabled
				and isPlayerAlive() then

				teleportToPosition(
					center
				)

				task.wait(0.03)
			end


			local timeoutAt =
				os.clock()
				+ SPAWN_CHECK_WAIT


			while Runtime.alive
				and farmEnabled
				and not deliveryBusy
				and os.clock() < timeoutAt do


				if not isPlayerAlive() then
					return "player_died"
				end


				boss =
					getLiveBoss(
						bossName
					)


				if boss then
					break
				end


				task.wait(
					BOSS_SPAWN_POLL_INTERVAL
				)
			end

		else

			return "next"
		end


		if deliveryBusy then
			return "paused"
		end

		if not boss then
			return "next"
		end
	end

	if deliveryBusy then
		return "paused"
	end

	if boss
		and boss.Parent then

		if autoCrowQuestEnabled
			and not CROW_SKIP_BOSSES[
				bossName
			]
			and selectedBossSet[
				bossName
			] then

			MultiFarm.setStatus(
				"Crow Quest",
				bossName
			)
		end

		tryAutoCrowQuest(
			bossName,
			boss
		)

		if not Runtime.alive
			or not farmEnabled
			or deliveryBusy then

			return "paused"
		end


		if not isPlayerAlive() then
			return "player_died"
		end


		local refreshedBoss =
			getLiveBoss(
				bossName
			)

		if refreshedBoss then
			boss =
				refreshedBoss
		end
	end


	MultiFarm.setStatus(
		"Attacking",
		bossName
	)

	local result, deathPosition =
		fightBoss(
			bossName,
			boss
		)

	if result == "player_died" then
		return "player_died"
	end

	if result == "paused" then
		return "paused"
	end

	if result == "boss_lost" then
		return "retry"
	end

	if result == "boss_dead" then

		MultiFarm.RewardBusy =
			true

		local rewardOk,
			rewardError =
			pcall(
				handleBossRewards,
				deathPosition
			)

		MultiFarm.RewardBusy =
			false

		if not rewardOk then
			warn(
				"[Boss Reward] "
				.. tostring(
					rewardError
				)
			)
		end

		return "next"
	end

	return "next"
end


local SKILL_KEY_ORDER = {
	"Z",
	"X",
	"C",
	"V",
	"B"
}


local function keyNameToCode(name)
	if name == "Z" then
		return Enum.KeyCode.Z
	elseif name == "X" then
		return Enum.KeyCode.X
	elseif name == "C" then
		return Enum.KeyCode.C
	elseif name == "V" then
		return Enum.KeyCode.V
	elseif name == "B" then
		return Enum.KeyCode.B
	end

	return nil
end


local function applyAutoSkillSelection(valueTable)
	selectedAutoSkillKeys = {}

	if type(valueTable) ~= "table" then
		return
	end

	for _, keyName in ipairs(SKILL_KEY_ORDER) do
		if valueTable[keyName] then
			local keyCode = keyNameToCode(keyName)

			if keyCode then
				table.insert(
					selectedAutoSkillKeys,
					keyCode
				)
			end
		end
	end
end


local function applyClanSkillSelection(valueTable)
	if updatingClanDropdown then
		return
	end

	if type(valueTable) ~= "table" then
		selectedClanSkillName = nil
		selectedClanSkillKey = nil
		return
	end


	local selectedNames = {}

	for _, keyName in ipairs({
		"Z",
		"X",
		"C"
	}) do

		if valueTable[keyName] then
			table.insert(
				selectedNames,
				keyName
			)
		end
	end


	if #selectedNames == 0 then

		selectedClanSkillName = nil
		selectedClanSkillKey = nil

		return
	end


	local chosenName = nil


	if #selectedNames == 1 then

		chosenName =
			selectedNames[1]

	else

		for _, keyName in ipairs(
			selectedNames
		) do

			if keyName
				~= selectedClanSkillName then

				chosenName =
					keyName

				break
			end
		end


		chosenName =
			chosenName
			or selectedNames[
				#selectedNames
			]
	end


	selectedClanSkillName =
		chosenName

	selectedClanSkillKey =
		keyNameToCode(
			chosenName
		)


	if #selectedNames > 1
		and clanSkillDropdown
		and clanSkillDropdown.SetValue then

		updatingClanDropdown =
			true

		clanSkillDropdown:SetValue({
			[chosenName] = true
		})

		updatingClanDropdown =
			false
	end
end


local function applyBossSelection(valueTable)
	local newSet = {}

	if type(valueTable) == "table" then
		for bossName, state in pairs(valueTable) do
			if state then
				newSet[tostring(bossName)] = true
			end
		end
	end

	local newOrder = {}

	for _, bossName in ipairs(selectedBossOrder) do
		if newSet[bossName] then
			table.insert(newOrder, bossName)
			newSet[bossName] = "kept"
		end
	end

	for _, bossName in ipairs(getActiveNpcNames()) do
		if newSet[bossName] == true then
			table.insert(newOrder, bossName)
			newSet[bossName] = "kept"
		end
	end

	selectedBossSet = {}
	selectedBossOrder = newOrder

	for _, bossName in ipairs(newOrder) do
		selectedBossSet[bossName] = true
	end

	currentBossIndex = 1
	lastBossIndex = 1
end


local function setFarmEnabled(state)
	if not Runtime.alive then
		return
	end

	farmEnabled = state == true

	if not farmEnabled then

		MultiFarm.setStatus(
			"Idle",
			""
		)

		destroyFollow()

	else

		MultiFarm.setStatus(
			"Ready",
			""
		)

		task.spawn(function()
			setEquippedToOne()
		end)


		currentBossIndex =
			lastBossIndex
	end
end


local function getUiParent()
	if typeof(gethui) == "function" then
		local ok, hui =
			pcall(gethui)

		if ok and hui then
			return hui
		end
	end

	local ok, coreGui =
		pcall(function()
			return game:GetService("CoreGui")
		end)

	if ok and coreGui then
		return coreGui
	end

	return LocalPlayer:WaitForChild(
		"PlayerGui"
	)
end


local function getResponsiveWindowSize()
	local camera =
		workspace.CurrentCamera

	local viewport =
		camera
		and camera.ViewportSize
		or Vector2.new(800, 600)

	local isMobile =
		UserInputService.TouchEnabled

	if not isMobile then
		return
			UDim2.fromOffset(580, 460),
			160,
			false
	end

	local width =
		math.max(
			280,
			math.min(
				520,
				viewport.X - 20
			)
		)

	local height =
		math.max(
			260,
			math.min(
				420,
				viewport.Y - 80
			)
		)

	return
		UDim2.fromOffset(
			math.floor(width),
			math.floor(height)
		),
		90,
		true
end


