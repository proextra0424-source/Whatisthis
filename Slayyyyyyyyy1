	local dragging =
		false

	local dragged =
		false

	local dragInput =
		nil

	local dragStart =
		nil

	local startAbsolute =
		nil


	local function getViewport()
		local camera =
			workspace.CurrentCamera

		return
			camera
			and camera.ViewportSize
			or Vector2.new(800, 600)
	end


	local function clampButton()
		if not button.Parent then
			return
		end

		local viewport =
			getViewport()

		local absolute =
			button.AbsolutePosition

		local x =
			math.clamp(
				absolute.X,
				0,
				math.max(
					0,
					viewport.X
					- button.AbsoluteSize.X
				)
			)

		local y =
			math.clamp(
				absolute.Y,
				0,
				math.max(
					0,
					viewport.Y
					- button.AbsoluteSize.Y
				)
			)

		button.Position =
			UDim2.fromOffset(
				x,
				y
			)
	end


	runtimeConnect(
		button.InputBegan,
		function(input)

			if input.UserInputType
					== Enum.UserInputType.Touch
				or input.UserInputType
					== Enum.UserInputType.MouseButton1 then

				dragging =
					true

				dragged =
					false

				dragStart =
					input.Position

				startAbsolute =
					button.AbsolutePosition
			end
		end
	)


	runtimeConnect(
		button.InputChanged,
		function(input)

			if input.UserInputType
					== Enum.UserInputType.Touch
				or input.UserInputType
					== Enum.UserInputType.MouseMovement then

				dragInput =
					input
			end
		end
	)


	runtimeConnect(
		UserInputService.InputChanged,
		function(input)

			if not dragging
				or input ~= dragInput
				or not dragStart
				or not startAbsolute then

				return
			end


			local delta =
				input.Position
				- dragStart


			if delta.Magnitude > 6 then
				dragged =
					true
			end


			local viewport =
				getViewport()

			local x =
				math.clamp(
					startAbsolute.X
						+ delta.X,
					0,
					math.max(
						0,
						viewport.X
						- button.AbsoluteSize.X
					)
				)

			local y =
				math.clamp(
					startAbsolute.Y
						+ delta.Y,
					0,
					math.max(
						0,
						viewport.Y
						- button.AbsoluteSize.Y
					)
				)


			button.Position =
				UDim2.fromOffset(
					x,
					y
				)
		end
	)


	runtimeConnect(
		UserInputService.InputEnded,
		function(input)

			if input.UserInputType
					== Enum.UserInputType.Touch
				or input.UserInputType
					== Enum.UserInputType.MouseButton1 then

				dragging =
					false

				task.defer(
					clampButton
				)
			end
		end
	)


	runtimeConnect(
		button.Activated,
		function()

			if dragged then
				dragged =
					false

				return
			end


			Window.Minimized =
				not Window.Minimized

			Window.Root.Visible =
				not Window.Minimized

			button.Text =
				Window.Minimized
				and "OPEN"
				or "HIDE"
		end
	)


	local camera =
		workspace.CurrentCamera

	if camera then
		runtimeConnect(
			camera:GetPropertyChangedSignal(
				"ViewportSize"
			),
			function()
				task.defer(
					clampButton
				)
			end
		)
	end
end


local function applyResponsiveWindowLayout(Window, isMobile)
	if not isMobile then
		return
	end

	local camera =
		workspace.CurrentCamera

	if not camera then
		return
	end


	local function update()
		if not Runtime.alive
			or not Window
			or not Window.Root
			or not Window.Root.Parent then

			return
		end

		local viewport =
			camera.ViewportSize

		local width =
			math.max(
				280,
				math.min(
					520,
					viewport.X - 20
				)
			)

		local height =
			math.max(
				260,
				math.min(
					420,
					viewport.Y - 80
				)
			)

		local size =
			UDim2.fromOffset(
				math.floor(width),
				math.floor(height)
			)

		local position =
			UDim2.fromOffset(
				math.floor(
					(viewport.X - width)
					/ 2
				),
				math.floor(
					math.max(
						8,
						(viewport.Y - height)
						/ 2
					)
				)
			)


		Window.Size =
			size

		Window.Position =
			position

		Window.Root.Size =
			size

		Window.Root.Position =
			position
	end


	update()


	runtimeConnect(
		camera:GetPropertyChangedSignal(
			"ViewportSize"
		),
		function()
			task.defer(
				update
			)
		end
	)
end




