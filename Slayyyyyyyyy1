                                wait(1)
                            end
                        end

                        if roundReady then
                            local targetModel, targetHumanoid = findNearestEnemy()
                            if targetModel and targetHumanoid then
                                noTargetSince = nil
                                punchTarget(targetModel, targetHumanoid)
                            else
                                -- Keep scanning during the short gap between Boss Rush mobs.
                                -- Only restart after the arena marker is gone and no target has
                                -- appeared for 10 seconds, preventing another 40-second wait
                                -- between consecutive mobs in the same run.
                                noTargetSince = noTargetSince or tick()
                                if not workspace:FindFirstChild("Spire")
                                    and tick() - noTargetSince >= 10 then
                                    roundReady = false
                                    noTargetSince = nil
