end


local function setBossSelected(bossName, state)
	bossName = tostring(bossName)

	if state then

		if not selectedBossSet[bossName] then

			selectedBossSet[bossName] =
				true

			table.insert(
				selectedBossOrder,
				bossName
			)
		end

	else

		selectedBossSet[bossName] =
			nil

		for index, name
			in ipairs(selectedBossOrder) do

			if name == bossName then

				table.remove(
					selectedBossOrder,
					index
				)

				break
			end
		end
	end


	currentBossIndex = 1
	lastBossIndex = 1

end


