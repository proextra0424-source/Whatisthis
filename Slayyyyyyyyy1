		if not autoDeliveryEnabled then

			MultiFarm.LeaderDeliveryLatched =
				false

			task.wait(0.10)
			continue
		end


		if deliveryBusy then
			task.wait(0.05)
			continue
		end


		if MultiFarm.RewardBusy
			or MultiFarm.LootBusy then

			task.wait(0.05)
			continue
		end


		if MultiFarm.isFollower() then

			local leader =
				MultiFarm.getLeader()

			if not leader then

				MultiFarm.LeaderDeliveryLatched =
					false

				task.wait(0.10)
				continue
			end


			local leaderState =
				tostring(
					leader.state or ""
				)


			if leaderState == "Delivery" then

				if Delivery.hasActiveCrowQuest() then

					task.wait(0.10)
					continue
				end


				if not MultiFarm.LeaderDeliveryLatched then

					local started =
						Delivery.runAutoDeliveryQuest()

					if started then
						MultiFarm.LeaderDeliveryLatched =
							true
					end
				end

			else

				MultiFarm.LeaderDeliveryLatched =
					false
			end


			task.wait(0.05)
			continue
		end


		local now =
			os.clock()

		if now < nextDeliveryAt then
			task.wait(
				math.min(
					0.10,
					nextDeliveryAt
						- now
				)
			)

			continue
		end


		if Delivery.hasActiveCrowQuest() then
			task.wait(0.10)
			continue
		end


		local success =
			Delivery.runAutoDeliveryQuest()


		if success then

			nextDeliveryAt =
				os.clock()
				+ (
					farmEnabled
						and 25
						or 23
				)

		else

			nextDeliveryAt =
				os.clock()
				+ 1
		end


		task.wait(0.05)
	end
