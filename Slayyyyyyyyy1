                    local roundReady = false
                    local noTargetSince = nil
                    while AutoBRPunch_Active and AutoBRPunch_RunId == runId do
                        if not roundReady then
                            if not workspace:FindFirstChild("Spire") then
                                roundReady = startPunchBossRush()
                                noTargetSince = nil
