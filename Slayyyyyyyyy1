local function destroyOldUI()
	local existingRuntime = ENV[RUNTIME_KEY]

	if existingRuntime
		and existingRuntime.fluent then

		pcall(function()
			existingRuntime.fluent:Destroy()
		end)
	end

	local containers = {}

	if typeof(gethui) == "function" then
		local ok, hui =
			pcall(gethui)

		if ok and hui then
			table.insert(
				containers,
				hui
			)
		end
	end

	pcall(function()
		table.insert(
			containers,
			game:GetService("CoreGui")
		)
	end)

	local player =
		game:GetService("Players").LocalPlayer

	if player then
		local playerGui =
			player:FindFirstChild("PlayerGui")

		if playerGui then
			table.insert(
				containers,
				playerGui
			)
		end
	end


	for _, container in ipairs(containers) do

		local oldGui =
			container:FindFirstChild("imgui")

		if oldGui then
			pcall(function()
				oldGui:Destroy()
			end)
		end

		local oldMobileGui =
			container:FindFirstChild(
				"Slayer2MobileToggleGui"
			)

		if oldMobileGui then
			pcall(function()
				oldMobileGui:Destroy()
			end)
		end
	end
end


