	autoDeliveryEnabled = false
	deliveryBusy = false
	bossProcessBusy = false
	setAntiAfk(false)

	MultiFarm.LootBusy =
		false

	MultiFarm.RewardBusy =
		false

	MultiFarm.LeaderDeliveryLatched =
		false

	pcall(function()
		MultiFarm.cleanup()
	end)

	pcall(function()
		destroyFollow()
	end)

	local character =
		LocalPlayer.Character

	local root =
		character
		and character:FindFirstChild(
			"HumanoidRootPart"
		)

	if root then
		for _, name in ipairs({
			"_BossFarmAttachment",
			"_BossFarmPosition",
			"_BossFarmOrientation"
		}) do

			local object =
				root:FindFirstChild(name)

			if object then
				pcall(function()
					object:Destroy()
				end)
			end
		end
	end

	if Runtime.fluent then

		pcall(function()
			Runtime.fluent:Destroy()
		end)

		Runtime.fluent = nil
	end

	if mobileToggleGui then
		pcall(function()
			mobileToggleGui:Destroy()
		end)

		mobileToggleGui = nil
		mobileToggleButton = nil
	end

	destroyOldUI()
end


