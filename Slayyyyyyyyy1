	if oldRuntime.connections then

		for _, connection
			in ipairs(oldRuntime.connections) do

			pcall(function()
				connection:Disconnect()
			end)
		end
	end

	if oldRuntime.cleanup then
		pcall(
			oldRuntime.cleanup
		)
	end
end


