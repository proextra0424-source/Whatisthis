                        if AutoBRExtreme_Active and AutoBRExtreme_RunId == runId then
                            ReplicatedStorage.Remotes.ClientToServer.BossStart:FireServer(unpack(args))
                        end
                    end
                end

                local function CheckAndRestartBRExtreme()
                    while AutoBRExtreme_Active and AutoBRExtreme_RunId == runId do
                        if not workspace:FindFirstChild("Spire") then
                            StartAutoBRExtreme()
                        end
                        wait(5)
                    end
                end

                local function FollowExtremeMortarMarkers()
                    local handledMarkers = setmetatable({}, {__mode = "k"})

                    while AutoBRExtreme_Active and AutoBRExtreme_RunId == runId do
                        local marker, markerPart = getExtremeMortarMarker()

                        if marker and markerPart and not handledMarkers[marker] then
                            handledMarkers[marker] = true

                            for _ = 1, 5 do
                                if not AutoBRExtreme_Active or AutoBRExtreme_RunId ~= runId then
                                    return
                                end

                                local currentMarker, currentPart = getExtremeMortarMarker()
                                if currentMarker ~= marker or not currentPart then
                                    break
                                end

                                local character = LocalPlayer.Character
                                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                                if rootPart then
                                    if BossRushRecovery then BossRushRecovery:YieldForMechanic(1.25) end
                                    rootPart.CFrame = currentPart.CFrame
                                end

                                wait(1)
                            end
                        else
                            wait(1)
                        end
                    end
                end

                if not workspace:FindFirstChild("Spire") then StartAutoBRExtreme() end
                spawn(CheckAndRestartBRExtreme)
                spawn(FollowExtremeMortarMarkers)
            end

            local AutoRelic_Active = false
            local function AutoRelic(state)
                AutoRelic_Active = state
                
                while AutoRelic_Active do
                    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                    local trinketsFolder = workspace:FindFirstChild("Game") and 
                                        workspace.Game:FindFirstChild("Trinkets") and 
