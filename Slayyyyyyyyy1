function Delivery.requestDeliveryStream(position)
	if not position then
		return false
	end

	if not workspace.StreamingEnabled then
		return true
	end

	local finished =
		false

	task.spawn(function()
		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(
				position,
				DELIVERY_STREAM_TIMEOUT
			)
		end)

		finished =
			true
	end)

	local timeoutAt =
		os.clock()
		+ DELIVERY_STREAM_TIMEOUT

	while Runtime.alive
		and autoDeliveryEnabled
		and not finished
		and os.clock() < timeoutAt do

		task.wait(0.05)
	end

	if not Runtime.alive
		or not autoDeliveryEnabled then

		return false
	end

	task.wait(
		DELIVERY_STREAM_SETTLE_DELAY
	)

	return true
end


