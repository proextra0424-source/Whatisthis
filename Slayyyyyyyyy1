		playerGui
		and playerGui:FindFirstChild(
			"ComponentsHolder"
		)

	local leftCenter =
		components
		and components:FindFirstChild(
			"LeftCenterFramesHolder"
		)

	local questsFrame =
		leftCenter
		and leftCenter:FindFirstChild(
			"zQuestsFrame"
		)

	local panel =
		questsFrame
		and questsFrame:FindFirstChild(
			"Panel"
		)

	if not panel then
