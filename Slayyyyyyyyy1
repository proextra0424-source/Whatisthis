                    end
                
                    local function step()
                        if not enabled or destroyed then return end
                        if deps.isOtherFarmActive and deps.isOtherFarmActive() then
                            controller:SetEnabled(false, "Another farm mode is active. Disable it before using Auto Farm Near.")
                            return
                        end
                        local character, _, root = localCharacter()
                        if not character then rememberForRespawn(); return end
                        if root.Anchored then clearBinding(); return end
                        if resumePending then
                            if resumeCharacter ~= character then
                                resumeCharacter = character
                                resumeReadyAt = clock() + config.respawnDelay
                            end
                            if clock() < resumeReadyAt then
                                reportPunch("waiting_respawn")
                                return
                            end
                            resumePending = false
                            resumeCharacter, resumeReadyAt = nil, nil
                            restoreRememberedTarget()
                        end
                        bindCharacter(root)
                        local folder = npcFolder()
                        if target then
                            local validHumanoid, validRoot = farmParts(target, folder)
                            if validHumanoid ~= targetHumanoid or validRoot ~= targetRoot then
                                clearTarget()
                            end
                        end
                        if not target then
                            target, targetHumanoid, targetRoot = nextFarmTarget(folder, root)
                            if not target then releaseForward(); return end
                        end
                        forwardKey(true)
                        root.CFrame = CFrame.new(hoverPoint(targetRoot), targetRoot.Position)
                        if targetHumanoid.Health <= 0 then clearTarget() end
                    end
                
                    function controller:SetEnabled(state, reason)
                        state = state == true and not destroyed
                        if state == enabled then return end
                        if state and externalAttackOwner then
                            announce(false, "Disable the active boss farm before Near.")
                            return
                        end
                        if state and deps.isOtherFarmActive and deps.isOtherFarmActive() then
                            announce(false, "Disable the other farm mode before enabling Auto Farm Near.")
                            return
                        end
                        enabled = state
                        rememberedTarget, resumeCharacter, resumeReadyAt = nil, nil, nil
                        resumePending = false
                        attackFault = false
                        stopAttack()
                        if heartbeat then heartbeat:Disconnect(); heartbeat = nil end
                        clearTarget()
                        clearBinding()
                        scanModels, scanFolder = nil, nil
                        if enabled then
                            heartbeat = runService.Heartbeat:Connect(function()
                                local ok, err = pcall(step)
                                if not ok then controller:SetEnabled(false, "Auto Farm Near stopped: " .. tostring(err)) end
                            end)
                        end
                        reportPunch(waitingPunchReason())
                        startAttack()
                        announce(enabled, reason)
                    end
                
                    function controller:SetAutoPunch(state, reason)
                        if destroyed then return false end
                        state = state == true
                        if state == config.autoPunch then return true end
                        config.autoPunch = state
                        attackFault = false
                        stopAttack()
                        reportPunch(waitingPunchReason())
                        startAttack()
                        if deps.onPunchEnabledChanged then
                            local ok, err = pcall(deps.onPunchEnabledChanged, state, reason)
                            if not ok and deps.warn then deps.warn("Auto Punch: " .. tostring(err)) end
                        end
                        if reason and deps.warn then deps.warn(reason) end
                        return true
                    end
                
                    function controller:SetConfig(key, value)
                        if destroyed then return false end
                        if key == "offset" then
                            value = tonumber(value)
                            if not value or value ~= value or value == math.huge or value == -math.huge then return false end
                            config.offset = math.max(-20, math.min(20, value))
                        elseif key == "position" then
                            if value ~= "Above/Below" and value ~= "Front/Behind" then return false end
                            config.position = value
                        elseif key == "punchSpeed" then
                            value = tonumber(value)
                            if not value or value ~= value or value < 0.1 or value > 1 then return false end
                            config.punchSpeed = value
                        elseif key == "punchType" then
                            if value ~= "Normal" and value ~= "Slam" then return false end
                            config.punchType = value
                        elseif key == "autoPunch" and type(value) == "boolean" then
                            return controller:SetAutoPunch(value)
                        else
                            return false
                        end
                        return true
                    end
                
                    function controller:GetTarget() return target end
                    function controller:IsEnabled() return enabled end
                    function controller:GetSelectedSkills()
                        local result = {}
                        for index, name in ipairs(selectedSkills) do result[index] = name end
                        return result
                    end
                    function controller:ToggleSkill(name)
                        if destroyed or not allowedSkills[name] then return false end
                        for index, value in ipairs(selectedSkills) do
                            if value == name then table.remove(selectedSkills, index); return true end
                        end
                        selectedSkills[#selectedSkills + 1] = name
                        return true
                    end
                    function controller:SetAutoSkill(state, reason)
                        state = state == true and not destroyed
                        if state == skillEnabled then return end
                        skillEnabled = state
                        stopSkill()
                        if skillEnabled then startSkill() end
                        if deps.onSkillEnabledChanged then
                            local ok, err = pcall(deps.onSkillEnabledChanged, skillEnabled, reason)
                            if not ok and deps.warn then deps.warn(tostring(err)) end
                        end
                    end
                    function controller:IsAutoSkillEnabled() return skillEnabled end
                    function controller:Destroy()
                        if destroyed then return end
                        if controller.eventBossController then
                            controller.eventBossController:Destroy()
                            controller.eventBossController = nil
                        end
                        if controller.dullahanController then
                            controller.dullahanController:Destroy()
                            controller.dullahanController = nil
                        end
                        if controller.thorController then
                            controller.thorController:Destroy()
                            controller.thorController = nil
                        end
                        if controller.recoveryController then
                            controller.recoveryController:Destroy()
                            controller.recoveryController = nil
                        end
                        controller:SetEnabled(false)
                        controller:SetAutoSkill(false)
                        controller:SetAutoPunch(false)
                        stopAttack()
                        stopSkill()
                        externalAttackOwner, externalAttackTarget, externalAttackMode = nil, nil, nil
                        destroyed = true
                        if removingConnection then removingConnection:Disconnect(); removingConnection = nil end
                        if controller.uiConnection then controller.uiConnection:Disconnect(); controller.uiConnection = nil end
                        clearTarget()
                        clearBinding()
                    end
                    removingConnection = localPlayer.CharacterRemoving:Connect(function(oldCharacter)
                        retiringCharacter = oldCharacter or localPlayer.Character
                        stopAttack()
                        attackFault = false
                        if enabled then
                            rememberForRespawn()
                        else
                            clearTarget()
                            clearBinding()
                        end
                        scanModels, scanFolder = nil, nil
                        stopSkill()
                        startAttack()
                        startSkill()
                    end)
                    return controller
                end
                
                
                -- Boss Rush only: zero HP continuously for 10 seconds -> hold 10 studs above.
                -- Skill presses remain owned by the existing selected-key Auto Skill worker.
                local function createBossRushRecoveryController(deps)
                    local controller = {}
                    local world, player, players = deps.Workspace, deps.LocalPlayer, deps.Players
                    local clock, makeInstance = deps.clock or os.clock, deps.newInstance or Instance.new
                    local observations = setmetatable({}, { __mode = "k" })
                    local locked, hover, home
                    local destroyed, nextScan, pauseUntil = false, 0, 0
                    local heartbeat, characterRemoving
                
                    local function folder()
                        local gameFolder = world:FindFirstChild("Game")
                        return gameFolder and gameFolder:FindFirstChild("Players")
                    end
                
                    local function npcParts(humanoid, npcFolder)
                        if not npcFolder or not humanoid or not humanoid.Parent or not humanoid:IsDescendantOf(npcFolder) then return nil end
                        local model, current = nil, humanoid.Parent
                        while current and current ~= npcFolder do
                            if current:IsA("Model") then
                                if current == player.Character or players:GetPlayerFromCharacter(current) then return nil end
                                model = model or current
                            end
                            current = current.Parent
                        end
                        if not model then return nil end
                        local root = humanoid.RootPart or model:FindFirstChild("HumanoidRootPart")
                        if root and root:IsA("BasePart") and root:IsDescendantOf(model) then return model, root end
                        return nil
                    end
                
                    local function localParts()
                        local character = player.Character
                        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                        local root = character and character:FindFirstChild("HumanoidRootPart")
                        if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") and not root.Anchored then
                            return character, humanoid, root
                        end
                        return nil
                    end
                
                    local function cleanupHover()
                        local old = hover
                        hover = nil
                        if not old then return end
                        for _, object in ipairs(old.objects) do object:Destroy() end
                        if old.humanoid.Parent then old.humanoid.AutoRotate = old.autoRotate end
                    end
                
                    local function finishTarget(restore)
                        cleanupHover()
                        if restore and home and player.Character == home.character and home.humanoid.Parent
                            and home.humanoid.Health > 0 and home.root.Parent
                            and home.character:FindFirstChild("HumanoidRootPart") == home.root then
                            home.root.CFrame = home.cframe
                        end
                        locked, home = nil, nil
                    end
                
                    function controller:Reset(restore)
                        finishTarget(restore ~= false)
                        observations = setmetatable({}, { __mode = "k" })
                        nextScan, pauseUntil = 0, 0
                    end
                
                    function controller:YieldForMechanic(duration)
                        if destroyed then return end
                        pauseUntil = math.max(pauseUntil, clock() + (duration or 1.25))
                        cleanupHover()
                        -- The marker loop takes over immediately. Do not warp back against it.
                        -- On resuming, the marker's new position becomes the return position.
                        home = nil
                    end
                
                    local function gatesOpen()
                        return deps.isBossRushActive() and deps.isOneShotActive()
                            and deps.isAutoSkillActive() and deps.hasSelectedSkills()
                    end
                
                    local function scan(npcFolder, playerRoot, now)
                        local seen = {}
                        local candidate, nearestDistance
                        for _, object in ipairs(npcFolder:GetDescendants()) do
                            if object:IsA("Humanoid") then
                                local model, root = npcParts(object, npcFolder)
                                if model and object.Health <= 0 then
                                    seen[object] = true
                                    local observation = observations[object]
                                    if not observation or observation.root ~= root or observation.model ~= model then
                                        observation = { humanoid = object, model = model, root = root, zeroSince = now }
                                        observations[object] = observation
                                    end
                                    if now - observation.zeroSince >= 10 then
                                        local distance = (root.Position - playerRoot.Position).Magnitude
                                        if not nearestDistance or distance < nearestDistance then
                                            candidate, nearestDistance = observation, distance
                                        end
                                    end
                                end
                            end
                        end
                        for humanoid in pairs(observations) do if not seen[humanoid] then observations[humanoid] = nil end end
                        return candidate
                    end
                
                    local function startHover(character, humanoid, root)
                        if not home then home = { character = character, humanoid = humanoid, root = root, cframe = root.CFrame } end
                        local position = locked.root.Position + Vector3.new(0, 10, 0)
                        local cframe = CFrame.lookAt(position, locked.root.Position, Vector3.zAxis)
                        local current = { character = character, humanoid = humanoid, root = root, autoRotate = humanoid.AutoRotate, objects = {} }
                        hover = current
                        local function own(class, name)
                            local object = makeInstance(class)
                            current.objects[#current.objects + 1] = object
                            object.Name = name
                            return object
                        end
                        local attachment = own("Attachment", "BossRushRecoveryAttachment")
                        attachment.Parent = root
                        local alignPosition = own("AlignPosition", "BossRushRecoveryPosition")
                        alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
                        alignPosition.Attachment0 = attachment
                        alignPosition.ApplyAtCenterOfMass = true
                        alignPosition.MaxForce = math.max(root.AssemblyMass * world.Gravity * 20, 50000)
                        alignPosition.MaxVelocity = 200
                        alignPosition.Responsiveness = 100
                        alignPosition.Position = position
                        alignPosition.Parent = root
                        local alignOrientation = own("AlignOrientation", "BossRushRecoveryOrientation")
                        alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
                        alignOrientation.Attachment0 = attachment
                        alignOrientation.MaxTorque = 100000
                        alignOrientation.MaxAngularVelocity = 50
                        alignOrientation.Responsiveness = 100
                        alignOrientation.CFrame = cframe
                        alignOrientation.Parent = root
                        current.position, current.orientation = alignPosition, alignOrientation
                        humanoid.AutoRotate = false
                        root.CFrame = cframe
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    end
                
                    local function step()
                        if destroyed then return end
                        if not gatesOpen() then controller:Reset(); return end
                        if deps.isArenaReady and not deps.isArenaReady() then controller:Reset(false); return end
                        local character, humanoid, root = localParts()
                        if not character then controller:Reset(false); return end
                        if hover and (hover.character ~= character or hover.root ~= root or hover.humanoid ~= humanoid) then
                            controller:Reset(false)
                        end
                        local npcFolder = folder()
                        if not npcFolder then controller:Reset(); return end
                        local now = clock()
                        if locked then
                            local model, targetRoot = npcParts(locked.humanoid, npcFolder)
                            if not model or model ~= locked.model or targetRoot ~= locked.root or locked.humanoid.Health > 0 then
                                observations[locked.humanoid] = nil
                                finishTarget(now >= pauseUntil)
                                nextScan = 0
                            end
                        end
                        if now >= nextScan then
                            nextScan = now + 0.1
                            local candidate = scan(npcFolder, root, now)
                            if not locked and now >= pauseUntil then locked = candidate end
                        end
                        if now < pauseUntil then return end
                        if locked then
                            if hover and (not hover.position.Parent or not hover.orientation.Parent) then cleanupHover() end
                            if not hover then startHover(character, humanoid, root) end
                            local desired = locked.root.Position + Vector3.new(0, 10, 0)
                            hover.position.Position = desired
                            hover.orientation.CFrame = CFrame.lookAt(desired, locked.root.Position, Vector3.zAxis)
                        end
                    end
                
                    function controller:GetTarget() return locked and locked.model or nil end
                    function controller:IsHovering() return hover ~= nil end
                    function controller:CanUseSkills()
                        if destroyed or not locked or not hover or not gatesOpen() or clock() < pauseUntil then return false end
                        if deps.isArenaReady and not deps.isArenaReady() then return false end
                        local character, humanoid, root = localParts()
                        if character ~= hover.character or humanoid ~= hover.humanoid or root ~= hover.root then return false end
                        if hover.position.Parent ~= root or hover.orientation.Parent ~= root then return false end
                        local model, targetRoot = npcParts(locked.humanoid, folder())
                        return model == locked.model and targetRoot == locked.root
                            and locked.humanoid.Health <= 0 and clock() - locked.zeroSince >= 10
                    end
                    function controller:Destroy()
                        if destroyed then return end
                        destroyed = true
                        if heartbeat then heartbeat:Disconnect(); heartbeat = nil end
                        if characterRemoving then characterRemoving:Disconnect(); characterRemoving = nil end
                        controller:Reset()
                    end
                    heartbeat = deps.RunService.Heartbeat:Connect(function()
                        local ok, err = pcall(step)
                        if not ok then
                            controller:Reset()
                            if deps.warn then deps.warn("Boss Rush recovery: " .. tostring(err)) end
                        end
                    end)
                    characterRemoving = player.CharacterRemoving:Connect(function() controller:Reset(false) end)
                    return controller
                end
                
                
                -- Thor detection is restricted to direct children of Game.Players, once per 5 seconds.
                -- Entry prompts use bounded spatial queries and a two-slot cache; no world traversal.
                local function createThorFarmController(deps)
                    local controller = {}
                    local world, player, players = deps.Workspace, deps.LocalPlayer, deps.Players
                    local combat, taskApi = deps.Combat, deps.task or task
                    local clock, makeInstance = deps.clock or os.clock, deps.newInstance or Instance.new
                    local checkpoints = { Vector3.new(442, 3175, -1193), Vector3.new(548, 4133, -1049) }
                    local promptRadius = 100
                    local enabled, destroyed, boss = false, false, nil
                    local phase, detail = "Off", "Off"
                    local entryTask, entryGeneration = nil, 0
                    local nextScan, nextAttempt = 0, 0
                    local needsEntry, enteredCharacter, retiringCharacter = true, nil, nil
                    local respawnHold, readyCharacter, readyAt = false, nil, nil
                    local movementRoot, mover
                    local promptCache = {}
                    local scans, promptQueries, cacheHits, entries = 0, 0, 0, 0
                    local heartbeat, removingConnection, promptConnection
                
                    function controller:GetStatus()
                        return { enabled = enabled, phase = phase, detail = detail, boss = boss and boss.Name,
                            model = boss, scans = scans, promptQueries = promptQueries, promptCacheHits = cacheHits, entries = entries }
                    end
                
                    local function status(nextPhase, message)
                        if phase == nextPhase and detail == message then return end
                        phase, detail = nextPhase, message
                        if deps.onStatusChanged then pcall(deps.onStatusChanged, controller:GetStatus()) end
                    end
                
                    local function folder()
                        local gameFolder = world:FindFirstChild("Game")
                        return gameFolder and gameFolder:FindFirstChild("Players")
                    end
                
                    local function bossParts(model)
                        if not model or model.Parent ~= folder() or not model:IsA("Model")
                            or not string.find(string.lower(model.Name), "thor", 1, true) or model == player.Character then return nil end
                        if players and players:GetPlayerFromCharacter(model) then return nil end
                        local humanoid = model:FindFirstChildOfClass("Humanoid")
                        if not humanoid or humanoid.Health <= 0 then return nil end
                        local root = model:FindFirstChild("HumanoidRootPart")
                        if root and not root:IsA("BasePart") then root = nil end
                        return humanoid, root
                    end
                
                    local function scanBoss()
                        scans = scans + 1
                        if deps.getAssignedBoss then
                            local assigned = deps.getAssignedBoss()
                            return bossParts(assigned) and assigned or nil
                        end
                        local npcFolder = folder()
                        if npcFolder then
                            for _, model in ipairs(npcFolder:GetChildren()) do
                                if bossParts(model) then return model end
                            end
                        end
                        return nil
                    end
                
                    local function localParts()
                        local character = player.Character
                        if not character or character == retiringCharacter then return nil end
                        local humanoid = character:FindFirstChildOfClass("Humanoid")
                        local root = character:FindFirstChild("HumanoidRootPart")
                        if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") and not root.Anchored then
                            return character, root
                        end
                        return nil
                    end
                
                    local function cleanupMover()
                        if mover then mover:Destroy(); mover = nil end
                        movementRoot = nil
                    end
                
                    local function cancelEntry()
                        entryGeneration = entryGeneration + 1
                        local oldTask = entryTask
                        entryTask = nil
                        if oldTask and oldTask ~= coroutine.running() then pcall(taskApi.cancel, oldTask) end
                    end
                
                    local function clearCombat()
                        combat:SetExternalAttackTarget(controller, nil)
                        cleanupMover()
                    end
                
                    local function followBoss(character, root)
                        local _, bossRoot = bossParts(boss)
                        if not bossRoot then clearCombat(); status("WaitingRoot", "Waiting for Thor root"); return end
                        if movementRoot ~= root then cleanupMover(); movementRoot = root end
                        if mover and mover.Parent ~= root then mover:Destroy(); mover = nil end
                        if not mover and not root:FindFirstChild("BodyVelocity") then
                            mover = makeInstance("BodyVelocity")
                            mover.Name = "ThorFarmVelocity"
                            mover.MaxForce = Vector3.new(9000000000, 9000000000, 9000000000)
                            mover.Velocity = Vector3.zero
                            mover.Parent = root
                        end
                        local position = bossRoot.Position + Vector3.new(0, 20, 0)
                        root.CFrame = CFrame.lookAt(position, bossRoot.Position, Vector3.zAxis)
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        combat:SetExternalAttackTarget(controller, boss)
                        status("Fighting", "Fighting " .. boss.Name)
                    end
                
                    local function promptPart(prompt)
                        if not prompt or not prompt.Parent or not prompt:IsA("ProximityPrompt") or prompt.Enabled == false then return nil end
                        local parent = prompt.Parent
                        if parent:IsA("Attachment") then parent = parent.Parent end
                        if parent and parent:IsA("BasePart") and parent:IsDescendantOf(world) then return parent end
                        return nil
                    end
                
                    local function rememberPrompt(prompt)
                        local part = promptPart(prompt)
                        if not part then return end
                        for index, point in ipairs(checkpoints) do
                            local distance = (part.Position - point).Magnitude
                            if distance <= promptRadius then
                                local oldPart = promptPart(promptCache[index])
                                if not oldPart or distance < (oldPart.Position - point).Magnitude then promptCache[index] = prompt end
                            end
                        end
                    end
                
                    local function nearestPrompt(index, root)
                        local cached = promptCache[index]
                        local cachedPart = promptPart(cached)
                        if cachedPart and (cachedPart.Position - root.Position).Magnitude <= promptRadius then cacheHits = cacheHits + 1; return cached end
                        promptCache[index] = nil
                        promptQueries = promptQueries + 1
                        local parts
                        if deps.queryParts then
                            parts = deps.queryParts(root.Position, promptRadius)
                        else
                            local params = OverlapParams.new()
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            params.FilterDescendantsInstances = player.Character and { player.Character } or {}
                            parts = world:GetPartBoundsInRadius(root.Position, promptRadius, params)
                        end
                        local closest, distance = nil, promptRadius
                        local function consider(prompt)
                            local part = promptPart(prompt)
                            if part then
                                local candidateDistance = (part.Position - root.Position).Magnitude
                                if candidateDistance <= distance then closest, distance = prompt, candidateDistance end
                            end
                        end
                        for _, part in ipairs(parts) do
                            for _, child in ipairs(part:GetChildren()) do
                                if child:IsA("ProximityPrompt") then consider(child)
                                elseif child:IsA("Attachment") then
                                    for _, prompt in ipairs(child:GetChildren()) do if prompt:IsA("ProximityPrompt") then consider(prompt) end end
                                end
                            end
                        end
                        promptCache[index] = closest
                        return closest
                    end
                
                    local function startEntry(character)
                        cancelEntry()
                        clearCombat()
                        local runId, entryBoss = entryGeneration, boss
                        local function valid()
                            local current = localParts()
                            return enabled and not destroyed and entryGeneration == runId and boss == entryBoss
                                and bossParts(entryBoss) ~= nil and current == character
                        end
                        entryTask = taskApi.spawn(function()
                            local ok, completed = pcall(function()
                                for index, point in ipairs(checkpoints) do
                                    if not valid() then return false end
                                    local _, root = localParts()
                                    status("Entering", "Entering Thor arena " .. index .. "/2")
                                    root.CFrame = CFrame.new(point)
                                    taskApi.wait(0.5)
                                    if not valid() then return false end
                                    local _, currentRoot = localParts()
                                    local prompt = nearestPrompt(index, currentRoot)
                                    if not prompt then error("No portal prompt within 100 studs of entrance " .. index, 0) end
                                    deps.firePrompt(prompt)
                                    if not valid() then return false end
                                    if index == 1 then taskApi.wait(1.5) end
                                end
                                taskApi.wait(1.5) -- Wait after entering the arena before following and attacking Thor.
                                if not valid() then return false end
                                enteredCharacter, needsEntry = character, false
                                readyCharacter, readyAt, respawnHold = nil, nil, false
                                entries = entries + 1
                                local _, root = localParts()
                                followBoss(character, root)
                                return true
                            end)
                            if entryGeneration == runId then
                                entryTask = nil
                                if not ok then
                                    clearCombat()
                                    nextAttempt = clock() + 5
                                    status("EntryRetry", tostring(completed) .. "; retry in 5 seconds")
                                    if deps.warn then deps.warn("Thor Farm: " .. tostring(completed)) end
                                end
                            end
                        end)
                        if coroutine.status(entryTask) == "dead" then entryTask = nil end
                    end
                
                    local function step()
                        if not enabled or destroyed then return end
                        if deps.isOtherFarmActive and deps.isOtherFarmActive() then
                            controller:SetEnabled(false, "Another farm mode started; Thor Farm stopped.")
                            return
                        end
                        local now = clock()
                        if boss and not bossParts(boss) then
                            cancelEntry(); clearCombat()
                            boss, enteredCharacter, needsEntry = nil, nil, true
                        end
                        if now >= nextScan then
                            nextScan = now + 5
                            if not boss then boss = scanBoss() end
                        end
                        if not boss then status("WaitingBoss", "Waiting for Thor (check every 5 seconds)"); return end
                        local character, root = localParts()
                        if not character then
                            if entryTask then cancelEntry() end
                            clearCombat()
                            enteredCharacter, needsEntry, respawnHold = nil, true, true
                            readyCharacter, readyAt = nil, nil
                            status("WaitingRespawn", "Waiting for your character")
                            return
                        end
                        if enteredCharacter and enteredCharacter ~= character then
                            clearCombat()
                            enteredCharacter, needsEntry, respawnHold = nil, true, true
                        end
                        if needsEntry then
                            if entryTask then return end
                            if respawnHold then
                                if readyCharacter ~= character then readyCharacter, readyAt = character, now + 2 end
                                if now < readyAt then status("WaitingRespawn", "Waiting 2 seconds after respawn readiness"); return end
                            end
                            if now >= nextAttempt then startEntry(character) end
                            return
                        end
                        followBoss(character, root)
                    end
                
                    function controller:SetEnabled(state, reason)
                        if destroyed then return false end
                        state = state == true
                        if state == enabled then return true end
                        if state then
                            if type(deps.firePrompt) ~= "function" then
                                status("Error", "Executor must support fireproximityprompt")
                                if deps.onEnabledChanged then pcall(deps.onEnabledChanged, false, "fireproximityprompt is unavailable") end
                                return false
                            end
                            if deps.isOtherFarmActive and deps.isOtherFarmActive() then
                                status("Error", "Disable the other farm mode before enabling Thor Farm")
                                if deps.onEnabledChanged then pcall(deps.onEnabledChanged, false, detail) end
                                return false
                            end
                            if not combat:BeginExternalAttack(controller) then return false end
                        end
                        enabled = state
                        cancelEntry(); clearCombat()
                        boss, enteredCharacter, needsEntry = nil, nil, true
                        respawnHold, readyCharacter, readyAt = false, nil, nil
                        nextScan, nextAttempt = 0, 0
                        if not enabled then combat:EndExternalAttack(controller) end
                        status(enabled and "WaitingBoss" or "Off", reason or (enabled and "Waiting for Thor (check every 5 seconds)" or "Off"))
                        if deps.onEnabledChanged then pcall(deps.onEnabledChanged, enabled, reason) end
                        return true
                    end
                
                    function controller:IsEnabled() return enabled end
                    function controller:OnAttackError(message)
                        controller:SetEnabled(false, message)
                        status("Error", message)
                    end
                    function controller:Destroy()
                        if destroyed then return end
                        controller:SetEnabled(false)
                        destroyed = true
                        cancelEntry(); cleanupMover()
                        if heartbeat then heartbeat:Disconnect(); heartbeat = nil end
                        if removingConnection then removingConnection:Disconnect(); removingConnection = nil end
                        if promptConnection then promptConnection:Disconnect(); promptConnection = nil end
                    end
                
                    heartbeat = deps.RunService.Heartbeat:Connect(function()
                        local ok, err = pcall(step)
                        if not ok then controller:SetEnabled(false, "Thor Farm stopped: " .. tostring(err)); status("Error", tostring(err)) end
                    end)
                    removingConnection = player.CharacterRemoving:Connect(function(character)
                        retiringCharacter = character or player.Character
                        if not enabled then return end
                        cancelEntry(); clearCombat()
                        enteredCharacter, needsEntry, respawnHold = nil, true, true
                        readyCharacter, readyAt, nextAttempt = nil, nil, 0
                        status("WaitingRespawn", "Waiting for your character")
                    end)
                    if deps.ProximityPromptService then
                        promptConnection = deps.ProximityPromptService.PromptShown:Connect(function(prompt)
                            if enabled and not destroyed then rememberPrompt(prompt) end
                        end)
                    end
                    return controller
                end
                
                
                -- Folder-only selection. Bound Soul has priority over The Dullahan King.
                local function createDullahanFarmController(deps)
                    local controller = {}
                    local world, player, players, combat = deps.Workspace, deps.LocalPlayer, deps.Players, deps.Combat
                    local clock, makeInstance = deps.clock or os.clock, deps.newInstance or Instance.new
                    local enabled, destroyed = false, false
                    local king, target, souls = nil, nil, 0
                    local phase, nextScan, scans = "Off", 0, 0
                    local movementRoot, mover
                    local retiringCharacter, lastCharacter, readyCharacter, readyAt
                    local respawnPending = false
                    local observedFolder, addedConnection, removedConnection
                    local heartbeat, removingConnection
                
                    local function folder()
                        local gameFolder = world:FindFirstChild("Game")
                        return gameFolder and gameFolder:FindFirstChild("Players")
                    end
                
                    local function parts(model, name, npcFolder)
                        if not model or not npcFolder or model.Parent ~= npcFolder or not model:IsA("Model")
                            or model.Name ~= name or model == player.Character then return nil end
                        if players and players:GetPlayerFromCharacter(model) then return nil end
                        local humanoid = model:FindFirstChildOfClass("Humanoid")
                        if not humanoid or humanoid.Health <= 0 then return nil end
                        local root = model:FindFirstChild("HumanoidRootPart")
                        if root and not root:IsA("BasePart") then root = nil end
                        return humanoid, root
                    end
                
                    local function localParts()
                        local character = player.Character
                        if not character or character == retiringCharacter then return nil end
                        local humanoid = character:FindFirstChildOfClass("Humanoid")
                        local root = character:FindFirstChild("HumanoidRootPart")
                        if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") and not root.Anchored then return character, root end
                        return nil
                    end
                
                    local function cleanupMover()
                        if mover then mover:Destroy(); mover = nil end
                        movementRoot = nil
                    end
                
                    local function clearCombat()
                        combat:SetExternalAttackTarget(controller, nil)
                        cleanupMover()
                    end
                
                    local function unbindFolder()
                        if addedConnection then addedConnection:Disconnect(); addedConnection = nil end
                        if removedConnection then removedConnection:Disconnect(); removedConnection = nil end
                        observedFolder = nil
                    end
                
                    local function bindFolder()
                        local current = folder()
                        if current == observedFolder then return current end
                        unbindFolder()
                        observedFolder, nextScan = current, 0
                        if current then
                            local function changed(model)
                                if model.Name ~= "The Dullahan King" and model.Name ~= "Bound Soul" then return end
                                nextScan = 0
                                -- Pause boss punches immediately, then choose a soul once on the next frame.
                                if model.Name == "Bound Soul" and target == king then combat:SetExternalAttackTarget(controller, nil) end
                            end
                            if current.ChildAdded then addedConnection = current.ChildAdded:Connect(changed) end
                            if current.ChildRemoved then removedConnection = current.ChildRemoved:Connect(changed) end
                        end
                        return current
                    end
                
                    local function selectTarget(npcFolder, playerRoot)
                        scans = scans + 1
                        local assigned = king
                        if deps.getAssignedBoss then assigned = deps.getAssignedBoss() end
                        local foundKing = parts(assigned, "The Dullahan King", npcFolder) and assigned or nil
                        local chosenSoul, closestDistance, retainedSoul
                        souls = 0
                        if npcFolder then
                            for _, model in ipairs(npcFolder:GetChildren()) do
                                if not deps.getAssignedBoss and not foundKing and parts(model, "The Dullahan King", npcFolder) then foundKing = model end
                                local soulHumanoid, soulRoot = parts(model, "Bound Soul", npcFolder)
                                if soulHumanoid then
                                    souls = souls + 1
                                    if soulRoot then
                                        if model == target then retainedSoul = model end
                                        local distance = (soulRoot.Position - playerRoot.Position).Magnitude
                                        if not closestDistance or distance < closestDistance then chosenSoul, closestDistance = model, distance end
                                    end
                                end
                            end
                        end
                        king = foundKing
                        if not king then target, phase = nil, "WaitingBoss"
                        elseif souls > 0 then target, phase = retainedSoul or chosenSoul, "Souls"
                        else
                            local _, kingRoot = parts(king, "The Dullahan King", npcFolder)
                            target, phase = kingRoot and king or nil, kingRoot and "Boss" or "WaitingRoot"
                        end
                        nextScan = clock() + (king and 0.2 or 1)
                    end
                
                    local function followTarget(root, npcFolder)
                        local _, enemyRoot = parts(target, target == king and "The Dullahan King" or "Bound Soul", npcFolder)
                        if not enemyRoot then clearCombat(); return end
                        if movementRoot ~= root then cleanupMover(); movementRoot = root end
                        if mover and mover.Parent ~= root then mover:Destroy(); mover = nil end
                        if not mover and not root:FindFirstChild("BodyVelocity") then
                            mover = makeInstance("BodyVelocity")
                            mover.Name = "DullahanFarmVelocity"
                            mover.MaxForce = Vector3.new(9000000000, 9000000000, 9000000000)
                            mover.Velocity = Vector3.zero
                            mover.Parent = root
                        end
                        root.CFrame = CFrame.lookAt(enemyRoot.Position + Vector3.new(0, 20, 0), enemyRoot.Position, Vector3.zAxis)
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        combat:SetExternalAttackTarget(controller, target)
                    end
                
                    local function step()
                        if not enabled or destroyed then return end
                        if deps.isOtherFarmActive and deps.isOtherFarmActive() then controller:SetEnabled(false, "Another farm started."); return end
                        local npcFolder = bindFolder()
                        local character, root = localParts()
                        if not character then
                            clearCombat(); phase = "Respawn"
                            respawnPending, readyCharacter, readyAt = true, nil, nil
                            return
                        end
                        if lastCharacter and lastCharacter ~= character then respawnPending = true end
                        lastCharacter = character
                        if respawnPending then
                            if readyCharacter ~= character then readyCharacter, readyAt = character, clock() + 2 end
                            if clock() < readyAt then phase = "Respawn"; clearCombat(); return end
                            respawnPending, readyCharacter, readyAt, nextScan = false, nil, nil, 0
                        end
                        if king and not parts(king, "The Dullahan King", npcFolder) then king, target, nextScan = nil, nil, 0; clearCombat() end
                        if target then
                            local humanoid, enemyRoot = parts(target, target == king and "The Dullahan King" or "Bound Soul", npcFolder)
                            if not humanoid or not enemyRoot then target, nextScan = nil, 0; clearCombat() end
                        end
                        if clock() >= nextScan then selectTarget(npcFolder, root) end
                        if target then followTarget(root, npcFolder) else clearCombat() end
                    end
                
                    function controller:GetStatus() return { enabled = enabled, phase = phase, target = target and target.Name, model = target, boss = king, souls = souls, scans = scans } end
                    function controller:IsEnabled() return enabled end
                    function controller:SetEnabled(state, reason)
                        if destroyed then return false end
                        state = state == true
                        if state == enabled then return true end
                        if state then
                            if deps.isOtherFarmActive and deps.isOtherFarmActive() then
                                if deps.onEnabledChanged then pcall(deps.onEnabledChanged, false, "Disable the other farm first.") end
                                return false
                            end
                            if not combat:BeginExternalAttack(controller, "dullahan") then
                                if deps.onEnabledChanged then pcall(deps.onEnabledChanged, false, "Another boss farm is active.") end
                                return false
                            end
                        end
                        enabled = state
                        clearCombat(); unbindFolder()
                        king, target, souls, nextScan = nil, nil, 0, 0
                        lastCharacter, readyCharacter, readyAt, respawnPending = nil, nil, nil, false
                        phase = enabled and "WaitingBoss" or "Off"
                        if not enabled then combat:EndExternalAttack(controller) end
                        if deps.onEnabledChanged then pcall(deps.onEnabledChanged, enabled, reason) end
                        return true
                    end
                    function controller:OnAttackError(message) controller:SetEnabled(false, message) end
                    function controller:Destroy()
                        if destroyed then return end
                        controller:SetEnabled(false)
                        destroyed = true
                        cleanupMover(); unbindFolder()
                        if heartbeat then heartbeat:Disconnect(); heartbeat = nil end
                        if removingConnection then removingConnection:Disconnect(); removingConnection = nil end
                    end
                    heartbeat = deps.RunService.Heartbeat:Connect(function()
                        local ok, err = pcall(step)
                        if not ok then
                            controller:SetEnabled(false, "Dullahan stopped: " .. tostring(err))
                            if deps.warn then deps.warn("Dullahan Farm: " .. tostring(err)) end
                        end
                    end)
                    removingConnection = player.CharacterRemoving:Connect(function(character)
                        retiringCharacter = character or player.Character
                        if enabled then
                            clearCombat(); respawnPending, readyCharacter, readyAt, lastCharacter = true, nil, nil, nil
                            phase, nextScan = "Respawn", 0
                        end
                    end)
                    return controller
                end
                
                
                -- One event switch. In All mode, retain the selected model until it leaves Game.Players.
                local function createEventBossFarmController(deps)
                    local controller = {}
                    local world, player, players, combat = deps.Workspace, deps.LocalPlayer, deps.Players, deps.Combat
                    local clock = deps.clock or os.clock
                    local children = { Thor = deps.Thor, Dullahan = deps.Dullahan }
                    local enabled, destroyed, transitioning = false, false, false
                    local mode, currentKind, currentBoss, lastCompleted = "Thor", nil, nil, nil
                    local nextScan, scans, childFailure = 0, 0, nil
                    local heartbeat
                
                    local function folder()
                        local gameFolder = world:FindFirstChild("Game")
                        return gameFolder and gameFolder:FindFirstChild("Players")
                    end
                
                    local function kindOf(model, npcFolder)
                        if not model:IsA("Model") or model.Parent ~= npcFolder or model == player.Character then return nil end
                        if players and players:GetPlayerFromCharacter(model) then return nil end
                        local humanoid = model:FindFirstChildOfClass("Humanoid")
                        if not humanoid or humanoid.Health <= 0 then return nil end
                        if model.Name == "The Dullahan King" then return "Dullahan" end
                        if string.find(string.lower(model.Name), "thor", 1, true) then return "Thor" end
                        return nil
                    end
                
                    local function stopChildren()
                        children.Thor:SetEnabled(false)
                        children.Dullahan:SetEnabled(false)
                    end
                
                    local function reserveCombat()
                        return combat:BeginExternalAttack(controller, "event")
                    end
                
                    local function chooseBoss(npcFolder)
                        scans = scans + 1
                        local available = {}
                        if npcFolder then
                            for _, model in ipairs(npcFolder:GetChildren()) do
                                local kind = kindOf(model, npcFolder)
                                if kind and not available[kind] then available[kind] = model end
                            end
                        end
                        if mode ~= "All" then return mode, available[mode] end
                        local preferred = lastCompleted == "Thor" and "Dullahan" or "Thor"
                        local other = preferred == "Thor" and "Dullahan" or "Thor"
                        if available[preferred] then return preferred, available[preferred] end
                        return other, available[other]
                    end
                
                    local function activate(kind, model)
                        transitioning, childFailure = true, nil
                        stopChildren()
                        combat:EndExternalAttack(controller)
                        currentKind, currentBoss = kind, model
                        local ok = children[kind]:SetEnabled(true)
                        transitioning = false
                        if not ok or not children[kind]:IsEnabled() then
                            controller:SetEnabled(false, childFailure or "Event boss could not start.")
                        end
                    end
                
                    local function step()
                        if not enabled or destroyed then return end
                        if deps.isOtherFarmActive and deps.isOtherFarmActive() then
                            controller:SetEnabled(false, "Another farm started.")
                            return
                        end
                        local npcFolder = folder()
                        if currentBoss then
                            -- Zero HP and missing roots are not removal. Keep the turn across respawns.
                            if currentBoss.Parent == npcFolder and npcFolder then return end
                            lastCompleted = currentKind
                            transitioning = true
                            stopChildren()
                            currentKind, currentBoss, nextScan = nil, nil, 0
                            transitioning = false
                            if not reserveCombat() then controller:SetEnabled(false, "Combat is busy."); return end
                        end
                        if clock() < nextScan then return end
                        nextScan = clock() + 5
                        local kind, model = chooseBoss(npcFolder)
                        if model then activate(kind, model) end
                    end
                
                    function controller:GetAssignedBoss(kind)
                        return enabled and currentKind == kind and currentBoss or nil
                    end
                    function controller:GetStatus()
                        return { enabled = enabled, mode = mode, kind = currentKind, boss = currentBoss,
                            lastCompleted = lastCompleted, scans = scans }
                    end
                    function controller:IsEnabled() return enabled end
                    function controller:SetMode(value)
                        if destroyed or (value ~= "Thor" and value ~= "Dullahan" and value ~= "All") then return false end
                        if value == mode then return true end
                        mode, lastCompleted, nextScan = value, nil, 0
                        if enabled then
                            transitioning = true
                            stopChildren()
                            currentKind, currentBoss = nil, nil
                            transitioning = false
                            if not reserveCombat() then controller:SetEnabled(false, "Combat is busy."); return false end
                        end
                        return true
                    end
                    function controller:SetEnabled(state, reason)
                        if destroyed then return false end
                        state = state == true
                        if state == enabled then return true end
                        if state and deps.isOtherFarmActive and deps.isOtherFarmActive() then
                            if deps.onEnabledChanged then pcall(deps.onEnabledChanged, false, "Disable the other farm first.") end
                            return false
                        end
                        transitioning = true
                        stopChildren()
                        combat:EndExternalAttack(controller)
                        enabled, currentKind, currentBoss, lastCompleted, nextScan = state, nil, nil, nil, 0
                        transitioning = false
                        if enabled and not reserveCombat() then
                            enabled, reason = false, "Combat is busy."
                        end
                        if deps.onEnabledChanged then pcall(deps.onEnabledChanged, enabled, reason) end
                        return enabled == state
                    end
                    function controller:OnChildChanged(kind, state, reason)
                        if not state then childFailure = reason end
                        if enabled and not transitioning and not state and currentKind == kind then
                            controller:SetEnabled(false, reason or "Event boss stopped.")
                        end
                    end
                    function controller:OnAttackError(message) controller:SetEnabled(false, message) end
                    function controller:Destroy()
                        if destroyed then return end
                        controller:SetEnabled(false)
                        destroyed = true
                        if heartbeat then heartbeat:Disconnect(); heartbeat = nil end
                    end
                    heartbeat = deps.RunService.Heartbeat:Connect(function()
                        local ok, err = pcall(step)
                        if not ok then
                            controller:SetEnabled(false, "Event farm stopped.")
                            if deps.warn then deps.warn("Event Farm: " .. tostring(err)) end
                        end
                    end)
                    return controller
                end
                
                
                -- AUTO_FARM_NEAR_INTEGRATION
                local runtime = getgenv and getgenv() or _G
                local previousNearFarm = runtime.__SigmaAutoFarmNear
                if type(previousNearFarm) == "table" and type(previousNearFarm.Destroy) == "function" then
                    pcall(previousNearFarm.Destroy, previousNearFarm)
                end
                
                local function notifyNearFarm(message)
                    pcall(function() library:ShowNotification(message) end)
                end
                
                local nearSwitch, autoSkillSwitch, nearPunchSwitch
                local eventBossSwitch
                local ThorFarmController, DullahanFarmController, EventBossFarmController
                local function otherMovementFarmActive()
                    return AutoIsland_Active or AutoBR_Active or AutoBRPunch_Active
                        or AutoBRExtreme_Active or AutoShadow_Active
                        or AutoIgnis_Active or AutoKrampus_Active or AutoLevel_Active
                        or AutoIslandbal_Active or AutoBalraxionTerminator_Active
                        or AutoRelic_Active or AutoSell_Active or AutoBazaarTokens_Active
                end
                local nearDependencies = {
                    Players = Players,
                    LocalPlayer = LocalPlayer,
                    Workspace = workspace,
                    ReplicatedStorage = ReplicatedStorage,
                    RunService = RunService,
                    VirtualInputManager = VirtualInputManager,
                    Game = game,
                    warn = warn,
                    onPunchEnabledChanged = function(state, reason)
                        if not state and nearPunchSwitch then nearPunchSwitch:Set(false) end
                        if reason then notifyNearFarm(reason) end
                    end,
                    isSkillAllowed = function()
                        if (AutoBR_Active or AutoBRExtreme_Active) and OneShot_Active then
                            return BossRushRecovery ~= nil and BossRushRecovery:CanUseSkills()
                        end
                        return true
                    end,
                    isOtherFarmActive = function()
                        return otherMovementFarmActive() or (ThorFarmController and ThorFarmController:IsEnabled())
                            or (DullahanFarmController and DullahanFarmController:IsEnabled())
                            or (EventBossFarmController and EventBossFarmController:IsEnabled())
                    end,
                    onEnabledChanged = function(state, reason)
                        if not state and nearSwitch then nearSwitch:Set(false) end
                        if reason then notifyNearFarm(reason) end
                    end,
                    onSkillEnabledChanged = function(state, reason)
                        if not state and BossRushRecovery then BossRushRecovery:Reset() end
                        if not state and autoSkillSwitch then autoSkillSwitch:Set(false) end
                        if reason then notifyNearFarm(reason) end
                    end,
                }
                local nearController = createAutoFarmNearController(nearDependencies)
                BossRushRecovery = createBossRushRecoveryController({
                    Players = Players,
                    LocalPlayer = LocalPlayer,
                    Workspace = workspace,
                    RunService = RunService,
                    warn = warn,
                    isBossRushActive = function()
                        return AutoBR_Active or AutoBRExtreme_Active
                    end,
                    isArenaReady = function() return workspace:FindFirstChild("Spire") ~= nil end,
                    isOneShotActive = function() return OneShot_Active end,
                    isAutoSkillActive = function() return nearController:IsAutoSkillEnabled() end,
                    hasSelectedSkills = function() return #nearController:GetSelectedSkills() > 0 end,
                })
                nearController.recoveryController = BossRushRecovery
                ThorFarmController = createThorFarmController({
                    Players = Players,
                    LocalPlayer = LocalPlayer,
                    Workspace = workspace,
                    RunService = RunService,
                    ProximityPromptService = game:GetService("ProximityPromptService"),
                    Combat = nearController,
                    firePrompt = fireproximityprompt,
                    warn = warn,
                    getAssignedBoss = function()
                        return EventBossFarmController and EventBossFarmController:GetAssignedBoss("Thor")
                    end,
                    isOtherFarmActive = function()
                        return otherMovementFarmActive() or (DullahanFarmController and DullahanFarmController:IsEnabled())
                    end,
                    onEnabledChanged = function(state, reason)
                        if EventBossFarmController then EventBossFarmController:OnChildChanged("Thor", state, reason) end
                    end,
                })
                nearController.thorController = ThorFarmController
                DullahanFarmController = createDullahanFarmController({
                    Players = Players,
                    LocalPlayer = LocalPlayer,
                    Workspace = workspace,
                    RunService = RunService,
                    Combat = nearController,
                    warn = warn,
                    getAssignedBoss = function()
                        return EventBossFarmController and EventBossFarmController:GetAssignedBoss("Dullahan")
                    end,
                    isOtherFarmActive = function()
                        return otherMovementFarmActive() or ThorFarmController:IsEnabled()
                    end,
                    onEnabledChanged = function(state, reason)
                        if EventBossFarmController then EventBossFarmController:OnChildChanged("Dullahan", state, reason) end
                    end,
                })
                nearController.dullahanController = DullahanFarmController
                EventBossFarmController = createEventBossFarmController({
                    Players = Players,
                    LocalPlayer = LocalPlayer,
                    Workspace = workspace,
                    RunService = RunService,
                    Combat = nearController,
                    Thor = ThorFarmController,
                    Dullahan = DullahanFarmController,
                    isOtherFarmActive = otherMovementFarmActive,
                    warn = warn,
                    onEnabledChanged = function(state, reason)
                        if not state and eventBossSwitch then eventBossSwitch:Set(false) end
                        if reason then notifyNearFarm(reason) end
                    end,
                })
                nearController.eventBossController = EventBossFarmController
                runtime.__SigmaAutoFarmNear = nearController
                if window.main_frame and typeof(window.main_frame) == "Instance" then
                    nearController.uiConnection = window.main_frame.Destroying:Connect(function()
                        nearController:Destroy()
                        if runtime.__SigmaAutoFarmNear == nearController then runtime.__SigmaAutoFarmNear = nil end
                    end)
                end
                
                addCompactDropdown(autoFarmTab, "Event Boss", "Thor", { "Thor", "Dullahan", "All" }, function(value)
                    EventBossFarmController:SetMode(value)
                end)
                eventBossSwitch = autoFarmTab:AddSwitch("Auto Event Boss Farm", function(state)
                    EventBossFarmController:SetEnabled(state)
                end)
                eventBossSwitch:Set(false)
                
                nearSwitch = autoFarmTab:AddSwitch("Auto Farm Near", function(state)
                    nearController:SetEnabled(state)
                end)
                nearSwitch:Set(false)
                
                addCompactDropdown(autoFarmTab, "Position", "Above/Below", { "Above/Below", "Front/Behind" }, function(value)
                    nearController:SetConfig("position", value)
                end)
                
                local distanceInput = autoFarmTab:AddTextBox("Distance (-20 to 20)", function(text)
                    if not nearController:SetConfig("offset", text) then
                        notifyNearFarm("Distance: -20 to 20.")
                    end
                end, { clear = false })
                distanceInput.Text = "20"
                nearPunchSwitch = autoFarmTab:AddSwitch("Auto Punch", function(state)
                    nearController:SetAutoPunch(state)
                end)
                nearPunchSwitch:Set(false)
                local punchSpeeds = {}
                for index = 1, 10 do punchSpeeds[index] = string.format("%.1f", index / 10) end
                addCompactDropdown(autoFarmTab, "Punch Speed", "0.2", punchSpeeds, function(value)
                    nearController:SetConfig("punchSpeed", value)
