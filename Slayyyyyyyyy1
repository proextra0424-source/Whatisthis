            if #initialCheck > 0 then
                
                
                wait(2)
                LocalPlayer:Kick("Someone Maybe Watching You...")
                AutoBazaarTokens_Active = false
                return
            end
            
            local safetyCheck
            safetyCheck = game:GetService("RunService").Heartbeat:Connect(function()
                if not AutoBazaarTokens_Active then
                    safetyCheck:Disconnect()
                    return
                end
                
                local otherPlayers = checkOtherPlayers()
                if #otherPlayers > 0 then
                    
                    
                    wait(2)
                    LocalPlayer:Kick("Someone Maybe Watching You...")
                    AutoBazaarTokens_Active = false
                    safetyCheck:Disconnect()
                end
            end)
            
            local playerAddedConnection
            playerAddedConnection = game:GetService("Players").PlayerAdded:Connect(function(newPlayer)
                if newPlayer ~= LocalPlayer and AutoBazaarTokens_Active then
                    
                    wait(2)
                    LocalPlayer:Kick("Someone Maybe Watching You...")
                    AutoBazaarTokens_Active = false
                    if playerAddedConnection then
                        playerAddedConnection:Disconnect()
                    end
                    if safetyCheck then
                        safetyCheck:Disconnect()
                    end
                end
            end)
            
