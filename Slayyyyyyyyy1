function Delivery.followNikoClose(niko)
	if not niko
		or not niko.Parent then

		return false
	end

	local character,
		humanoid,
		root =
		Delivery.waitForDeliveryCharacter()

	if not character
		or not humanoid
		or not root then

		return false
	end

	local npcRoot =
		Delivery.getNpcFollowRoot(
			niko
		)

	if not npcRoot then
		return false
	end

	local target =
		npcRoot.Position
		+ Vector3.new(
			0,
			DELIVERY_FOLLOW_HEIGHT,
			0
		)

	character:PivotTo(
		CFrame.new(target)
		* CFrame.Angles(
			math.rad(-90),
			0,
			0
		)
	)

	root.AssemblyLinearVelocity =
		Vector3.zero

	root.AssemblyAngularVelocity =
		Vector3.zero

	if not createFollowConstraints() then
		return false
	end

	Delivery.FollowSerial += 1

	local followSerial =
		Delivery.FollowSerial

	local activeFollow =
		followPosition

	task.spawn(function()

		while Runtime.alive
			and autoDeliveryEnabled
			and deliveryBusy
			and Delivery.FollowSerial
				== followSerial
			and activeFollow
			and activeFollow.Parent
			and niko
			and niko.Parent do

			local movingNpcRoot =
				Delivery.getNpcFollowRoot(
					niko
				)

			if not movingNpcRoot then
				break
			end

			activeFollow.Position =
				movingNpcRoot.Position
				+ Vector3.new(
					0,
					DELIVERY_FOLLOW_HEIGHT,
					0
				)

			task.wait(0.03)
		end
	end)

	local timeoutAt =
		os.clock()
		+ DELIVERY_FOLLOW_TIMEOUT

	while Runtime.alive
		and autoDeliveryEnabled
		and deliveryBusy
		and Delivery.FollowSerial
			== followSerial
		and os.clock() < timeoutAt do

		if not isPlayerAlive() then
			destroyFollow()
			return false
		end

		if not niko.Parent then
			destroyFollow()
			return false
		end

		npcRoot =
			Delivery.getNpcFollowRoot(
				niko
			)

		if not npcRoot then
			destroyFollow()
			return false
		end

		target =
			npcRoot.Position
			+ Vector3.new(
				0,
				DELIVERY_FOLLOW_HEIGHT,
				0
			)

		if activeFollow
			and activeFollow.Parent then

			activeFollow.Position =
				target
		end

		local currentRoot =
			getCharacterRoot()

		if currentRoot
			and (
				currentRoot.Position
				- target
			).Magnitude
				<= DELIVERY_FOLLOW_DISTANCE then

			task.wait(0.12)

			return activeFollow ~= nil
				and activeFollow.Parent ~= nil
		end

		task.wait(0.03)
	end

	return activeFollow ~= nil
		and activeFollow.Parent ~= nil
end


