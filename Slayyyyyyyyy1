function Runtime.getBossHuntsEvent()
	local cached =
		Runtime.BossHuntsEvent

	if cached
		and cached.Parent then

		return cached
	end

	local communication =
		ReplicatedStorage:FindFirstChild(
			"Communication"
		)

	local serverAndClient =
		communication
		and communication:FindFirstChild(
			"ServerAndClient"
		)

	local signals =
		serverAndClient
		and serverAndClient:FindFirstChild(
			"Signals"
		)

	local signalEvent =
		signals
		and signals:FindFirstChild(
			"SignalEvent"
		)

	local event =
		signalEvent
		and signalEvent:FindFirstChild(
			"Event"
		)

	if event then

		Runtime.BossHuntsEvent =
			event
	end

	return event
end




