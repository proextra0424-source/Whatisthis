local Runtime: any = {
	alive = true,
	connections = {}
}

ENV[RUNTIME_KEY] =
	Runtime


local function runtimeConnect(signal, callback)
	local connection =
		signal:Connect(
			function(...)
				if not Runtime.alive then
					return
				end

				callback(...)
			end
		)

	table.insert(
		Runtime.connections,
		connection
	)

	return connection
end


