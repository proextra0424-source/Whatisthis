function Delivery.waitForDeliveryCharacter()
	while Runtime.alive
		and autoDeliveryEnabled do

		local character =
			getCharacter()

		local humanoid =
			getCharacterHumanoid()

		local root =
			getCharacterRoot()

		if character
			and humanoid
			and root
			and humanoid.Health > 0 then

			return
				character,
				humanoid,
				root
		end

		task.wait(0.1)
	end

	return nil
end


function Delivery.requestDeliveryStream(position)
	if not position then
		return false
	end

	if not workspace.StreamingEnabled then
		return true
	end

	local finished =
		false

	task.spawn(function()
		pcall(function()
			LocalPlayer:RequestStreamAroundAsync(
				position,
				DELIVERY_STREAM_TIMEOUT
			)
		end)

		finished =
			true
	end)

	local timeoutAt =
		os.clock()
		+ DELIVERY_STREAM_TIMEOUT

	while Runtime.alive
		and autoDeliveryEnabled
		and not finished
		and os.clock() < timeoutAt do

		task.wait(0.05)
	end

	if not Runtime.alive
		or not autoDeliveryEnabled then

		return false
	end

	task.wait(
		DELIVERY_STREAM_SETTLE_DELAY
	)

	return true
end


function Delivery.teleportDelivery(position)
	if not position then
		return false
	end

	if not Delivery.requestDeliveryStream(
		position
	) then

		return false
	end

	local character,
		humanoid,
		root =
		Delivery.waitForDeliveryCharacter()

	if not character
		or not humanoid
		or not root then

		return false
	end

	character:PivotTo(
		CFrame.new(position)
	)

	root.AssemblyLinearVelocity =
		Vector3.zero

	root.AssemblyAngularVelocity =
		Vector3.zero

	return true
end


