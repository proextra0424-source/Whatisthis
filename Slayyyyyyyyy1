function MultiFarm.nowMs()
	return DateTime.now().UnixTimestampMillis
end


function MultiFarm.filePath()
	return MultiFarm.Folder
		.. "/"
		.. tostring(
			LocalPlayer.UserId
		)
		.. ".json"
end


function MultiFarm.available()
	return typeof(writefile) == "function"
		and typeof(readfile) == "function"
		and typeof(listfiles) == "function"
		and typeof(makefolder) == "function"
end


function MultiFarm.ensureFolder()
	if not MultiFarm.available() then
		return false
	end

	if typeof(isfolder) == "function" then
		local ok, exists =
			pcall(
				isfolder,
				MultiFarm.Folder
			)

		if ok and exists then
			return true
		end
	end

	pcall(
		makefolder,
		MultiFarm.Folder
	)

	return true
end


function MultiFarm.setStatus(state, bossName)
	state =
		tostring(
			state or "Idle"
		)

	if bossName ~= nil then
		MultiFarm.Boss =
			tostring(
				bossName
			)
	end

	if MultiFarm.State == state
		and bossName == nil then

		return
	end

	MultiFarm.State =
		state

	MultiFarm.write()
end


function MultiFarm.write()
	if not MultiFarm.ensureFolder() then
		return false
	end

	local bossName =
		tostring(
			MultiFarm.Boss or ""
		)

	local display =
		LocalPlayer.Name
		.. " On "
		.. tostring(
			MultiFarm.State
		)

	if bossName ~= "" then
		display =
			display
			.. " "
			.. bossName
	end

	local payload = {
		player = LocalPlayer.Name,
		userid = LocalPlayer.UserId,
		jobId = game.JobId,
		placeId = game.PlaceId,
		updated = MultiFarm.nowMs(),
		state = MultiFarm.State,
		boss = bossName,
		display = display,
		multipleFarm = MultiFarm.Enabled,
		farmWith = MultiFarm.Target
	}

	local ok, encoded =
		pcall(function()
			return game:GetService(
				"HttpService"
			):JSONEncode(
				payload
			)
		end)

	if not ok
		or not encoded then

		return false
	end

	return pcall(
		writefile,
		MultiFarm.filePath(),
		encoded
	)
end


function MultiFarm.read(path)
	local ok, encoded =
		pcall(
			readfile,
			path
		)

	if not ok
		or type(encoded) ~= "string" then

		return nil
	end

	local decodeOk, data =
		pcall(function()
			return game:GetService(
				"HttpService"
			):JSONDecode(
				encoded
			)
		end)

	if not decodeOk
		or type(data) ~= "table" then

		return nil
	end

	return data
end


function MultiFarm.scan()
	if not MultiFarm.ensureFolder() then
		MultiFarm.Peers = {}
		return
	end

	local ok, files =
		pcall(
			listfiles,
			MultiFarm.Folder
		)

	if not ok
		or type(files) ~= "table" then

		MultiFarm.Peers = {}
		return
	end

	local peers = {}
	local now =
		MultiFarm.nowMs()

	for _, path in ipairs(files) do

		if string.match(
			tostring(path),
			"%.json$"
		) then

			local data =
				MultiFarm.read(
					path
				)

			if data
				and tonumber(data.userid)
					~= LocalPlayer.UserId
				and tostring(data.jobId or "")
					== tostring(game.JobId)
				and tonumber(data.placeId)
					== game.PlaceId
				and type(data.player)
					== "string"
				and tonumber(data.updated)
				and now
					- tonumber(data.updated)
					<= MultiFarm.StaleMs then

				peers[data.player] =
					data
			end
		end
	end

	MultiFarm.Peers =
		peers
end


function MultiFarm.getPlayerNames()
	local names = {
		"None"
	}

	for playerName in pairs(
		MultiFarm.Peers
	) do

		table.insert(
			names,
			playerName
		)
	end

	table.sort(
		names,
		function(a, b)
			if a == "None" then
				return true
			end

			if b == "None" then
				return false
			end

			return string.lower(a)
				< string.lower(b)
		end
	)

	return names
end


function MultiFarm.refreshDropdown()
	if not MultiFarm.Dropdown then
		return
	end

	local values =
		MultiFarm.getPlayerNames()

	local key =
		table.concat(
			values,
			"\0"
		)

	if key == MultiFarm.LastValuesKey then
		return
	end

	MultiFarm.LastValuesKey =
		key

	if MultiFarm.Dropdown.SetValues then
		pcall(function()
			MultiFarm.Dropdown:SetValues(
				values
			)
		end)
	end
end


function MultiFarm.setEnabled(value)
	MultiFarm.Enabled =
		value == true

	if not MultiFarm.Enabled then
		MultiFarm.LeaderDeliveryLatched =
			false
	end

	MultiFarm.write()
end


function MultiFarm.setTarget(value)
	if type(value) == "table" then

		local chosen =
			nil

		for name, selected in pairs(value) do
			if selected then
				chosen =
					tostring(name)
				break
			end
		end

		value =
			chosen or "None"
	end

	MultiFarm.Target =
		tostring(
			value or "None"
		)

	MultiFarm.LeaderDeliveryLatched =
		false

	MultiFarm.write()
end


function MultiFarm.isFollower()
	return MultiFarm.Enabled
		and MultiFarm.Target ~= "None"
		and MultiFarm.Target ~= ""
end


function MultiFarm.getLeader()
	if not MultiFarm.isFollower() then
		return nil
	end

	local peer =
		MultiFarm.Peers[
			MultiFarm.Target
		]

	if not peer then
		return nil
	end

	local updated =
		tonumber(
			peer.updated
		)

	if not updated
		or MultiFarm.nowMs()
			- updated
			> MultiFarm.StaleMs then

		return nil
	end

	return peer
end


function MultiFarm.resolveBoss(defaultBoss)
	if not MultiFarm.Enabled
		or MultiFarm.Target == "None"
		or MultiFarm.Target == "" then

		return defaultBoss, false
	end

	local leader =
		MultiFarm.getLeader()

	if not leader then
		return nil, true
	end

	local state =
		tostring(
			leader.state or "Idle"
		)

	if state == "Delivery"
		or state == "Respawning"
		or state == "Idle"
		or state == "Waiting Sync"
		or state == "Open Chest"
		or state == "Picking Loot"
		or state == "Waiting Loot" then

		return nil, true
	end

	local bossName =
		tostring(
			leader.boss or ""
		)

	if bossName == "" then
		return nil, true
	end

	return bossName, false
end


function MultiFarm.cleanup()
	if typeof(delfile) ~= "function"
		or typeof(isfile) ~= "function" then

		return
	end

	local path =
		MultiFarm.filePath()

	local ok, exists =
		pcall(
			isfile,
			path
		)

	if ok and exists then
		pcall(
			delfile,
			path
		)
	end
end


