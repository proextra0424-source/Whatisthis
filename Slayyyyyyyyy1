                end

                hasTeleportedBRPunch = false
                local punchCounter = 1

                local function isValidEnemyModel(model)
                    if not model or not model:IsA("Model") or model == LocalPlayer.Character then
                        return false
                    end
                    if Players:GetPlayerFromCharacter(model) then
                        return false
                    end
                    local humanoid = model:FindFirstChildOfClass("Humanoid")
                        or model:FindFirstChild("Humanoid", true)
                    local rootPart = model:FindFirstChild("HumanoidRootPart", true)
                    return humanoid and rootPart and humanoid.Health > 0
                end

                local function findNearestEnemy()
                    local character = LocalPlayer.Character
                    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                    local npcFolder = workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Players")
                    if not rootPart or not npcFolder then
                        return nil, nil
                    end

                    local nearestModel, nearestHumanoid
                    local nearestDistance = 100
                    local candidateModels = {}
                    for _, object in ipairs(npcFolder:GetDescendants()) do
                        if object:IsA("Model") then
                            candidateModels[object] = true
                        end
                    end

                    for model in pairs(candidateModels) do
                        if isValidEnemyModel(model) then
                            local humanoid = model:FindFirstChildOfClass("Humanoid")
                                or model:FindFirstChild("Humanoid", true)
                            local targetRoot = model:FindFirstChild("HumanoidRootPart", true)
                            local distance = (targetRoot.Position - rootPart.Position).Magnitude
                            if distance <= nearestDistance then
                                nearestDistance = distance
                                nearestModel = model
                                nearestHumanoid = humanoid
                            end
                        end
                    end

                    return nearestModel, nearestHumanoid
                end

                local function firePunchBurst(targetHumanoid)
                    local combatRemote = ReplicatedStorage.Remotes.ClientToServer.BasicCombat
                    local args = {
                        [1] = "Light Punchy",
                        [2] = punchCounter,
                        [3] = targetHumanoid,
                        [6] = false,
                        [7] = false
                    }

                    for _ = 1, 5 do
                        if not AutoBRPunch_Active or AutoBRPunch_RunId ~= runId then
                            return false
                        end
                        combatRemote:FireServer(unpack(args))
                    end

                    punchCounter = punchCounter + 1
                    if punchCounter > 5 then
                        punchCounter = 1
                        wait(1.2)
                    else
                        wait(0.01)
                    end
                    return true
                end

                local function punchTarget(targetModel, targetHumanoid)
                    local hoverAttachment
                    local alignPosition
                    local updateConnection

                    local function cleanupHover()
                        if updateConnection then
                            updateConnection:Disconnect()
                            updateConnection = nil
                        end
                        if alignPosition then
                            alignPosition:Destroy()
                            alignPosition = nil
                        end
                        if hoverAttachment then
                            hoverAttachment:Destroy()
                            hoverAttachment = nil
                        end
                    end

                    local character = LocalPlayer.Character
                    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                    local targetRoot = targetModel and targetModel:FindFirstChild("HumanoidRootPart", true)
                    if not rootPart or not targetRoot then
                        return
                    end

                    -- Keep the player floating 10 studs above the target without Anchored.
                    hoverAttachment = Instance.new("Attachment")
                    hoverAttachment.Parent = rootPart
                    alignPosition = Instance.new("AlignPosition")
                    alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
                    alignPosition.Attachment0 = hoverAttachment
                    alignPosition.MaxForce = math.huge
                    alignPosition.MaxVelocity = math.huge
                    alignPosition.Responsiveness = 200
                    alignPosition.RigidityEnabled = true
                    local hoverPosition = targetRoot.Position + Vector3.new(0, 10, 0)
                    rootPart.CFrame = CFrame.new(hoverPosition, targetRoot.Position)
                    alignPosition.Position = hoverPosition
                    alignPosition.Parent = rootPart

                    updateConnection = RunService.Heartbeat:Connect(function()
                        if targetRoot and targetRoot.Parent and rootPart and rootPart.Parent then
                            alignPosition.Position = targetRoot.Position + Vector3.new(0, 10, 0)
                        end
                    end)

                    -- Do not start punching until the player has actually reached the hover point.
                    local reachDeadline = tick() + 3
                    while AutoBRPunch_Active and AutoBRPunch_RunId == runId
                        and targetRoot.Parent and rootPart.Parent do
                        hoverPosition = targetRoot.Position + Vector3.new(0, 10, 0)
                        alignPosition.Position = hoverPosition
                        if (rootPart.Position - hoverPosition).Magnitude <= 2 then
                            break
                        end
                        if tick() >= reachDeadline then
                            rootPart.CFrame = CFrame.new(hoverPosition, targetRoot.Position)
                            break
                        end
                        RunService.Heartbeat:Wait()
                    end

                    while AutoBRPunch_Active and AutoBRPunch_RunId == runId
                        and targetModel.Parent and targetHumanoid.Parent
                        and targetHumanoid.Health > 0
                        and targetRoot.Parent and rootPart.Parent do
                        local distance = (targetRoot.Position - rootPart.Position).Magnitude
                        if distance > 100 then
                            break
                        end
                        if not firePunchBurst(targetHumanoid) then
                            break
                        end
                    end

                    cleanupHover()
                end

                local function startPunchBossRush()
                    if not AutoBRPunch_Active or AutoBRPunch_RunId ~= runId then
                        return false
                    end

                    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                    local spireBox = workspace:FindFirstChild("SpireBox")
                    if not spireBox or not character:FindFirstChild("HumanoidRootPart") then
                        return false
                    end

                    if not hasTeleportedBRPunch then
                        character.HumanoidRootPart.CFrame = CFrame.new(1, 3012, 605)
                        hasTeleportedBRPunch = true
                    end

                    local args = {
                        [1] = "Spire",
                        [2] = "Spire",
                        [3] = spireBox
